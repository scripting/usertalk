<?xml version="1.0" encoding="UTF-8"?>
<!-- the usertalk package as one outline, generated from the files by misc/buildSourceOpml.js -->
<opml version="2.0">
	<head>
		<title>usertalk</title>
		</head>
	<body>
		<outline text="usertalk">
			<outline text="package.json">
				<outline text="{">
					<outline text="&quot;name&quot;: &quot;usertalk&quot;,"/>
					<outline text="&quot;description&quot;: &quot;The UserTalk language, running on Node -- parser, evaluator, and verb library for the scripting language of UserLand Frontier.&quot;,"/>
					<outline text="&quot;author&quot;: &quot;Dave Winer &lt;dave@scripting.com&gt;&quot;,"/>
					<outline text="&quot;version&quot;: &quot;0.3.0&quot;,"/>
					<outline text="&quot;main&quot;: &quot;code/usertalk.js&quot;,"/>
					<outline text="&quot;files&quot;: [">
						<outline text="&quot;readme.md&quot;"/>
						<outline text="],"/>
						</outline>
					<outline text="&quot;dependencies&quot;: {">
						<outline text="}"/>
						</outline>
					<outline text="}"/>
					</outline>
				</outline>
			<outline text="readme.md">
				<outline text="# usertalk"/>
				<outline text=""/>
				<outline text="The UserTalk language, running on Node."/>
				<outline text=""/>
				<outline text="UserTalk is the scripting language of [UserLand Frontier](http://frontier.userland.com/). This package is a clean-room implementation built from the Frontier kernel's own grammar (langparser.y) and evaluator (langevaluate.c) -- a tokenizer and parser that turn UserTalk script outlines into ASTs, a tree-walking evaluator with Frontier's semantics, and a verb library that maps the built-in verbs onto Node."/>
				<outline text=""/>
				<outline text="It runs against real object databases through [frontierOdb](https://github.com/scripting/frontierOdb) -- the ODB is the global namespace, dotted paths resolve case-insensitively, addresses are live references, and a path that lands on a script parses it on first call and calls it. Your old code runs on your old data."/>
				<outline text=""/>
				<outline text="### Status"/>
				<outline text=""/>
				<outline text="Born 7/27/2026 from an overnight research run that asked: can decades of Frontier build scripts run unchanged on a modern machine? The answer was yes:"/>
				<outline text=""/>
				<outline text="1. **Parse rate: 100%** over both corpora tried -- 361 of 361 build scripts, and 749 of 749 scripts of a production suite (~33,000 lines of UserTalk written across four decades)."/>
				<outline text="2. **336 of 361 build scripts execute clean** against the real object database, with a dry-run file layer."/>
				<outline text="3. **The end-to-end proof:** a real build script ran unchanged -- outline rendered to files, the script's own copyone handler executing real file verbs -- and produced a folder byte-identical to what Frontier ships, 6 of 6 files."/>
				<outline text=""/>
				<outline text="### What's real and what's stubbed"/>
				<outline text=""/>
				<outline text="Real: the language (handlers, loops, with, case, try, addresses, local/global scoping, the operator set), file.* over the filesystem behind a Mac-colon-path map, string.*, clock/date, typeof/sizeof/defined/nameof/new, and ODB scripts as callable values."/>
				<outline text=""/>
				<outline text="Stubs, loud ones -- every unimplemented verb announces itself, nothing silently succeeds: op.*, target.*, wp.*, xml.*, s3.*, tcp.*. The plan is to make them real as working scripts need them."/>
				<outline text=""/>
				<outline text="### Running a script"/>
				<outline text=""/>
				<outline text="```"/>
				<outline text="node code/run.js examples/hello/hello.opml"/>
				<outline text="```"/>
				<outline text=""/>
				<outline text="Runs one script outline; add `--trace` to see every verb call. Start in [examples](examples/) -- each one is a working UserTalk program with a readme. `runAll.js` runs a whole folder of scripts and writes a report naming exactly which verbs each failing script needs -- that report is the work list."/>
				<outline text=""/>
				<outline text="### Assembling an object database from a folder"/>
				<outline text=""/>
				<outline text="```"/>
				<outline text="node code/run.js myScript.opml --odb path/to/odbHome"/>
				<outline text="```"/>
				<outline text=""/>
				<outline text="With `--odb`, the namespace the script runs in is assembled from a folder: a subfolder is a table, a `.root` or `.json` file blends its top-level entries in where it sits (the way guest databases blend into Frontier's namespace), and a `.fttb`/`.ftop`/`.ftsc` fat page mounts as one entry named for the file. Later files win; tables merge entry by entry. Reloading is automatic -- every run reads the folder fresh. So you rebuild a working universe by copying files, no code."/>
				<outline text=""/>
				<outline text="Scripts stored in the loaded databases are callable -- and a builtin whose ODB body ends in a `kernel (x.y)` line dispatches to the verb library at that point, so whole verb families from a loaded snapshot run as UserTalk until they bottom out in the kernel, and every missing kernel verb fails loudly by name."/>
				<outline text=""/>
				<outline text="### The object database in SQL"/>
				<outline text=""/>
				<outline text="Reading a folder of roots loads all of it into memory. `odbSql.js` puts the database in SQLite instead, where it belongs for anything long-running:"/>
				<outline text=""/>
				<outline text="```javascript"/>
				<outline text="const odbSql = require (&quot;usertalk/code/odbSql.js&quot;);"/>
				<outline text=""/>
				<outline text="odbSql.buildDatabase (&quot;path/to/odbHome&quot;, &quot;data/odb.db&quot;); //once, from the roots"/>
				<outline text="const theStore = odbSql.openDatabase (&quot;data/odb.db&quot;);"/>
				<outline text="const theOdb = theStore.odb; //hand this to makeEnvironment"/>
				<outline text="```"/>
				<outline text=""/>
				<outline text="One row per object: an integer id, the id of the table it lives in, its name, its type, and its value as text. Names stay opaque in their own column, because a Frontier name can contain dots and tabs -- nothing is built by gluing names together. An address resolves by walking, one indexed lookup per component."/>
				<outline text=""/>
				<outline text="A table comes back as a proxy that queries its children when something asks for them, so **only what a script touches is ever in memory** -- the same arrangement the kernel had, where a value not in memory was just a disk address. On the 2012 snapshot plus nodeEditor and 519 projects: 212,542 rows, 38 MB to open against 355 MB read eagerly, and address reads around 12 microseconds."/>
				<outline text=""/>
				<outline text="Requires `better-sqlite3`. Nothing is ever written back to the .root format -- roots are an import format, and after the build the database is the truth."/>
				<outline text=""/>
				<outline text="### The repo"/>
				<outline text=""/>
				<outline text="- **code/** -- the interpreter.">
					<outline text="- **parse.js** -- tokenizer and recursive-descent parser, grammar from langparser.y."/>
					<outline text="- **evaluate.js** -- the evaluator, semantics from langevaluate.c."/>
					<outline text="- **verbs.js** -- the verb library."/>
					<outline text="- **odbLoader.js** -- loads .root and .fttb files into the namespace via frontierOdb."/>
					<outline text="- **odbHome.js** -- assembles the whole object database from a folder of roots, fat pages and subfolders."/>
					<outline text="- **odbSql.js** -- the same database in SQLite, read lazily: one row per object, children materialized on access."/>
					<outline text="- **usertalk.js** -- the package front door."/>
					<outline text="- **run.js / runAll.js / parseAll.js / parseSuite.js** -- runners and corpus tests."/>
					</outline>
				<outline text="- **examples/** -- working UserTalk programs to run and crib from."/>
				<outline text="- **source.opml** -- the whole package as one outline, for reading in an outliner. Generated from the files; every file renders back from it byte-identical."/>
				<outline text=""/>
				<outline text="The research run that produced all this -- the report, the verb-surface survey of every verb called across the corpus, and the harness that renders projects from the ODB -- is preserved in misc/research/."/>
				<outline text=""/>
				<outline text="***"/>
				<outline text=""/>
				<outline text="*By Claude Code, with Dave Winer driving. UserTalk and Frontier by Dave Winer, UserLand Software.*"/>
				</outline>
			<outline text="code/parse.js">
				<outline text="/*  Parse UserTalk into an AST. The grammar is langparser.y from the">
					<outline text="Frontier kernel; the input is outline-structured code -- each line is"/>
					<outline text="one statement or block header, its children are its block. There are"/>
					<outline text="no braces."/>
					<outline text=""/>
					<outline text="Precedence, from the yacc declarations, loosest first:"/>
					<outline text=", then = (assign) then or then and then == != then &lt; &gt; &lt;= &gt;="/>
					<outline text="beginswith endswith contains then + - then * / mod then not then"/>
					<outline text="++ -- unary-minus @ then ^ then ."/>
					<outline text=""/>
					<outline text="by CC, 7/27/26 */"/>
					</outline>
				<outline text=""/>
				<outline text="const keywords = [">
					<outline text="&quot;if&quot;, &quot;else&quot;, &quot;loop&quot;, &quot;fileloop&quot;, &quot;in&quot;, &quot;break&quot;, &quot;return&quot;, &quot;bundle&quot;,"/>
					<outline text="&quot;local&quot;, &quot;global&quot;, &quot;on&quot;, &quot;while&quot;, &quot;case&quot;, &quot;kernel&quot;, &quot;for&quot;, &quot;to&quot;,"/>
					<outline text="&quot;downto&quot;, &quot;continue&quot;, &quot;with&quot;, &quot;try&quot;, &quot;and&quot;, &quot;or&quot;, &quot;not&quot;,"/>
					<outline text="&quot;beginswith&quot;, &quot;endswith&quot;, &quot;contains&quot;, &quot;mod&quot;"/>
					<outline text="];"/>
					</outline>
				<outline text=""/>
				<outline text="function tokenize (theText) {">
					<outline text=""/>
					<outline text="const tokens = [];"/>
					<outline text="var ix = 0;"/>
					<outline text=""/>
					<outline text="function error (message) {">
						<outline text="throw new Error (&quot;Can't tokenize the line because &quot; + message);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="while (ix &lt; theText.length) {">
						<outline text=""/>
						<outline text="const ch = theText.charAt (ix);"/>
						<outline text=""/>
						<outline text="if ((ch === &quot; &quot;) || (ch === &quot;\t&quot;)) {">
							<outline text="ix++;"/>
							<outline text="continue;"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="if (ch === &quot;&#xAB;&quot;) { //left chevron, comment to matching right chevron or end of line">
							<outline text="const ixEnd = theText.indexOf (&quot;&#xBB;&quot;, ix); //right chevron"/>
							<outline text="if (ixEnd === -1) {">
								<outline text="break;"/>
								<outline text="}"/>
								</outline>
							<outline text="ix = ixEnd + 1;"/>
							<outline text="continue;"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="if ((ch === &quot;/&quot;) &amp;&amp; (theText.charAt (ix + 1) === &quot;/&quot;)) { //line comment, rest of line">
							<outline text="break;"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="if (ch === &quot;&#xB4;&quot;) { //acute accent, the older Frontier line comment, rest of line">
							<outline text="break;"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="if ((ch === &quot;\&quot;&quot;) || (ch === &quot;'&quot;)) {">
							<outline text="var literal = &quot;&quot;;"/>
							<outline text="ix++;"/>
							<outline text="while (ix &lt; theText.length) {">
								<outline text="const chString = theText.charAt (ix);"/>
								<outline text="if (chString === ch) {">
									<outline text="break;"/>
									<outline text="}"/>
									</outline>
								<outline text="if (chString === &quot;\\&quot;) {">
									<outline text="ix++;"/>
									<outline text="const chEscaped = theText.charAt (ix);"/>
									<outline text="switch (chEscaped) {">
										<outline text="case &quot;n&quot;:">
											<outline text="literal += &quot;\n&quot;;"/>
											<outline text="break;"/>
											</outline>
										<outline text="case &quot;r&quot;:">
											<outline text="literal += &quot;\r&quot;;"/>
											<outline text="break;"/>
											</outline>
										<outline text="case &quot;t&quot;:">
											<outline text="literal += &quot;\t&quot;;"/>
											<outline text="break;"/>
											</outline>
										<outline text="default:">
											<outline text="literal += chEscaped;"/>
											<outline text="break;"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="literal += chString;"/>
									<outline text="}"/>
									</outline>
								<outline text="ix++;"/>
								<outline text="}"/>
								</outline>
							<outline text="if (ix &gt;= theText.length) {">
								<outline text="error (&quot;a string that starts with &quot; + ch + &quot; never closes.&quot;);"/>
								<outline text="}"/>
								</outline>
							<outline text="ix++;"/>
							<outline text="tokens.push ({type: &quot;string&quot;, value: literal});"/>
							<outline text="continue;"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="if ((ch &gt;= &quot;0&quot;) &amp;&amp; (ch &lt;= &quot;9&quot;)) {">
							<outline text="var number = &quot;&quot;;"/>
							<outline text="while ((ix &lt; theText.length) &amp;&amp; (/[0-9.xXa-fA-F]/.test (theText.charAt (ix)))) {">
								<outline text="if ((theText.charAt (ix) === &quot;.&quot;) &amp;&amp; !(/[0-9]/.test (theText.charAt (ix + 1)))) {">
									<outline text="break; //a dot not followed by a digit belongs to a path, not this number"/>
									<outline text="}"/>
									</outline>
								<outline text="number += theText.charAt (ix);"/>
								<outline text="ix++;"/>
								<outline text="}"/>
								</outline>
							<outline text="tokens.push ({type: &quot;number&quot;, value: Number (number)});"/>
							<outline text="continue;"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="if (/[A-Za-z_]/.test (ch)) {">
							<outline text="var word = &quot;&quot;;"/>
							<outline text="while ((ix &lt; theText.length) &amp;&amp; (/[A-Za-z0-9_]/.test (theText.charAt (ix)))) {">
								<outline text="word += theText.charAt (ix);"/>
								<outline text="ix++;"/>
								<outline text="}"/>
								</outline>
							<outline text="const lower = word.toLowerCase ();"/>
							<outline text="if (keywords.indexOf (lower) !== -1) {">
								<outline text="tokens.push ({type: lower, word});"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="if (lower === &quot;true&quot;) {">
									<outline text="tokens.push ({type: &quot;boolean&quot;, value: true});"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="if (lower === &quot;false&quot;) {">
										<outline text="tokens.push ({type: &quot;boolean&quot;, value: false});"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="if (lower === &quot;infinity&quot;) {">
											<outline text="tokens.push ({type: &quot;number&quot;, value: Infinity});"/>
											<outline text="}"/>
											</outline>
										<outline text="else {">
											<outline text="tokens.push ({type: &quot;id&quot;, name: word});"/>
											<outline text="}"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="continue;"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="function take (theOperator, theType) {">
							<outline text="if (theText.slice (ix, ix + theOperator.length) === theOperator) {">
								<outline text="tokens.push ({type: theType});"/>
								<outline text="ix += theOperator.length;"/>
								<outline text="return (true);"/>
								<outline text="}"/>
								</outline>
							<outline text="return (false);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="if (take (&quot;==&quot;, &quot;eq&quot;) || take (&quot;!=&quot;, &quot;ne&quot;) || take (&quot;&lt;=&quot;, &quot;le&quot;) || take (&quot;&gt;=&quot;, &quot;ge&quot;) ||">
							<outline text="take (&quot;&amp;&amp;&quot;, &quot;and&quot;) || take (&quot;||&quot;, &quot;or&quot;) || take (&quot;++&quot;, &quot;plusplus&quot;) || take (&quot;--&quot;, &quot;minusminus&quot;) ||"/>
							<outline text="take (&quot;&#x2260;&quot;, &quot;ne&quot;) || take (&quot;&#x2264;&quot;, &quot;le&quot;) || take (&quot;&#x2265;&quot;, &quot;ge&quot;) || //not-equal, less-or-equal, greater-or-equal signs"/>
							<outline text="take (&quot;=&quot;, &quot;assign&quot;) || take (&quot;&lt;&quot;, &quot;lt&quot;) || take (&quot;&gt;&quot;, &quot;gt&quot;) ||"/>
							<outline text="take (&quot;+&quot;, &quot;add&quot;) || take (&quot;-&quot;, &quot;subtract&quot;) || take (&quot;*&quot;, &quot;multiply&quot;) ||"/>
							<outline text="take (&quot;/&quot;, &quot;divide&quot;) || take (&quot;%&quot;, &quot;mod&quot;) || take (&quot;!&quot;, &quot;not&quot;) ||"/>
							<outline text="take (&quot;@&quot;, &quot;at&quot;) || take (&quot;^&quot;, &quot;deref&quot;) || take (&quot;.&quot;, &quot;dot&quot;) ||"/>
							<outline text="take (&quot;,&quot;, &quot;comma&quot;) || take (&quot;(&quot;, &quot;lparen&quot;) || take (&quot;)&quot;, &quot;rparen&quot;) ||"/>
							<outline text="take (&quot;[&quot;, &quot;lbracket&quot;) || take (&quot;]&quot;, &quot;rbracket&quot;) ||"/>
							<outline text="take (&quot;{&quot;, &quot;lbrace&quot;) || take (&quot;}&quot;, &quot;rbrace&quot;) || take (&quot;;&quot;, &quot;semicolon&quot;) ||"/>
							<outline text="take (&quot;:&quot;, &quot;colon&quot;)) {"/>
							<outline text="continue;"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="error (&quot;the character \&quot;&quot; + ch + &quot;\&quot; isn't part of the language.&quot;);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="tokens.push ({type: &quot;eol&quot;});"/>
					<outline text="return (tokens);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function parseLine (theText) {">
					<outline text=""/>
					<outline text="/*  Parse one line into a statement node. Block statements get their">
						<outline text="bodies attached later, from the outline structure.  */"/>
						</outline>
					<outline text=""/>
					<outline text="const tokens = tokenize (theText);"/>
					<outline text="var ixToken = 0;"/>
					<outline text=""/>
					<outline text="function peek () {">
						<outline text="return (tokens [ixToken]);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function next () {">
						<outline text="const token = tokens [ixToken];"/>
						<outline text="ixToken++;"/>
						<outline text="return (token);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function expect (theType, theContext) {">
						<outline text="const token = next ();"/>
						<outline text="if (token.type !== theType) {">
							<outline text="throw new Error (&quot;Can't parse the line because &quot; + theContext + &quot; expected &quot; + theType + &quot; but got &quot; + token.type + &quot;.&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (token);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function flAtEnd () {">
						<outline text="return (peek ().type === &quot;eol&quot;);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="//expressions, precedence climbing per the yacc declarations"/>
					<outline text=""/>
					<outline text="function parsePrimary () {">
						<outline text=""/>
						<outline text="const token = next ();"/>
						<outline text=""/>
						<outline text="switch (token.type) {">
							<outline text="case &quot;string&quot;:">
								<outline text="return ({op: &quot;const&quot;, value: token.value});"/>
								</outline>
							<outline text="case &quot;number&quot;:">
								<outline text="return ({op: &quot;const&quot;, value: token.value});"/>
								</outline>
							<outline text="case &quot;boolean&quot;:">
								<outline text="return ({op: &quot;const&quot;, value: token.value});"/>
								</outline>
							<outline text="case &quot;id&quot;:">
								<outline text="return ({op: &quot;id&quot;, name: token.name});"/>
								</outline>
							<outline text="case &quot;lparen&quot;: {">
								<outline text="const inner = parseExpr ();"/>
								<outline text="expect (&quot;rparen&quot;, &quot;a parenthesized expression&quot;);"/>
								<outline text="return (inner);"/>
								<outline text="}"/>
								</outline>
							<outline text="case &quot;lbracket&quot;: { //a computed identifier: [server].mail.send, @[path + name]">
								<outline text="const nameExpr = parseExpr ();"/>
								<outline text="expect (&quot;rbracket&quot;, &quot;a computed identifier&quot;);"/>
								<outline text="return ({op: &quot;computedid&quot;, expr: nameExpr});"/>
								<outline text="}"/>
								</outline>
							<outline text="case &quot;lbrace&quot;: { //a list literal">
								<outline text="const items = [];"/>
								<outline text="if (peek ().type !== &quot;rbrace&quot;) {">
									<outline text="items.push (parseExpr ());"/>
									<outline text="while (peek ().type === &quot;comma&quot;) {">
										<outline text="next ();"/>
										<outline text="items.push (parseExpr ());"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="expect (&quot;rbrace&quot;, &quot;a list literal&quot;);"/>
								<outline text="return ({op: &quot;list&quot;, items});"/>
								<outline text="}"/>
								</outline>
							<outline text="case &quot;at&quot;:">
								<outline text="return ({op: &quot;address&quot;, expr: parseUnary ()});"/>
								</outline>
							<outline text="case &quot;not&quot;:">
								<outline text="return ({op: &quot;not&quot;, expr: parseUnary ()});"/>
								</outline>
							<outline text="case &quot;subtract&quot;:">
								<outline text="return ({op: &quot;negate&quot;, expr: parseUnary ()});"/>
								</outline>
							<outline text="case &quot;plusplus&quot;:">
								<outline text="return ({op: &quot;preincrement&quot;, expr: parseUnary ()});"/>
								</outline>
							<outline text="case &quot;minusminus&quot;:">
								<outline text="return ({op: &quot;predecrement&quot;, expr: parseUnary ()});"/>
								</outline>
							<outline text="default:">
								<outline text="throw new Error (&quot;Can't parse the line because an expression can't start with &quot; + token.type + &quot;.&quot;);"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function parsePostfix () {">
						<outline text="var node = parsePrimary ();"/>
						<outline text="while (true) {">
							<outline text="const token = peek ();"/>
							<outline text="if (token.type === &quot;dot&quot;) {">
								<outline text="next ();"/>
								<outline text="if (peek ().type === &quot;lbracket&quot;) {">
									<outline text="/*  computed member: adrtable^.[fname] -- the dot form is a">
										<outline text="computed NAME, so .[2026] means the entry named 2026;"/>
										<outline text="the bare form, table [2], means the second entry.  */"/>
										</outline>
									<outline text="next ();"/>
									<outline text="const memberExpr = parseExpr ();"/>
									<outline text="expect (&quot;rbracket&quot;, &quot;a computed member&quot;);"/>
									<outline text="node = {op: &quot;index&quot;, left: node, index: memberExpr, flComputedName: true};"/>
									<outline text="continue;"/>
									<outline text="}"/>
									</outline>
								<outline text="const idToken = next ();"/>
								<outline text="if ((idToken.type !== &quot;id&quot;) &amp;&amp; (keywords.indexOf (idToken.type) === -1)) {">
									<outline text="throw new Error (&quot;Can't parse the line because a dot must be followed by a name, not &quot; + idToken.type + &quot;.&quot;);"/>
									<outline text="}"/>
									</outline>
								<outline text="var name = idToken.name;"/>
								<outline text="if (name === undefined) {">
									<outline text="name = idToken.word; //a keyword used as a table entry name, legal after a dot"/>
									<outline text="}"/>
									</outline>
								<outline text="node = {op: &quot;dot&quot;, left: node, name};"/>
								<outline text="continue;"/>
								<outline text="}"/>
								</outline>
							<outline text="if (token.type === &quot;lbracket&quot;) {">
								<outline text="next ();"/>
								<outline text="const index = parseExpr ();"/>
								<outline text="expect (&quot;rbracket&quot;, &quot;a subscript&quot;);"/>
								<outline text="node = {op: &quot;index&quot;, left: node, index};"/>
								<outline text="continue;"/>
								<outline text="}"/>
								</outline>
							<outline text="if (token.type === &quot;lparen&quot;) {">
								<outline text="next ();"/>
								<outline text="const args = [];"/>
								<outline text="if (peek ().type !== &quot;rparen&quot;) {">
									<outline text="args.push (parseCallArg ());"/>
									<outline text="while (peek ().type === &quot;comma&quot;) {">
										<outline text="next ();"/>
										<outline text="args.push (parseCallArg ());"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="expect (&quot;rparen&quot;, &quot;a call's arguments&quot;);"/>
								<outline text="node = {op: &quot;call&quot;, fn: node, args};"/>
								<outline text="continue;"/>
								<outline text="}"/>
								</outline>
							<outline text="if (token.type === &quot;deref&quot;) {">
								<outline text="next ();"/>
								<outline text="node = {op: &quot;deref&quot;, expr: node};"/>
								<outline text="continue;"/>
								<outline text="}"/>
								</outline>
							<outline text="if (token.type === &quot;plusplus&quot;) {">
								<outline text="next ();"/>
								<outline text="node = {op: &quot;postincrement&quot;, expr: node};"/>
								<outline text="continue;"/>
								<outline text="}"/>
								</outline>
							<outline text="if (token.type === &quot;minusminus&quot;) {">
								<outline text="next ();"/>
								<outline text="node = {op: &quot;postdecrement&quot;, expr: node};"/>
								<outline text="continue;"/>
								<outline text="}"/>
								</outline>
							<outline text="break;"/>
							<outline text="}"/>
							</outline>
						<outline text="return (node);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function parseCallArg () { //an argument may be named: flatfilenames: true">
						<outline text="if ((peek ().type === &quot;id&quot;) &amp;&amp; (tokens [ixToken + 1] !== undefined) &amp;&amp; (tokens [ixToken + 1].type === &quot;colon&quot;)) {">
							<outline text="const nameToken = next ();"/>
							<outline text="next ();"/>
							<outline text="return ({op: &quot;namedarg&quot;, name: nameToken.name, value: parseExpr ()});"/>
							<outline text="}"/>
							</outline>
						<outline text="return (parseExpr ());"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function parseUnary () {">
						<outline text="return (parsePostfix ());"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="const binaryLevels = [ //loosest first; assign handled at statement level">
						<outline text="[&quot;or&quot;],"/>
						<outline text="[&quot;and&quot;],"/>
						<outline text="[&quot;eq&quot;, &quot;ne&quot;],"/>
						<outline text="[&quot;lt&quot;, &quot;gt&quot;, &quot;le&quot;, &quot;ge&quot;, &quot;beginswith&quot;, &quot;endswith&quot;, &quot;contains&quot;],"/>
						<outline text="[&quot;add&quot;, &quot;subtract&quot;],"/>
						<outline text="[&quot;multiply&quot;, &quot;divide&quot;, &quot;mod&quot;]"/>
						<outline text="];"/>
						</outline>
					<outline text=""/>
					<outline text="function parseBinary (level) {">
						<outline text="if (level &gt;= binaryLevels.length) {">
							<outline text="return (parseUnary ());"/>
							<outline text="}"/>
							</outline>
						<outline text="var node = parseBinary (level + 1);"/>
						<outline text="while (binaryLevels [level].indexOf (peek ().type) !== -1) {">
							<outline text="const operator = next ().type;"/>
							<outline text="const right = parseBinary (level + 1);"/>
							<outline text="node = {op: operator, left: node, right};"/>
							<outline text="}"/>
							</outline>
						<outline text="return (node);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function parseExpr () {">
						<outline text="return (parseBinary (0));"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function parseNameList () { //for local (...) and handler parameters: name, or name = default">
						<outline text="const inits = [];"/>
						<outline text="if ((peek ().type !== &quot;rparen&quot;) &amp;&amp; (peek ().type !== &quot;rbrace&quot;)) {">
							<outline text="while (true) {">
								<outline text="const nameToken = expect (&quot;id&quot;, &quot;a name list&quot;);"/>
								<outline text="var value = undefined; //8/4/26 by CC -- var is function-scoped, so without the reset every name after an initialized one inherited its value: local (a = f (), b, c) gave b and c the value of f ()"/>
								<outline text="if (peek ().type === &quot;assign&quot;) {">
									<outline text="next ();"/>
									<outline text="value = parseExpr ();"/>
									<outline text="}"/>
									</outline>
								<outline text="inits.push ({name: nameToken.name, value});"/>
								<outline text="if (peek ().type === &quot;comma&quot;) {">
									<outline text="next ();"/>
									<outline text="continue;"/>
									<outline text="}"/>
									</outline>
								<outline text="break;"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="return (inits);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function parseSimpleStatement () { //an expression or an assignment, no keyword forms">
						<outline text="const expr = parseExpr ();"/>
						<outline text="if (peek ().type === &quot;assign&quot;) {">
							<outline text="next ();"/>
							<outline text="const value = parseExpr ();"/>
							<outline text="return ({op: &quot;assign&quot;, target: expr, value});"/>
							<outline text="}"/>
							</outline>
						<outline text="return ({op: &quot;expression&quot;, expr});"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function parseStatement () {">
						<outline text=""/>
						<outline text="const token = peek ();"/>
						<outline text=""/>
						<outline text="switch (token.type) {">
							<outline text=""/>
							<outline text="case &quot;eol&quot;:">
								<outline text="return ({op: &quot;noop&quot;});"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;on&quot;: {">
								<outline text="next ();"/>
								<outline text="const nameToken = expect (&quot;id&quot;, &quot;a handler definition&quot;);"/>
								<outline text="expect (&quot;lparen&quot;, &quot;a handler definition&quot;);"/>
								<outline text="const params = parseNameList ();"/>
								<outline text="expect (&quot;rparen&quot;, &quot;a handler definition&quot;);"/>
								<outline text="return ({op: &quot;handler&quot;, name: nameToken.name, params, body: []});"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;local&quot;: case &quot;global&quot;: {">
								<outline text="const which = next ().type;"/>
								<outline text="var inits = [];"/>
								<outline text="if (peek ().type === &quot;eol&quot;) { //block form: bare local, declarations on the child lines">
									<outline text="return ({op: which, inits, flBlockForm: true});"/>
									<outline text="}"/>
									</outline>
								<outline text="if (peek ().type === &quot;lparen&quot;) {">
									<outline text="next ();"/>
									<outline text="inits = parseNameList ();"/>
									<outline text="expect (&quot;rparen&quot;, &quot;a &quot; + which + &quot; declaration&quot;);"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="if (peek ().type === &quot;lbrace&quot;) {">
										<outline text="next ();"/>
										<outline text="inits = parseNameList ();"/>
										<outline text="expect (&quot;rbrace&quot;, &quot;a &quot; + which + &quot; declaration&quot;);"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="inits = parseNameList (); //bare form: local name = value"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="return ({op: which, inits});"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;if&quot;: {">
								<outline text="next ();"/>
								<outline text="const test = parseExpr ();"/>
								<outline text="return ({op: &quot;if&quot;, test, body: [], elseBody: undefined});"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;else&quot;:">
								<outline text="next ();"/>
								<outline text="if (peek ().type === &quot;if&quot;) { //else if, cascaded">
									<outline text="const nested = parseStatement ();"/>
									<outline text="return ({op: &quot;else&quot;, nestedIf: nested, body: []});"/>
									<outline text="}"/>
									</outline>
								<outline text="return ({op: &quot;else&quot;, body: []});"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;loop&quot;: {">
								<outline text="next ();"/>
								<outline text="if (peek ().type === &quot;lparen&quot;) {">
									<outline text="next ();"/>
									<outline text="const first = parseSimpleStatement ();"/>
									<outline text="if (peek ().type === &quot;semicolon&quot;) { //loop (init; test; step)">
										<outline text="next ();"/>
										<outline text="const test = parseExpr ();"/>
										<outline text="expect (&quot;semicolon&quot;, &quot;a three-part loop header&quot;);"/>
										<outline text="const step = parseSimpleStatement ();"/>
										<outline text="expect (&quot;rparen&quot;, &quot;a three-part loop header&quot;);"/>
										<outline text="return ({op: &quot;loop3&quot;, init: first, test, step, body: []});"/>
										<outline text="}"/>
										</outline>
									<outline text="expect (&quot;rparen&quot;, &quot;a loop header&quot;);"/>
									<outline text="if (first.op !== &quot;expression&quot;) {">
										<outline text="throw new Error (&quot;Can't parse the line because a counted loop header needs an expression.&quot;);"/>
										<outline text="}"/>
										</outline>
									<outline text="return ({op: &quot;loop&quot;, count: first.expr, body: []});"/>
									<outline text="}"/>
									</outline>
								<outline text="return ({op: &quot;loop&quot;, body: []});"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;while&quot;: {">
								<outline text="next ();"/>
								<outline text="const test = parseExpr ();"/>
								<outline text="return ({op: &quot;while&quot;, test, body: []});"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;fileloop&quot;: {">
								<outline text="next ();"/>
								<outline text="expect (&quot;lparen&quot;, &quot;a fileloop header&quot;);"/>
								<outline text="const nameToken = expect (&quot;id&quot;, &quot;a fileloop header&quot;);"/>
								<outline text="expect (&quot;in&quot;, &quot;a fileloop header&quot;);"/>
								<outline text="const folder = parseExpr ();"/>
								<outline text="var depth;"/>
								<outline text="if (peek ().type === &quot;comma&quot;) {">
									<outline text="next ();"/>
									<outline text="depth = parseExpr ();"/>
									<outline text="}"/>
									</outline>
								<outline text="expect (&quot;rparen&quot;, &quot;a fileloop header&quot;);"/>
								<outline text="return ({op: &quot;fileloop&quot;, name: nameToken.name, folder, depth, body: []});"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;for&quot;: {">
								<outline text="next ();"/>
								<outline text="var flParen = false;"/>
								<outline text="if (peek ().type === &quot;lparen&quot;) { //optional parens: for (x in y)">
									<outline text="next ();"/>
									<outline text="flParen = true;"/>
									<outline text="}"/>
									</outline>
								<outline text="const nameToken = expect (&quot;id&quot;, &quot;a for header&quot;);"/>
								<outline text="if (peek ().type === &quot;in&quot;) {">
									<outline text="next ();"/>
									<outline text="const list = parseExpr ();"/>
									<outline text="if (flParen) {">
										<outline text="expect (&quot;rparen&quot;, &quot;a for header&quot;);"/>
										<outline text="}"/>
										</outline>
									<outline text="return ({op: &quot;forin&quot;, name: nameToken.name, list, body: []});"/>
									<outline text="}"/>
									</outline>
								<outline text="expect (&quot;assign&quot;, &quot;a for header&quot;);"/>
								<outline text="const from = parseExpr ();"/>
								<outline text="const directionToken = next ();"/>
								<outline text="if ((directionToken.type !== &quot;to&quot;) &amp;&amp; (directionToken.type !== &quot;downto&quot;)) {">
									<outline text="throw new Error (&quot;Can't parse the line because a for header expected to or downto, not &quot; + directionToken.type + &quot;.&quot;);"/>
									<outline text="}"/>
									</outline>
								<outline text="const limit = parseExpr ();"/>
								<outline text="if (flParen) {">
									<outline text="expect (&quot;rparen&quot;, &quot;a for header&quot;);"/>
									<outline text="}"/>
									</outline>
								<outline text="return ({op: &quot;for&quot;, name: nameToken.name, from, limit, flDown: directionToken.type === &quot;downto&quot;, body: []});"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;bundle&quot;:">
								<outline text="next ();"/>
								<outline text="return ({op: &quot;bundle&quot;, body: []});"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;with&quot;: {">
								<outline text="next ();"/>
								<outline text="const path = parseExpr ();"/>
								<outline text="return ({op: &quot;with&quot;, path, body: []});"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;try&quot;:">
								<outline text="next ();"/>
								<outline text="if (peek ().type === &quot;lbrace&quot;) { //inline form: try {statements}, semicolons legal, return legal">
									<outline text="next ();"/>
									<outline text="const inner = [];"/>
									<outline text="if (peek ().type !== &quot;rbrace&quot;) {">
										<outline text="inner.push (parseStatement ());"/>
										<outline text="while (peek ().type === &quot;semicolon&quot;) {">
											<outline text="next ();"/>
											<outline text="if (peek ().type !== &quot;rbrace&quot;) {">
												<outline text="inner.push (parseStatement ());"/>
												<outline text="}"/>
												</outline>
											<outline text="}"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="expect (&quot;rbrace&quot;, &quot;an inline try&quot;);"/>
									<outline text="return ({op: &quot;try&quot;, body: inner, elseBody: undefined});"/>
									<outline text="}"/>
									</outline>
								<outline text="return ({op: &quot;try&quot;, body: [], elseBody: undefined});"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;case&quot;: {">
								<outline text="next ();"/>
								<outline text="const value = parseExpr ();"/>
								<outline text="return ({op: &quot;case&quot;, value, body: []});"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;kernel&quot;: {">
								<outline text="/*  7/27/26 by CC -- kernel (x.y.z): a builtin's body line saying">
									<outline text="&quot;the implementation lives in the kernel here&quot;. Becomes a call"/>
									<outline text="to the kernel special form; the path is read token by token"/>
									<outline text="so path parts that collide with keywords still parse.  */"/>
									</outline>
								<outline text="next ();"/>
								<outline text="expect (&quot;lparen&quot;, &quot;a kernel statement&quot;);"/>
								<outline text="var kernelPath = &quot;&quot;;"/>
								<outline text="while ((!flAtEnd ()) &amp;&amp; (peek ().type !== &quot;rparen&quot;)) {">
									<outline text="const pathToken = next ();"/>
									<outline text="if (pathToken.type === &quot;dot&quot;) {">
										<outline text="kernelPath += &quot;.&quot;;"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="kernelPath += (pathToken.name !== undefined) ? pathToken.name : ((pathToken.word !== undefined) ? pathToken.word : String (pathToken.value));"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="expect (&quot;rparen&quot;, &quot;a kernel statement&quot;);"/>
								<outline text="var kernelArgNode = {op: &quot;id&quot;, name: kernelPath.split (&quot;.&quot;) [0]};"/>
								<outline text="kernelPath.split (&quot;.&quot;).slice (1).forEach (function (part) {">
									<outline text="kernelArgNode = {op: &quot;dot&quot;, left: kernelArgNode, name: part};"/>
									<outline text="});"/>
									</outline>
								<outline text="return ({op: &quot;expression&quot;, expr: {op: &quot;call&quot;, fn: {op: &quot;id&quot;, name: &quot;kernel&quot;}, args: [kernelArgNode]}});"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;break&quot;:">
								<outline text="next ();"/>
								<outline text="if (peek ().type === &quot;lparen&quot;) {">
									<outline text="next ();"/>
									<outline text="expect (&quot;rparen&quot;, &quot;a break statement&quot;);"/>
									<outline text="}"/>
									</outline>
								<outline text="return ({op: &quot;break&quot;});"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;continue&quot;:">
								<outline text="next ();"/>
								<outline text="return ({op: &quot;continue&quot;});"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;return&quot;: {">
								<outline text="next ();"/>
								<outline text="var value;"/>
								<outline text="if (!flAtEnd () &amp;&amp; (peek ().type !== &quot;semicolon&quot;)) {">
									<outline text="value = parseExpr ();"/>
									<outline text="}"/>
									</outline>
								<outline text="return ({op: &quot;return&quot;, value});"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="default: {">
								<outline text="const expr = parseExpr ();"/>
								<outline text="if (peek ().type === &quot;assign&quot;) {">
									<outline text="next ();"/>
									<outline text="const value = parseExpr ();"/>
									<outline text="return ({op: &quot;assign&quot;, target: expr, value});"/>
									<outline text="}"/>
									</outline>
								<outline text="return ({op: &quot;expression&quot;, expr});"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function attachInlineBody (statement) {">
						<outline text="/*  7/27/26 by CC -- a block header can carry its body inline in">
							<outline text="braces: while (typeof (nomad^) == addresstype) {nomad = nomad^}  */"/>
							</outline>
						<outline text="if ((peek ().type === &quot;lbrace&quot;) &amp;&amp; (blockOps.indexOf (statement.op) !== -1)) {">
							<outline text="next ();"/>
							<outline text="statement.body = [];"/>
							<outline text="if (peek ().type !== &quot;rbrace&quot;) {">
								<outline text="statement.body.push (parseStatement ());"/>
								<outline text="while (peek ().type === &quot;semicolon&quot;) {">
									<outline text="next ();"/>
									<outline text="if (peek ().type !== &quot;rbrace&quot;) {">
										<outline text="statement.body.push (parseStatement ());"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="expect (&quot;rbrace&quot;, &quot;an inline block body&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="const statements = [];"/>
					<outline text="statements.push (parseStatement ());"/>
					<outline text="attachInlineBody (statements [statements.length - 1]);"/>
					<outline text="while (peek ().type === &quot;semicolon&quot;) { //semicolons separate statements on one line, and trail legally">
						<outline text="next ();"/>
						<outline text="if (!flAtEnd ()) {">
							<outline text="statements.push (parseStatement ());"/>
							<outline text="attachInlineBody (statements [statements.length - 1]);"/>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="if (!flAtEnd ()) {">
						<outline text="throw new Error (&quot;Can't parse the line because there are extra tokens after the statement, starting with &quot; + peek ().type + &quot;.&quot;);"/>
						<outline text="}"/>
						</outline>
					<outline text="if (statements.length === 1) {">
						<outline text="return (statements [0]);"/>
						<outline text="}"/>
						</outline>
					<outline text="return ({op: &quot;sequence&quot;, statements});"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="const blockOps = [&quot;handler&quot;, &quot;if&quot;, &quot;else&quot;, &quot;loop&quot;, &quot;loop3&quot;, &quot;while&quot;, &quot;fileloop&quot;, &quot;for&quot;, &quot;forin&quot;, &quot;bundle&quot;, &quot;with&quot;, &quot;try&quot;, &quot;case&quot;];"/>
				<outline text=""/>
				<outline text="function parseOutline (theNodes) {">
					<outline text=""/>
					<outline text="/*  theNodes is an array of {text, subs} outline nodes. Returns an">
						<outline text="array of statements, children attached as bodies, else-lines"/>
						<outline text="joined to their if or try.  */"/>
						</outline>
					<outline text=""/>
					<outline text="const statements = [];"/>
					<outline text=""/>
					<outline text="theNodes.forEach (function (node) {">
						<outline text=""/>
						<outline text="if ((node.text.trim ().length === 0) &amp;&amp; (node.subs.length &gt; 0)) { //a blank organizer line -- its children run at this level">
							<outline text="parseOutline (node.subs).forEach (function (child) {">
								<outline text="statements.push (child);"/>
								<outline text="});"/>
								</outline>
							<outline text="return;"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="const statement = parseLine (node.text);"/>
						<outline text=""/>
						<outline text="if (statement.op === &quot;case&quot;) { //children are clauses: a value line whose children are its body, or an else line">
							<outline text="statement.clauses = [];"/>
							<outline text="node.subs.forEach (function (clauseNode) {">
								<outline text="const clauseLine = parseLine (clauseNode.text);"/>
								<outline text="if (clauseLine.op === &quot;else&quot;) {">
									<outline text="statement.elseBody = parseOutline (clauseNode.subs);"/>
									<outline text="return;"/>
									<outline text="}"/>
									</outline>
								<outline text="if (clauseLine.op !== &quot;expression&quot;) {">
									<outline text="throw new Error (&quot;Can't parse the outline because the case clause \&quot;&quot; + clauseNode.text + &quot;\&quot; isn't a value.&quot;);"/>
									<outline text="}"/>
									</outline>
								<outline text="statement.clauses.push ({value: clauseLine.expr, body: parseOutline (clauseNode.subs)});"/>
								<outline text="});"/>
								</outline>
							<outline text="statements.push (statement);"/>
							<outline text="return;"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="if (node.subs.length &gt; 0) {">
							<outline text="if (((statement.op === &quot;local&quot;) || (statement.op === &quot;global&quot;)) &amp;&amp; (statement.flBlockForm === true)) {">
								<outline text="/*  block form: bare local over child lines, one declaration">
									<outline text="each -- a name, or name = value.  */"/>
									</outline>
								<outline text="node.subs.forEach (function (declarationNode) {">
									<outline text="const declaration = parseLine (declarationNode.text);"/>
									<outline text="if ((declaration.op === &quot;assign&quot;) &amp;&amp; (declaration.target.op === &quot;id&quot;)) {">
										<outline text="statement.inits.push ({name: declaration.target.name, value: declaration.value});"/>
										<outline text="return;"/>
										<outline text="}"/>
										</outline>
									<outline text="if ((declaration.op === &quot;expression&quot;) &amp;&amp; (declaration.expr.op === &quot;id&quot;)) {">
										<outline text="statement.inits.push ({name: declaration.expr.name});"/>
										<outline text="return;"/>
										<outline text="}"/>
										</outline>
									<outline text="throw new Error (&quot;Can't parse the outline because the &quot; + statement.op + &quot; declaration \&quot;&quot; + declarationNode.text + &quot;\&quot; isn't a name or an assignment.&quot;);"/>
									<outline text="});"/>
									</outline>
								<outline text="statements.push (statement);"/>
								<outline text="return;"/>
								<outline text="}"/>
								</outline>
							<outline text="if (blockOps.indexOf (statement.op) === -1) {">
								<outline text="/*  a plain line with children -- Frontier treats subordinate">
									<outline text="lines of a non-block statement as part of no block; in"/>
									<outline text="Dave's corpus this shape is a continuation comment holder,"/>
									<outline text="so children must be empty of code. Refuse loudly.  */"/>
									</outline>
								<outline text="throw new Error (&quot;Can't parse the outline because the line \&quot;&quot; + node.text + &quot;\&quot; isn't a block header but has sublines.&quot;);"/>
								<outline text="}"/>
								</outline>
							<outline text="if ((statement.op === &quot;else&quot;) &amp;&amp; (statement.nestedIf !== undefined)) {">
								<outline text="statement.nestedIf.body = parseOutline (node.subs);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="statement.body = parseOutline (node.subs);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="if ((statement.op === &quot;else&quot;) &amp;&amp; (statements.length &gt; 0)) {">
							<outline text="const previous = statements [statements.length - 1];"/>
							<outline text="if ((previous.op === &quot;if&quot;) || (previous.op === &quot;try&quot;) || (previous.op === &quot;case&quot;)) {">
								<outline text="if (statement.nestedIf !== undefined) {">
									<outline text="previous.elseBody = [statement.nestedIf];"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="previous.elseBody = statement.body;"/>
									<outline text="}"/>
									</outline>
								<outline text="return;"/>
								<outline text="}"/>
								</outline>
							<outline text="throw new Error (&quot;Can't parse the outline because an else line doesn't follow an if, try or case.&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="statements.push (statement);"/>
						<outline text="});"/>
						</outline>
					<outline text=""/>
					<outline text="return (statements);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function linesToTree (theLines) { //flat {level, text, flComment} lines to {text, subs}, comment subtrees excluded">
					<outline text=""/>
					<outline text="/*  7/28/26 by CC -- a line ending in backslash continues on the next">
						<outline text="line (usually indented one deeper): join the chain into one logical"/>
						<outline text="line at the first line's level before building the tree.  */"/>
						</outline>
					<outline text="const joinedLines = [];"/>
					<outline text="var ixLine = 0;"/>
					<outline text="while (ixLine &lt; theLines.length) {">
						<outline text="const line = theLines [ixLine];"/>
						<outline text="var text = line.text;"/>
						<outline text="var ixAhead = ixLine;"/>
						<outline text="while (text.replace (/\s+$/, &quot;&quot;).endsWith (&quot;\\&quot;) &amp;&amp; (ixAhead + 1 &lt; theLines.length)) {">
							<outline text="text = text.replace (/\s*\\\s*$/, &quot; &quot;);"/>
							<outline text="ixAhead++;"/>
							<outline text="text += theLines [ixAhead].text.trim ();"/>
							<outline text="}"/>
							</outline>
						<outline text="joinedLines.push ({level: line.level, text: text, flComment: line.flComment});"/>
						<outline text="ixLine = ixAhead + 1;"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="const root = {text: &quot;&quot;, subs: []};"/>
					<outline text="const stack = [root];"/>
					<outline text="var depthSkip = -1;"/>
					<outline text="joinedLines.forEach (function (line) {">
						<outline text="if ((depthSkip &gt;= 0) &amp;&amp; (line.level &gt; depthSkip)) {">
							<outline text="return;"/>
							<outline text="}"/>
							</outline>
						<outline text="depthSkip = -1;"/>
						<outline text="if (line.flComment) {">
							<outline text="depthSkip = line.level;"/>
							<outline text="return;"/>
							<outline text="}"/>
							</outline>
						<outline text="const node = {text: line.text, subs: []};"/>
						<outline text="stack [line.level].subs.push (node);"/>
						<outline text="stack [line.level + 1] = node;"/>
						<outline text="stack.length = line.level + 2;"/>
						<outline text="});"/>
						</outline>
					<outline text="return (root.subs);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="exports.parseLine = parseLine;"/>
				<outline text="exports.parseOutline = parseOutline;"/>
				<outline text="exports.tokenize = tokenize;"/>
				<outline text="exports.linesToTree = linesToTree;"/>
				</outline>
			<outline text="code/evaluate.js">
				<outline text="/*  Evaluate a UserTalk AST from parse.js. Semantics from the kernel's">
					<outline text="langevaluate.c: an object-database tree is the global namespace,"/>
					<outline text="locals live in frames, handlers close over their defining frames,"/>
					<outline text="identifier lookup is case-insensitive everywhere."/>
					<outline text=""/>
					<outline text="by CC, 7/27/26 */"/>
					</outline>
				<outline text=""/>
				<outline text="function makeEnvironment (theOdb, theVerbs, theTrace) {">
					<outline text=""/>
					<outline text="const environment = {">
						<outline text="odb: theOdb, //a plain object tree standing in for the ODB"/>
						<outline text="verbs: theVerbs, //lowercase dotted verb name -&gt; function (args, environment)"/>
						<outline text="trace: theTrace, //every verb call gets logged here"/>
						<outline text="frames: [], //the local-variable stack; each frame is {vars: {}}"/>
						<outline text="withPaths: [] //active with-statement prefixes, innermost last"/>
						<outline text="};"/>
						</outline>
					<outline text="installConstants (theOdb);"/>
					<outline text="installEnvironmentTable (theOdb);"/>
					<outline text="return (environment);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function installEnvironmentTable (theOdb) {">
					<outline text="/*  7/27/26 by CC -- system.environment is kernel-populated machine">
						<outline text="facts. We claim to be none of the classic platforms, so scripts"/>
						<outline text="skip Mac text conversion and Windows path fixups.  */"/>
						</outline>
					<outline text="if (theOdb.system === undefined) {">
						<outline text="theOdb.system = {};"/>
						<outline text="}"/>
						</outline>
					<outline text="if (findKey (theOdb.system, &quot;environment&quot;) === undefined) {">
						<outline text="theOdb.system.environment = {">
							<outline text="isMac: false,"/>
							<outline text="isWindows: false,"/>
							<outline text="isUnix: true,"/>
							<outline text="isRadio: false,"/>
							<outline text="isFrontier: true,"/>
							<outline text="isPike: false"/>
							<outline text="};"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="if (findKey (theOdb.system, &quot;temp&quot;) === undefined) {">
						<outline text="theOdb.system.temp = {Frontier: {}}; //the kernel makes system.temp at boot"/>
						<outline text="}"/>
						</outline>
					<outline text="if (findKey (theOdb, &quot;temp&quot;) === undefined) {">
						<outline text="theOdb.temp = theOdb.system.temp; //the paths table makes temp mean system.temp; same table, two names"/>
						<outline text="}"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="const languageConstants = { //type names match what the typeof verb returns, so case statements compare true">
					<outline text="nil: undefined, &quot;this&quot;: undefined,"/>
					<outline text="tabletype: &quot;tabletype&quot;, outlinetype: &quot;outlinetype&quot;, scripttype: &quot;scripttype&quot;,"/>
					<outline text="wptexttype: &quot;wptexttype&quot;, binarytype: &quot;binarytype&quot;, stringtype: &quot;stringtype&quot;,"/>
					<outline text="booleantype: &quot;booleantype&quot;, datetype: &quot;datetype&quot;, numbertype: &quot;numbertype&quot;,"/>
					<outline text="longtype: &quot;numbertype&quot;, inttype: &quot;numbertype&quot;, doubletype: &quot;numbertype&quot;,"/>
					<outline text="listtype: &quot;listtype&quot;, recordtype: &quot;recordtype&quot;, addresstype: &quot;addresstype&quot;,"/>
					<outline text="unknowntype: &quot;unknowntype&quot;,"/>
					<outline text="menubartype: &quot;menubartype&quot;, picttype: &quot;picttype&quot;, filespectype: &quot;filespectype&quot;,"/>
					<outline text="codetype: &quot;codetype&quot;, rgbtype: &quot;rgbtype&quot;, pointtype: &quot;pointtype&quot;,"/>
					<outline text="recttype: &quot;recttype&quot;, chartype: &quot;chartype&quot;, patterntype: &quot;patterntype&quot;,"/>
					<outline text="fixedtype: &quot;fixedtype&quot;, singletype: &quot;singletype&quot;, objspectype: &quot;objspectype&quot;,"/>
					<outline text="cr: &quot;\r&quot;, lf: &quot;\n&quot;, tab: &quot;\t&quot;, space: &quot; &quot;, //the character constants"/>
					<outline text="up: &quot;up&quot;, down: &quot;down&quot;, left: &quot;left&quot;, right: &quot;right&quot;,"/>
					<outline text="flatup: &quot;flatup&quot;, flatdown: &quot;flatdown&quot;,"/>
					<outline text="pageup: &quot;pageup&quot;, pagedown: &quot;pagedown&quot;, firstlist: &quot;firstlist&quot;, lastlist: &quot;lastlist&quot;"/>
					<outline text="};"/>
					</outline>
				<outline text=""/>
				<outline text="function installConstants (theOdb) {">
					<outline text="Object.keys (languageConstants).forEach (function (name) {">
						<outline text="if (findKey (theOdb, name) === undefined) {">
							<outline text="theOdb [name] = languageConstants [name];"/>
							<outline text="}"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function sortedTableKeys (theTable) {">
					<outline text="/*  7/27/26 by CC -- Frontier tables are always sorted by name,">
						<outline text="case-insensitive, so &quot;#prefs&quot; comes before &quot;default&quot; and nth-entry"/>
						<outline text="access sees that order. JS objects remember insertion order, so"/>
						<outline text="every positional walk sorts first.  */"/>
						</outline>
					<outline text="if ((theTable === undefined) || (theTable === null) || (typeof theTable !== &quot;object&quot;)) {">
						<outline text="return ([]); //not a table: no entries to walk, the way an empty table behaves"/>
						<outline text="}"/>
						</outline>
					<outline text="const keys = Object.keys (theTable);"/>
					<outline text="keys.sort (function (a, b) {">
						<outline text="const lowerA = a.toLowerCase (), lowerB = b.toLowerCase ();"/>
						<outline text="if (lowerA &lt; lowerB) {">
							<outline text="return (-1);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (lowerA &gt; lowerB) {">
							<outline text="return (1);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (0);"/>
						<outline text="});"/>
						</outline>
					<outline text="return (keys);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function findKey (theTable, theName) { //case-insensitive key lookup, returns the real key or undefined">
					<outline text="if ((theTable === undefined) || (theTable === null) || (typeof theTable !== &quot;object&quot;)) {">
						<outline text="return (undefined); //nothing to look in"/>
						<outline text="}"/>
						</outline>
					<outline text="if (theTable [theName] !== undefined) {">
						<outline text="return (theName);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="/*  8/4/26 by CC -- a database table looks its children up by lowername, so">
						<outline text="the access above was ALREADY case-insensitive and there is nothing a"/>
						<outline text="scan could find that it missed. Asking &quot;in&quot; costs one query; enumerating"/>
						<outline text="cost one per entry, and it ran on every miss -- 7.2 million queries in a"/>
						<outline text="single sallysReader build, which was all of the build's 25 seconds.  */"/>
						</outline>
					<outline text=""/>
					<outline text="if (theTable.flOdbSqlTable === true) {">
						<outline text="if (theName in theTable) { //an entry that holds no value: present, but undefined on read">
							<outline text="return (theName);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (undefined);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="const lower = theName.toLowerCase ();"/>
					<outline text="var found;"/>
					<outline text="Object.keys (theTable).forEach (function (key) {">
						<outline text="if ((found === undefined) &amp;&amp; (key.toLowerCase () === lower)) {">
							<outline text="found = key;"/>
							<outline text="}"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text="return (found);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="//control-flow signals travel as exceptions"/>
				<outline text=""/>
				<outline text="function BreakSignal () {">
					<outline text="this.flBreakSignal = true;"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function ContinueSignal () {">
					<outline text="this.flContinueSignal = true;"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function ReturnSignal (theValue) {">
					<outline text="this.flReturnSignal = true;"/>
					<outline text="this.value = theValue;"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function evaluate (theStatements, environment) {">
					<outline text=""/>
					<outline text="/*  Run a statement list. Returns the value of the last expression">
						<outline text="statement, the way Frontier scripts return their last value.  */"/>
						</outline>
					<outline text=""/>
					<outline text="var lastValue;"/>
					<outline text=""/>
					<outline text="//references: a {get, set} pair for anything assignable"/>
					<outline text=""/>
					<outline text="function referenceForId (theName) {">
						<outline text=""/>
						<outline text="var ixFrame;"/>
						<outline text="for (ixFrame = environment.frames.length - 1; ixFrame &gt;= 0; ixFrame--) {">
							<outline text="const vars = environment.frames [ixFrame].vars;"/>
							<outline text="const key = findKey (vars, theName);"/>
							<outline text="if (key !== undefined) {">
								<outline text="return ({">
									<outline text="container: vars,"/>
									<outline text="key: key,"/>
									<outline text="get: function () {">
										<outline text="return (vars [key]);"/>
										<outline text="},"/>
										</outline>
									<outline text="set: function (theValue) {">
										<outline text="vars [key] = theValue;"/>
										<outline text="},"/>
										</outline>
									<outline text="remove: function () {">
										<outline text="delete vars [key];"/>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="var ixWith;"/>
						<outline text="for (ixWith = environment.withPaths.length - 1; ixWith &gt;= 0; ixWith--) {">
							<outline text="const withTable = environment.withPaths [ixWith];"/>
							<outline text="if ((withTable === undefined) || (withTable === null) || (typeof withTable !== &quot;object&quot;)) {">
								<outline text="continue; //a with over a missing table scopes nothing"/>
								<outline text="}"/>
								</outline>
							<outline text="const key = findKey (withTable, theName);"/>
							<outline text="if (key !== undefined) {">
								<outline text="return ({">
									<outline text="container: withTable,"/>
									<outline text="key: key,"/>
									<outline text="get: function () {">
										<outline text="return (withTable [key]);"/>
										<outline text="},"/>
										</outline>
									<outline text="set: function (theValue) {">
										<outline text="withTable [key] = theValue;"/>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="const odbKey = findKey (environment.odb, theName);"/>
						<outline text="if (odbKey !== undefined) {">
							<outline text="return ({">
								<outline text="container: environment.odb,"/>
								<outline text="key: odbKey,"/>
								<outline text="get: function () {">
									<outline text="return (environment.odb [odbKey]);"/>
									<outline text="},"/>
									</outline>
								<outline text="set: function (theValue) {">
									<outline text="environment.odb [odbKey] = theValue;"/>
									<outline text="},"/>
									</outline>
								<outline text="remove: function () {">
									<outline text="delete environment.odb [odbKey];"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="/*  7/27/26 by CC -- the system.paths fallback: a name that resolves">
							<outline text="nowhere else is looked up the way Frontier's paths table works,"/>
							<outline text="so string.upper finds system.verbs.builtins.string.upper and"/>
							<outline text="manilaSuite finds a suite wherever the loaded roots put it.  */"/>
							</outline>
						<outline text=""/>
						<outline text="var found;"/>
						<outline text="pathsTablesForOdb (environment.odb).forEach (function (pathsTable) {">
							<outline text="if (found === undefined) {">
								<outline text="const key = findKey (pathsTable, theName);"/>
								<outline text="if (key !== undefined) {">
									<outline text="found = {">
										<outline text="get: function () {">
											<outline text="return (pathsTable [key]);"/>
											<outline text="},"/>
											</outline>
										<outline text="set: function (theValue) {">
											<outline text="pathsTable [key] = theValue;"/>
											<outline text="},"/>
											</outline>
										<outline text="remove: function () {">
											<outline text="delete pathsTable [key];"/>
											<outline text="}"/>
											</outline>
										<outline text="};"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="if (found !== undefined) {">
							<outline text="return (found);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="return (undefined);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function pathsTablesForOdb (theOdb) { //the tables system.paths searches, in Frontier's order">
						<outline text="const tables = [];"/>
						<outline text="const addressTexts = [&quot;system.verbs.globals&quot;, &quot;system.verbs.builtins&quot;, &quot;system.verbs.apps&quot;, &quot;system.verbs.suites&quot;, &quot;suites&quot;];"/>
						<outline text="addressTexts.forEach (function (addressText) {">
							<outline text="var current = theOdb;"/>
							<outline text="addressText.split (&quot;.&quot;).forEach (function (part) {">
								<outline text="if ((current !== undefined) &amp;&amp; (current !== null) &amp;&amp; (typeof current === &quot;object&quot;)) {">
									<outline text="const key = findKey (current, part);"/>
									<outline text="current = (key === undefined) ? undefined : current [key];"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="current = undefined;"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="if ((current !== undefined) &amp;&amp; (current !== null) &amp;&amp; (typeof current === &quot;object&quot;) &amp;&amp; (current.flOdbScript === undefined)) {">
								<outline text="tables.push (current);"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="return (tables);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function referenceForNode (theNode) {">
						<outline text=""/>
						<outline text="switch (theNode.op) {">
							<outline text=""/>
							<outline text="case &quot;id&quot;: {">
								<outline text="const existing = referenceForId (theNode.name);"/>
								<outline text="if (existing !== undefined) {">
									<outline text="return (existing);"/>
									<outline text="}"/>
									</outline>
								<outline text="//an unknown name assigns into the odb root, the way Frontier creates entries"/>
								<outline text="return ({">
									<outline text="get: function () {">
										<outline text="const message = &quot;Can't get the value of &quot; + theNode.name + &quot; because there is no object with that name.&quot;;"/>
										<outline text="throw new Error (message);"/>
										<outline text="},"/>
										</outline>
									<outline text="set: function (theValue) {">
										<outline text="environment.odb [theNode.name] = theValue;"/>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;computedid&quot;: {">
								<outline text="const name = evalExpr (theNode.expr);"/>
								<outline text="return (referenceForNode ({op: &quot;id&quot;, name: String (name)}));"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;dot&quot;: {">
								<outline text="const container = evalExpr (theNode.left);"/>
								<outline text="if ((container === undefined) || (container === null) || (typeof container !== &quot;object&quot;)) {">
									<outline text="const message = &quot;Can't access &quot; + theNode.name + &quot; because the value before the dot isn't a table.&quot;;"/>
									<outline text="throw new Error (message);"/>
									<outline text="}"/>
									</outline>
								<outline text="var key = findKey (container, theNode.name);"/>
								<outline text="if (key === undefined) {">
									<outline text="key = theNode.name;"/>
									<outline text="}"/>
									</outline>
								<outline text="const keyFinal = key;"/>
								<outline text="return ({">
									<outline text="get: function () {">
										<outline text="return (container [keyFinal]);"/>
										<outline text="},"/>
										</outline>
									<outline text="set: function (theValue) {">
										<outline text="container [keyFinal] = theValue;"/>
										<outline text="},"/>
										</outline>
									<outline text="remove: function () {">
										<outline text="delete container [keyFinal];"/>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;index&quot;: {">
								<outline text="const container = evalExpr (theNode.left);"/>
								<outline text="const index = evalExpr (theNode.index);"/>
								<outline text="if (typeof container === &quot;string&quot;) { //7/27/26 by CC -- s [3] is the third character, 1-based">
									<outline text="return ({">
										<outline text="get: function () {">
											<outline text="return (container.charAt (index - 1));"/>
											<outline text="},"/>
											</outline>
										<outline text="set: function (theValue) {">
											<outline text="const message = &quot;Can't assign into a character of a string this way because the string was copied when it was read.&quot;;"/>
											<outline text="throw new Error (message);"/>
											<outline text="}"/>
											</outline>
										<outline text="});"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="if (Array.isArray (container)) {">
									<outline text="return ({">
										<outline text="get: function () {">
											<outline text="return (container [index - 1]); //Frontier lists are 1-based"/>
											<outline text="},"/>
											</outline>
										<outline text="set: function (theValue) {">
											<outline text="container [index - 1] = theValue;"/>
											<outline text="}"/>
											</outline>
										<outline text="});"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="if ((container !== undefined) &amp;&amp; (typeof container === &quot;object&quot;)) {">
									<outline text="if ((typeof index === &quot;number&quot;) &amp;&amp; (theNode.flComputedName !== true)) { //bare subscript: nth entry, in Frontier's sorted order">
										<outline text="const keys = sortedTableKeys (container);"/>
										<outline text="var keyAt = keys [index - 1];"/>
										<outline text="if (keyAt === undefined) {">
											<outline text="keyAt = String (index); //writing the nth entry of a table that doesn't have one yet: the number becomes the name"/>
											<outline text="}"/>
											</outline>
										<outline text="return ({">
											<outline text="get: function () {">
												<outline text="return (container [keyAt]);"/>
												<outline text="},"/>
												</outline>
											<outline text="set: function (theValue) {">
												<outline text="container [keyAt] = theValue;"/>
												<outline text="},"/>
												</outline>
											<outline text="remove: function () {">
												<outline text="delete container [keyAt];"/>
												<outline text="}"/>
												</outline>
											<outline text="});"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="var key = findKey (container, String (index));"/>
									<outline text="if (key === undefined) {">
										<outline text="key = String (index);"/>
										<outline text="}"/>
										</outline>
									<outline text="const keyFinal = key;"/>
									<outline text="return ({">
										<outline text="get: function () {">
											<outline text="return (container [keyFinal]);"/>
											<outline text="},"/>
											</outline>
										<outline text="set: function (theValue) {">
											<outline text="container [keyFinal] = theValue;"/>
											<outline text="},"/>
											</outline>
										<outline text="remove: function () {">
											<outline text="delete container [keyFinal];"/>
											<outline text="}"/>
											</outline>
										<outline text="});"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="const message = &quot;Can't subscript the value because it isn't a list or a table.&quot;;"/>
								<outline text="throw new Error (message);"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;deref&quot;: {">
								<outline text="const address = evalExpr (theNode.expr);"/>
								<outline text="return (referenceForAddress (address));"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="default: {">
								<outline text="const message = &quot;Can't assign into a &quot; + theNode.op + &quot; expression.&quot;;"/>
								<outline text="throw new Error (message);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function referenceForAddress (theAddress) {">
						<outline text="if ((theAddress === undefined) || (theAddress.flAddress !== true)) {">
							<outline text="const message = &quot;Can't dereference the value because it isn't an address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (theAddress.reference);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function lazyAddressForNode (theNode) {">
						<outline text=""/>
						<outline text="/*  7/27/26 by CC -- build a path-shaped address without touching the">
							<outline text="database: a base plus name parts. Computed parts ([expr]) evaluate"/>
							<outline text="now; the walk to the value happens each time the address is used."/>
							<outline text="Returns undefined when the expression isn't a path shape, and the"/>
							<outline text="caller falls back to an eager reference.  */"/>
							</outline>
						<outline text=""/>
						<outline text="const parts = [];"/>
						<outline text="var node = theNode;"/>
						<outline text=""/>
						<outline text="while ((node.op === &quot;dot&quot;) || (node.op === &quot;index&quot;)) {">
							<outline text="if (node.op === &quot;dot&quot;) {">
								<outline text="parts.unshift (node.name);"/>
								<outline text="node = node.left;"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="const indexValue = evalExpr (node.index);"/>
								<outline text="if ((typeof indexValue === &quot;number&quot;) &amp;&amp; (node.flComputedName !== true)) {">
									<outline text="parts.unshift ({flNth: indexValue}); //bare subscript: nth entry, resolved against the sorted table when the walk reaches it"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="parts.unshift (String (indexValue));"/>
									<outline text="}"/>
									</outline>
								<outline text="node = node.left;"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="var resolveBase;"/>
						<outline text="var baseText;"/>
						<outline text="if (node.op === &quot;computedid&quot;) {">
							<outline text="/*  [f].site -- the base name computes now (usually a database's">
								<outline text="full path); the walk from it stays lazy. The path text keeps"/>
								<outline text="the bracket form so it can be parsed back.  */"/>
								</outline>
							<outline text="const computedName = String (evalExpr (node.expr));"/>
							<outline text="baseText = &quot;[&quot; + computedName + &quot;]&quot;;"/>
							<outline text="resolveBase = function () {">
								<outline text="const reference = referenceForId (computedName);"/>
								<outline text="if (reference === undefined) {">
									<outline text="return (undefined);"/>
									<outline text="}"/>
									</outline>
								<outline text="return (reference.get ());"/>
								<outline text="};"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="if (node.op === &quot;id&quot;) {">
								<outline text="/*  The base binds to its CELL now, at address time -- an">
									<outline text="address handed to another script keeps pointing at the"/>
									<outline text="caller's local, the way an objspec does. Only a base that"/>
									<outline text="doesn't exist yet falls back to by-name lookup at use.  */"/>
									</outline>
								<outline text="const baseName = node.name;"/>
								<outline text="baseText = baseName;"/>
								<outline text="const boundReference = referenceForId (baseName);"/>
								<outline text="resolveBase = function (flCreate) {">
									<outline text="var reference = boundReference;"/>
									<outline text="if (reference === undefined) {">
										<outline text="reference = referenceForId (baseName);"/>
										<outline text="}"/>
										</outline>
									<outline text="if (reference === undefined) {">
										<outline text="return (undefined);"/>
										<outline text="}"/>
										</outline>
									<outline text="var value = reference.get ();"/>
									<outline text="if (flCreate &amp;&amp; ((value === undefined) || (value === null) || (typeof value !== &quot;object&quot;))) {">
										<outline text="reference.set ({}); //assignment through the address makes the table on the way"/>
										<outline text="value = reference.get ();"/>
										<outline text="}"/>
										</outline>
									<outline text="return (value);"/>
									<outline text="};"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="if (node.op === &quot;deref&quot;) {">
									<outline text="/*  @adr^.x -- chase the inner address now, walk from its">
										<outline text="target lazily. When the chain is broken (@pta^.newsSite^.y"/>
										<outline text="with no newsSite), the address still gets built -- it"/>
										<outline text="answers undefined on get, and errors on use, not on"/>
										<outline text="construction, the way Frontier objspecs behave.  */"/>
										</outline>
									<outline text="var innerAddress;"/>
									<outline text="try {">
										<outline text="innerAddress = evalExpr (node.expr);"/>
										<outline text="}"/>
										</outline>
									<outline text="catch (err) {">
										<outline text="innerAddress = undefined;"/>
										<outline text="}"/>
										</outline>
									<outline text="baseText = &quot;(deref)&quot;;"/>
									<outline text="if ((innerAddress !== undefined) &amp;&amp; (innerAddress !== null) &amp;&amp; (innerAddress.flAddress === true)) {">
										<outline text="baseText = innerAddress.pathText;"/>
										<outline text="}"/>
										</outline>
									<outline text="resolveBase = function () {">
										<outline text="if ((innerAddress === undefined) || (innerAddress === null) || (innerAddress.flAddress !== true)) {">
											<outline text="return (undefined);"/>
											<outline text="}"/>
											</outline>
										<outline text="return (innerAddress.reference.get ());"/>
										<outline text="};"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="return (undefined);"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="if (parts.length === 0) {">
							<outline text="return (undefined); //@name alone: the eager reference already has the right meaning"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="function keyForPart (theContainer, thePart, flCreate) {">
							<outline text="/*  A part is a name, or {flNth} for a numeric subscript, which">
								<outline text="resolves against the table in Frontier's sorted order.  */"/>
								</outline>
							<outline text="if ((thePart !== null) &amp;&amp; (typeof thePart === &quot;object&quot;) &amp;&amp; (thePart.flNth !== undefined)) {">
								<outline text="const key = sortedTableKeys (theContainer) [thePart.flNth - 1];"/>
								<outline text="if (key === undefined) {">
									<outline text="return (flCreate ? String (thePart.flNth) : undefined);"/>
									<outline text="}"/>
									</outline>
								<outline text="return (key);"/>
								<outline text="}"/>
								</outline>
							<outline text="var key = findKey (theContainer, thePart);"/>
							<outline text="if ((key === undefined) &amp;&amp; flCreate) {">
								<outline text="key = thePart;"/>
								<outline text="}"/>
								</outline>
							<outline text="return (key);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="function partText (thePart) {">
							<outline text="if ((thePart !== null) &amp;&amp; (typeof thePart === &quot;object&quot;) &amp;&amp; (thePart.flNth !== undefined)) {">
								<outline text="return (&quot;[&quot; + thePart.flNth + &quot;]&quot;);"/>
								<outline text="}"/>
								</outline>
							<outline text="return (String (thePart));"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="function walkToParent (flCreate) { //the table holding the last part, or undefined">
							<outline text="var current = resolveBase (flCreate);"/>
							<outline text="var ixPart;"/>
							<outline text="for (ixPart = 0; ixPart &lt; parts.length - 1; ixPart++) {">
								<outline text="if ((current === undefined) || (current === null) || (typeof current !== &quot;object&quot;)) {">
									<outline text="return (undefined);"/>
									<outline text="}"/>
									</outline>
								<outline text="const key = keyForPart (current, parts [ixPart], flCreate);"/>
								<outline text="if (key === undefined) {">
									<outline text="return (undefined);"/>
									<outline text="}"/>
									</outline>
								<outline text="if (current [key] === undefined) {">
									<outline text="if (!flCreate) {">
										<outline text="return (undefined);"/>
										<outline text="}"/>
										</outline>
									<outline text="current [key] = {};"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="if (flCreate &amp;&amp; ((current [key] === null) || (typeof current [key] !== &quot;object&quot;))) {">
										<outline text="current [key] = {};"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="current = current [key];"/>
								<outline text="}"/>
								</outline>
							<outline text="return (current);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="const lastPart = parts [parts.length - 1];"/>
						<outline text=""/>
						<outline text="function lastKeyIn (theParent, flCreate) {">
							<outline text="return (keyForPart (theParent, lastPart, flCreate));"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="const reference = {">
							<outline text="get: function () {">
								<outline text="const parent = walkToParent (false);"/>
								<outline text="if ((parent === undefined) || (parent === null) || (typeof parent !== &quot;object&quot;)) {">
									<outline text="return (undefined);"/>
									<outline text="}"/>
									</outline>
								<outline text="const key = lastKeyIn (parent, false);"/>
								<outline text="if (key === undefined) {">
									<outline text="return (undefined);"/>
									<outline text="}"/>
									</outline>
								<outline text="return (parent [key]);"/>
								<outline text="},"/>
								</outline>
							<outline text="set: function (theValue) {">
								<outline text="const parent = walkToParent (true);"/>
								<outline text="if ((parent === undefined) || (parent === null) || (typeof parent !== &quot;object&quot;)) {">
									<outline text="const message = &quot;Can't set the value at &quot; + pathText + &quot; because the path can't be reached.&quot;;"/>
									<outline text="throw new Error (message);"/>
									<outline text="}"/>
									</outline>
								<outline text="parent [lastKeyIn (parent, true)] = theValue;"/>
								<outline text="},"/>
								</outline>
							<outline text="remove: function () {">
								<outline text="const parent = walkToParent (false);"/>
								<outline text="if ((parent === undefined) || (parent === null) || (typeof parent !== &quot;object&quot;)) {">
									<outline text="return;"/>
									<outline text="}"/>
									</outline>
								<outline text="const key = lastKeyIn (parent, false);"/>
								<outline text="if (key !== undefined) {">
									<outline text="delete parent [key];"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="};"/>
							</outline>
						<outline text=""/>
						<outline text="/*  The path as text: nth parts read their real entry name when the">
							<outline text="table is reachable now, so nameOf answers the name, not a number.  */"/>
							</outline>
						<outline text="const textParts = [];"/>
						<outline text="var probe = resolveBase ();"/>
						<outline text="parts.forEach (function (part) {">
							<outline text="var text = partText (part);"/>
							<outline text="if ((probe !== undefined) &amp;&amp; (probe !== null) &amp;&amp; (typeof probe === &quot;object&quot;)) {">
								<outline text="const key = keyForPart (probe, part, false);"/>
								<outline text="if (key !== undefined) {">
									<outline text="text = key;"/>
									<outline text="probe = probe [key];"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="probe = undefined;"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="probe = undefined;"/>
								<outline text="}"/>
								</outline>
							<outline text="textParts.push (text);"/>
							<outline text="});"/>
							</outline>
						<outline text=""/>
						<outline text="var pathText = baseText + &quot;.&quot; + textParts.join (&quot;.&quot;);"/>
						<outline text=""/>
						<outline text="/*  8/5/26 by CC -- the address remembers its own last component. Splitting">
							<outline text="pathText on dots can't recover it: a computed part resolves to the real"/>
							<outline text="entry name, and Manila's membership tables are named by email address,"/>
							<outline text="so users.[&quot;dave@example.com&quot;] would answer &quot;com&quot;.  */"/>
							</outline>
						<outline text="var nameText = textParts [textParts.length - 1];"/>
						<outline text=""/>
						<outline text="return ({reference, pathText, nameText});"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="//expressions"/>
					<outline text=""/>
					<outline text="function flListsEqual (left, right) {">
						<outline text="/*  7/28/26 by CC -- lists compare by value, not by identity: the">
							<outline text="corpus is full of &quot;if theList == {}&quot; as an emptiness test, and"/>
							<outline text="comparing two JS arrays by reference makes that always false.  */"/>
							</outline>
						<outline text="if (!Array.isArray (left) || !Array.isArray (right)) {">
							<outline text="return (false); //a list is never equal to a non-list"/>
							<outline text="}"/>
							</outline>
						<outline text="if (left.length !== right.length) {">
							<outline text="return (false);"/>
							<outline text="}"/>
							</outline>
						<outline text="var flSame = true;"/>
						<outline text="left.forEach (function (item, ixItem) {">
							<outline text="if (!flSame) {">
								<outline text="return;"/>
								<outline text="}"/>
								</outline>
							<outline text="const other = right [ixItem];"/>
							<outline text="if (Array.isArray (item) || Array.isArray (other)) {">
								<outline text="flSame = flListsEqual (item, other);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="const pair = coerceForCompare (item, other);"/>
								<outline text="if (pair.left != pair.right) {">
									<outline text="flSame = false;"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="return (flSame);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function addressPathText (theValue) { //8/5/26 by CC -- the path an address stands for, or undefined when it isn't one">
						<outline text="if ((theValue !== undefined) &amp;&amp; (theValue !== null) &amp;&amp; (theValue.flAddress === true)) {">
							<outline text="return (String (theValue.pathText));"/>
							<outline text="}"/>
							</outline>
						<outline text="return (undefined);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function coerceForCompare (left, right) {">
						<outline text=""/>
						<outline text="/*  An address compares by the path it names, the way Frontier compares">
							<outline text="objspecs -- two addresses built separately for the same place are"/>
							<outline text="equal. Comparing them as JS objects made every such test false, and"/>
							<outline text="Manila leans on it: getCanonicalSiteName asks whether an entry in"/>
							<outline text="config.manila.sites is this site, and answered no for the site it"/>
							<outline text="was standing in.  */"/>
							</outline>
						<outline text="const leftPath = addressPathText (left);"/>
						<outline text="const rightPath = addressPathText (right);"/>
						<outline text="if ((leftPath !== undefined) || (rightPath !== undefined)) {">
							<outline text="const leftText = (leftPath === undefined) ? String (left) : leftPath;"/>
							<outline text="const rightText = (rightPath === undefined) ? String (right) : rightPath;"/>
							<outline text="return ({left: leftText.toLowerCase (), right: rightText.toLowerCase ()});"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="if ((typeof left === &quot;string&quot;) &amp;&amp; (typeof right === &quot;string&quot;)) { //Frontier string comparison is case-insensitive">
							<outline text="return ({left: left.toLowerCase (), right: right.toLowerCase ()});"/>
							<outline text="}"/>
							</outline>
						<outline text="return ({left, right});"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function evalExpr (theNode) {">
						<outline text=""/>
						<outline text="switch (theNode.op) {">
							<outline text=""/>
							<outline text="case &quot;const&quot;:">
								<outline text="return (theNode.value);"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;list&quot;: {">
								<outline text="const items = [];"/>
								<outline text="theNode.items.forEach (function (item) {">
									<outline text="items.push (evalExpr (item));"/>
									<outline text="});"/>
									</outline>
								<outline text="return (items);"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;id&quot;: {">
								<outline text="const reference = referenceForId (theNode.name);"/>
								<outline text="if (reference === undefined) {">
									<outline text="const verb = environment.verbs [theNode.name.toLowerCase ()];"/>
									<outline text="if (verb !== undefined) {">
										<outline text="return (verb);"/>
										<outline text="}"/>
										</outline>
									<outline text="const message = &quot;Can't get the value of &quot; + theNode.name + &quot; because there is no object with that name.&quot;;"/>
									<outline text="throw new Error (message);"/>
									<outline text="}"/>
									</outline>
								<outline text="return (reference.get ());"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;computedid&quot;:">
								<outline text="return (referenceForNode (theNode).get ());"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;dot&quot;: {">
								<outline text="//try a verb first: file.copy is a verb, not a table walk"/>
								<outline text="const dottedName = dottedNameForNode (theNode);"/>
								<outline text="if (dottedName !== undefined) {">
									<outline text="const verb = environment.verbs [dottedName.toLowerCase ()];"/>
									<outline text="if (verb !== undefined) {">
										<outline text="return (verb);"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="return (referenceForNode (theNode).get ());"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;index&quot;:">
								<outline text="return (referenceForNode (theNode).get ());"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;address&quot;: {">
								<outline text="/*  7/27/26 by CC -- an address is symbolic, the way Frontier">
									<outline text="treats it: taking @config.x.y never touches the database,"/>
									<outline text="and the path resolves each time the address is used. So"/>
									<outline text="@a.b.c is legal when b doesn't exist yet, defined (adr^)"/>
									<outline text="answers false, and assigning through the address creates"/>
									<outline text="the missing parent tables.  */"/>
									</outline>
								<outline text="const lazy = lazyAddressForNode (theNode.expr);"/>
								<outline text="if (lazy !== undefined) {">
									<outline text="return ({flAddress: true, reference: lazy.reference, pathText: lazy.pathText, nameText: lazy.nameText});"/>
									<outline text="}"/>
									</outline>
								<outline text="const reference = referenceForNode (theNode.expr);"/>
								<outline text="return ({flAddress: true, reference, pathText: pathTextForNode (theNode.expr)});"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;deref&quot;:">
								<outline text="return (referenceForAddress (evalExpr (theNode.expr)).get ());"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;call&quot;:">
								<outline text="return (evalCall (theNode));"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;not&quot;:">
								<outline text="return (!flTrue (evalExpr (theNode.expr)));"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;negate&quot;:">
								<outline text="return (-evalExpr (theNode.expr));"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;preincrement&quot;: case &quot;postincrement&quot;: {">
								<outline text="const reference = referenceForNode (theNode.expr);"/>
								<outline text="const oldValue = reference.get ();"/>
								<outline text="reference.set (oldValue + 1);"/>
								<outline text="return (theNode.op === &quot;preincrement&quot; ? oldValue + 1 : oldValue);"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;predecrement&quot;: case &quot;postdecrement&quot;: {">
								<outline text="const reference = referenceForNode (theNode.expr);"/>
								<outline text="const oldValue = reference.get ();"/>
								<outline text="reference.set (oldValue - 1);"/>
								<outline text="return (theNode.op === &quot;predecrement&quot; ? oldValue - 1 : oldValue);"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;and&quot;:">
								<outline text="return (flTrue (evalExpr (theNode.left)) &amp;&amp; flTrue (evalExpr (theNode.right)));"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;or&quot;:">
								<outline text="return (flTrue (evalExpr (theNode.left)) || flTrue (evalExpr (theNode.right)));"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;add&quot;: {">
								<outline text="/*  7/28/26 by CC -- an unset value adds as nothing: Frontier">
									<outline text="locals start empty, so s = s + &quot;text&quot; builds the string"/>
									<outline text="from the first line, and n = n + 1 counts from zero.  */"/>
									</outline>
								<outline text="var left = evalExpr (theNode.left), right = evalExpr (theNode.right);"/>
								<outline text="if (Array.isArray (left)) { //adding to a list appends: {1, 2} + 3 is {1, 2, 3}, and a list adds its items">
									<outline text="return (left.concat (Array.isArray (right) ? right : [right]));"/>
									<outline text="}"/>
									</outline>
								<outline text="if (Array.isArray (right)) {">
									<outline text="return ([left].concat (right));"/>
									<outline text="}"/>
									</outline>
								<outline text="if ((left instanceof Date) &amp;&amp; (typeof right === &quot;number&quot;)) { //date arithmetic is in seconds">
									<outline text="return (new Date (left.getTime () + (right * 1000)));"/>
									<outline text="}"/>
									</outline>
								<outline text="if ((typeof left === &quot;number&quot;) &amp;&amp; (right instanceof Date)) {">
									<outline text="return (new Date (right.getTime () + (left * 1000)));"/>
									<outline text="}"/>
									</outline>
								<outline text="if ((left === undefined) || (right === undefined)) {">
									<outline text="const present = (left === undefined) ? right : left;"/>
									<outline text="if (typeof present === &quot;string&quot;) {">
										<outline text="left = (left === undefined) ? &quot;&quot; : left;"/>
										<outline text="right = (right === undefined) ? &quot;&quot; : right;"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="if (typeof present === &quot;number&quot;) {">
											<outline text="left = (left === undefined) ? 0 : left;"/>
											<outline text="right = (right === undefined) ? 0 : right;"/>
											<outline text="}"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="return (left + right);"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;subtract&quot;: {">
								<outline text="const left = evalExpr (theNode.left), right = evalExpr (theNode.right);"/>
								<outline text="if (left instanceof Date) { //date arithmetic is in seconds: date - date answers seconds, date - seconds shifts">
									<outline text="if (right instanceof Date) {">
										<outline text="return ((left.getTime () - right.getTime ()) / 1000);"/>
										<outline text="}"/>
										</outline>
									<outline text="if (typeof right === &quot;number&quot;) {">
										<outline text="return (new Date (left.getTime () - (right * 1000)));"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="if ((typeof left === &quot;string&quot;) || (typeof right === &quot;string&quot;)) { //Frontier: &quot;abc:&quot; - &quot;:&quot; strips the suffix">
									<outline text="const leftString = String (left), rightString = String (right);"/>
									<outline text="if (leftString.endsWith (rightString)) {">
										<outline text="return (leftString.slice (0, leftString.length - rightString.length));"/>
										<outline text="}"/>
										</outline>
									<outline text="return (leftString);"/>
									<outline text="}"/>
									</outline>
								<outline text="return (left - right);"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;multiply&quot;:">
								<outline text="return (evalExpr (theNode.left) * evalExpr (theNode.right));"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;divide&quot;:">
								<outline text="return (evalExpr (theNode.left) / evalExpr (theNode.right));"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;mod&quot;:">
								<outline text="return (evalExpr (theNode.left) % evalExpr (theNode.right));"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;eq&quot;: {">
								<outline text="const leftValue = evalExpr (theNode.left), rightValue = evalExpr (theNode.right);"/>
								<outline text="if (Array.isArray (leftValue) || Array.isArray (rightValue)) {">
									<outline text="return (flListsEqual (leftValue, rightValue));"/>
									<outline text="}"/>
									</outline>
								<outline text="const pair = coerceForCompare (leftValue, rightValue);"/>
								<outline text="return (pair.left == pair.right); //loose on purpose: Frontier coerces across types"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;ne&quot;: {">
								<outline text="const leftValue = evalExpr (theNode.left), rightValue = evalExpr (theNode.right);"/>
								<outline text="if (Array.isArray (leftValue) || Array.isArray (rightValue)) {">
									<outline text="return (!flListsEqual (leftValue, rightValue));"/>
									<outline text="}"/>
									</outline>
								<outline text="const pair = coerceForCompare (leftValue, rightValue);"/>
								<outline text="return (pair.left != pair.right);"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;lt&quot;: {">
								<outline text="const pair = coerceForCompare (evalExpr (theNode.left), evalExpr (theNode.right));"/>
								<outline text="return (pair.left &lt; pair.right);"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;gt&quot;: {">
								<outline text="const pair = coerceForCompare (evalExpr (theNode.left), evalExpr (theNode.right));"/>
								<outline text="return (pair.left &gt; pair.right);"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;le&quot;: {">
								<outline text="const pair = coerceForCompare (evalExpr (theNode.left), evalExpr (theNode.right));"/>
								<outline text="return (pair.left &lt;= pair.right);"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;ge&quot;: {">
								<outline text="const pair = coerceForCompare (evalExpr (theNode.left), evalExpr (theNode.right));"/>
								<outline text="return (pair.left &gt;= pair.right);"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;beginswith&quot;: {">
								<outline text="const pair = coerceForCompare (String (evalExpr (theNode.left)), String (evalExpr (theNode.right)));"/>
								<outline text="return (pair.left.startsWith (pair.right));"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;endswith&quot;: {">
								<outline text="const pair = coerceForCompare (String (evalExpr (theNode.left)), String (evalExpr (theNode.right)));"/>
								<outline text="return (pair.left.endsWith (pair.right));"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;contains&quot;: {">
								<outline text="const pair = coerceForCompare (String (evalExpr (theNode.left)), String (evalExpr (theNode.right)));"/>
								<outline text="return (pair.left.indexOf (pair.right) !== -1);"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;namedarg&quot;:">
								<outline text="return (evalExpr (theNode.value));"/>
								</outline>
							<outline text=""/>
							<outline text="default: {">
								<outline text="const message = &quot;Can't evaluate the expression because the operator &quot; + theNode.op + &quot; isn't implemented.&quot;;"/>
								<outline text="throw new Error (message);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function flTrue (theValue) {">
						<outline text="return ((theValue !== false) &amp;&amp; (theValue !== undefined) &amp;&amp; (theValue !== 0) &amp;&amp; (theValue !== &quot;&quot;));"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function dottedNameForNode (theNode) { //x.y.z as a string, or undefined if it isn't a plain path">
						<outline text="if (theNode.op === &quot;id&quot;) {">
							<outline text="return (theNode.name);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (theNode.op === &quot;dot&quot;) {">
							<outline text="const left = dottedNameForNode (theNode.left);"/>
							<outline text="if (left === undefined) {">
								<outline text="return (undefined);"/>
								<outline text="}"/>
								</outline>
							<outline text="return (left + &quot;.&quot; + theNode.name);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (undefined);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function pathTextForNode (theNode) {">
						<outline text="const dotted = dottedNameForNode (theNode);"/>
						<outline text="if (dotted !== undefined) {">
							<outline text="return (dotted);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (&quot;(computed)&quot;);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function evalCall (theNode) {">
						<outline text=""/>
						<outline text="/*  7/27/26 by CC -- defined is a special form, the way the kernel">
							<outline text="treats it: if walking to the value fails because a parent table"/>
							<outline text="isn't there, the answer is false, not an error.  */"/>
							</outline>
						<outline text=""/>
						<outline text="if ((theNode.fn.op === &quot;id&quot;) &amp;&amp; (theNode.fn.name.toLowerCase () === &quot;defined&quot;) &amp;&amp; (theNode.args.length === 1)) {">
							<outline text="var definedValue;"/>
							<outline text="try {">
								<outline text="definedValue = evalExpr (theNode.args [0]);"/>
								<outline text="}"/>
								</outline>
							<outline text="catch (err) {">
								<outline text="return (false);"/>
								<outline text="}"/>
								</outline>
							<outline text="return (definedValue !== undefined);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="/*  8/4/26 by CC -- evaluate is a special form: the kernel compiles the">
							<outline text="string and runs it in the current scope, so the caller's locals are"/>
							<outline text="visible to the evaluated code. The build script at the end of"/>
							<outline text="uploadScripts is the customer. An empty or missing script answers"/>
							<outline text="nil, the way a project with no build script expects.  */"/>
							</outline>
						<outline text=""/>
						<outline text="if ((theNode.fn.op === &quot;id&quot;) &amp;&amp; (theNode.fn.name.toLowerCase () === &quot;evaluate&quot;) &amp;&amp; (theNode.args.length === 1)) {">
							<outline text="const scriptValue = evalExpr (theNode.args [0]);"/>
							<outline text="if ((scriptValue === undefined) || (scriptValue === null)) {">
								<outline text="return (undefined);"/>
								<outline text="}"/>
								</outline>
							<outline text="var scriptText;"/>
							<outline text="if (scriptValue.flOdbScript === true) {">
								<outline text="scriptText = environment.verbs [&quot;string&quot;] ([scriptValue]);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="if ((typeof scriptValue === &quot;object&quot;) &amp;&amp; (scriptValue.flWpText !== true)) {">
									<outline text="const message = &quot;Can't evaluate the script because the value is a &quot; + environment.verbs [&quot;typeof&quot;] ([scriptValue]) + &quot;, not text.&quot;;"/>
									<outline text="throw new Error (message); //without this the object stringifies to &quot;[object Object]&quot; and the parser's complaint names neither the value nor the caller"/>
									<outline text="}"/>
									</outline>
								<outline text="scriptText = String (scriptValue);"/>
								<outline text="}"/>
								</outline>
							<outline text="if (scriptText.trim ().length === 0) {">
								<outline text="return (undefined);"/>
								<outline text="}"/>
								</outline>
							<outline text="if (environment.parseScript === undefined) {">
								<outline text="const message = &quot;Can't evaluate the script because this environment has no script parser.&quot;;"/>
								<outline text="throw new Error (message);"/>
								<outline text="}"/>
								</outline>
							<outline text="const theLines = [];"/>
							<outline text="scriptText.split (/\r\n|\r|\n/).forEach (function (line) { //a stored script stringifies with returns, a rendered one with linefeeds">
								<outline text="const withoutTabs = line.replace (/^\t+/, &quot;&quot;);"/>
								<outline text="if (withoutTabs.trim ().length &gt; 0) {">
									<outline text="theLines.push ({level: line.length - withoutTabs.length, text: withoutTabs, flComment: false});"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="const theStatements = environment.parseScript (theLines);"/>
							<outline text="environment.trace.push ({verb: &quot;evaluate&quot;, args: [scriptText.slice (0, 80)]});"/>
							<outline text="return (evaluate (theStatements, environment));"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="/*  7/27/26 by CC -- nameOf is a path question, not a value question:">
							<outline text="nameOf (adr^) answers the name of the cell the address points to,"/>
							<outline text="nameOf (config.manila) answers &quot;manila&quot;.  */"/>
							</outline>
						<outline text=""/>
						<outline text="if ((theNode.fn.op === &quot;id&quot;) &amp;&amp; (theNode.fn.name.toLowerCase () === &quot;parentof&quot;) &amp;&amp; (theNode.args.length === 1)) {">
							<outline text="/*  parentOf (adr^) answers the address of the table holding the">
								<outline text="cell -- a path question, answered by trimming the path. Given"/>
								<outline text="a bare value, the kernel knew its cell; here an identity"/>
								<outline text="index over the odb answers instead.  */"/>
								</outline>
							<outline text="const argNode = theNode.args [0];"/>
							<outline text="var addressForParent;"/>
							<outline text="var argValue;"/>
							<outline text="if (argNode.op === &quot;deref&quot;) {">
								<outline text="addressForParent = evalExpr (argNode.expr);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="if (argNode.op === &quot;id&quot;) {">
									<outline text="/*  parentOf (host) -- the classic way to reach the table a">
										<outline text="cell lives in, usually the param table via with-scope."/>
										<outline text="The resolved reference knows its container.  */"/>
										</outline>
									<outline text="const idReference = referenceForId (argNode.name);"/>
									<outline text="if ((idReference !== undefined) &amp;&amp; (idReference.container !== undefined) &amp;&amp; (idReference.container !== environment.odb)) {">
										<outline text="const homeTable = idReference.container;"/>
										<outline text="var flFrameVars = false;"/>
										<outline text="environment.frames.forEach (function (frame) {">
											<outline text="if (frame.vars === homeTable) {">
												<outline text="flFrameVars = true;"/>
												<outline text="}"/>
												</outline>
											<outline text="});"/>
											</outline>
										<outline text="if (!flFrameVars) { //locals have no odb parent; a with-scoped cell does">
											<outline text="const homeFound = findValueHome (homeTable);"/>
											<outline text="return ({">
												<outline text="flAddress: true,"/>
												<outline text="pathText: (homeFound === undefined) ? &quot;(parent)&quot; : homeFound.ownPath,"/>
												<outline text="reference: {">
													<outline text="get: function () {">
														<outline text="return (homeTable);"/>
														<outline text="},"/>
														</outline>
													<outline text="set: function (theValue) {">
														<outline text="const message = &quot;Can't assign through a parent found by scope.&quot;;"/>
														<outline text="throw new Error (message);"/>
														<outline text="},"/>
														</outline>
													<outline text="remove: function () {">
														<outline text="}"/>
														</outline>
													<outline text="}"/>
													</outline>
												<outline text="});"/>
												</outline>
											<outline text="}"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="argValue = evalExpr (argNode);"/>
								<outline text="if ((argValue !== undefined) &amp;&amp; (argValue !== null) &amp;&amp; (argValue.flAddress === true)) {">
									<outline text="addressForParent = argValue;"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="if ((addressForParent === undefined) &amp;&amp; (argValue !== null) &amp;&amp; (typeof argValue === &quot;object&quot;)) {">
								<outline text="const found = findValueHome (argValue);"/>
								<outline text="if (found !== undefined) {">
									<outline text="const homeContainer = found.container;"/>
									<outline text="return ({">
										<outline text="flAddress: true,"/>
										<outline text="pathText: found.containerPath,"/>
										<outline text="reference: {">
											<outline text="get: function () {">
												<outline text="return (homeContainer);"/>
												<outline text="},"/>
												</outline>
											<outline text="set: function (theValue) {">
												<outline text="const message = &quot;Can't assign through a parent found by value.&quot;;"/>
												<outline text="throw new Error (message);"/>
												<outline text="},"/>
												</outline>
											<outline text="remove: function () {">
												<outline text="}"/>
												</outline>
											<outline text="}"/>
											</outline>
										<outline text="});"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="if ((addressForParent !== undefined) &amp;&amp; (addressForParent.flAddress === true)) {">
								<outline text=""/>
								<outline text="/*  Identity is the careful answer -- the value the address leads">
									<outline text="to knows its home table, and that never trips over names with"/>
									<outline text="dots in them, the way trimming path text would. But it costs"/>
									<outline text="a full walk of the database, so it is the SECOND choice:"/>
									<outline text="8/4/26 by CC, when the address carries a real path, the"/>
									<outline text="trimming below is exact and free, and only a path we can't"/>
									<outline text="read (a bare deref, a parent found by scope) falls through to"/>
									<outline text="the walk.  */"/>
									</outline>
								<outline text=""/>
								<outline text="const thePathForParent = addressForParent.pathText;"/>
								<outline text="const flRealPath = (typeof thePathForParent === &quot;string&quot;) &amp;&amp; (thePathForParent.length &gt; 0) &amp;&amp; (thePathForParent.indexOf (&quot;(&quot;) !== 0);"/>
								<outline text=""/>
								<outline text="const targetValue = (flRealPath) ? undefined : addressForParent.reference.get ();"/>
								<outline text="if ((targetValue !== undefined) &amp;&amp; (targetValue !== null) &amp;&amp; (typeof targetValue === &quot;object&quot;)) {">
									<outline text="const targetFound = findValueHome (targetValue);"/>
									<outline text="if (targetFound !== undefined) {">
										<outline text="const targetContainer = targetFound.container;"/>
										<outline text="return ({">
											<outline text="flAddress: true,"/>
											<outline text="pathText: targetFound.containerPath,"/>
											<outline text="reference: {">
												<outline text="get: function () {">
													<outline text="return (targetContainer);"/>
													<outline text="},"/>
													</outline>
												<outline text="set: function (theValue) {">
													<outline text="const message = &quot;Can't assign through a parent found by value.&quot;;"/>
													<outline text="throw new Error (message);"/>
													<outline text="},"/>
													</outline>
												<outline text="remove: function () {">
													<outline text="}"/>
													</outline>
												<outline text="}"/>
												</outline>
											<outline text="});"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="/*  Fall back to trimming the last path component -- a database">
									<outline text="name in brackets can hold dots, so only a dot outside"/>
									<outline text="brackets separates components.  */"/>
									</outline>
								<outline text="const fullText = addressForParent.pathText;"/>
								<outline text="var ixLastDot = -1;"/>
								<outline text="var depth = 0;"/>
								<outline text="var ixScan;"/>
								<outline text="for (ixScan = 0; ixScan &lt; fullText.length; ixScan++) {">
									<outline text="const ch = fullText.charAt (ixScan);"/>
									<outline text="if (ch === &quot;[&quot;) {">
										<outline text="depth++;"/>
										<outline text="}"/>
										</outline>
									<outline text="if (ch === &quot;]&quot;) {">
										<outline text="depth--;"/>
										<outline text="}"/>
										</outline>
									<outline text="if ((ch === &quot;.&quot;) &amp;&amp; (depth === 0)) {">
										<outline text="ixLastDot = ixScan;"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="const parentText = (ixLastDot === -1) ? &quot;&quot; : fullText.slice (0, ixLastDot);"/>
								<outline text="const parseAddressVerb = environment.verbs [&quot;string.parseaddress&quot;];"/>
								<outline text="if ((parentText.length &gt; 0) &amp;&amp; (parentText.indexOf (&quot;(&quot;) !== 0) &amp;&amp; (parseAddressVerb !== undefined)) {">
									<outline text="return (parseAddressVerb ([parentText], environment));"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="return (undefined); //no parent to be had: the top of the database answers nil, so pop-to-root loops terminate"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="if ((theNode.fn.op === &quot;id&quot;) &amp;&amp; (theNode.fn.name.toLowerCase () === &quot;nameof&quot;) &amp;&amp; (theNode.args.length === 1)) {">
							<outline text="const argNode = theNode.args [0];"/>
							<outline text=""/>
							<outline text="function lastPathComponent (thePathText) { //the part after the last dot outside brackets">
								<outline text="var ixLastDot = -1;"/>
								<outline text="var depth = 0;"/>
								<outline text="var ixScan;"/>
								<outline text="for (ixScan = 0; ixScan &lt; thePathText.length; ixScan++) {">
									<outline text="const ch = thePathText.charAt (ixScan);"/>
									<outline text="if (ch === &quot;[&quot;) {">
										<outline text="depth++;"/>
										<outline text="}"/>
										</outline>
									<outline text="if (ch === &quot;]&quot;) {">
										<outline text="depth--;"/>
										<outline text="}"/>
										</outline>
									<outline text="if ((ch === &quot;.&quot;) &amp;&amp; (depth === 0)) {">
										<outline text="ixLastDot = ixScan;"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="return (thePathText.slice (ixLastDot + 1));"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="var addressForName;"/>
							<outline text="if (argNode.op === &quot;deref&quot;) {">
								<outline text="addressForName = evalExpr (argNode.expr);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="if ((argNode.op === &quot;dot&quot;) || (argNode.op === &quot;index&quot;)) {">
									<outline text="/*  nameOf (table [i]) and nameOf (a.b.c) are path questions:">
										<outline text="the lazy address resolves the real entry name, nth"/>
										<outline text="subscripts included.  */"/>
										</outline>
									<outline text="const lazy = lazyAddressForNode (argNode);"/>
									<outline text="if (lazy !== undefined) {">
										<outline text="if (lazy.nameText !== undefined) { //8/5/26 by CC -- the address knows its own name; the path text can't be split back apart when a name contains dots">
											<outline text="return (lazy.nameText);"/>
											<outline text="}"/>
											</outline>
										<outline text="return (lastPathComponent (lazy.pathText));"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="const argValue = evalExpr (argNode);"/>
								<outline text="if ((argValue !== undefined) &amp;&amp; (argValue !== null) &amp;&amp; (argValue.flAddress === true)) {">
									<outline text="addressForName = argValue;"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="if (argNode.op === &quot;dot&quot;) {">
										<outline text="return (argNode.name);"/>
										<outline text="}"/>
										</outline>
									<outline text="if (argNode.op === &quot;id&quot;) {">
										<outline text="return (argNode.name);"/>
										<outline text="}"/>
										</outline>
									<outline text="return (String (argValue));"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="if ((addressForName !== undefined) &amp;&amp; (addressForName.flAddress === true)) {">
								<outline text="if (addressForName.nameText !== undefined) { //8/5/26 by CC">
									<outline text="return (addressForName.nameText);"/>
									<outline text="}"/>
									</outline>
								<outline text="return (lastPathComponent (addressForName.pathText));"/>
								<outline text="}"/>
								</outline>
							<outline text="return (String (addressForName));"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="/*  7/27/26 by CC -- the kernel thunk: a builtin's script body is">
							<outline text="&quot;on xxx (params)&quot; over the single line &quot;kernel (path.to.verb)&quot;."/>
							<outline text="Dispatch to the JS verb table with the enclosing handler's"/>
							<outline text="arguments; a missing kernel verb fails loudly by name, so every"/>
							<outline text="gap in the verb library announces itself.  */"/>
							</outline>
						<outline text=""/>
						<outline text="if ((theNode.fn.op === &quot;id&quot;) &amp;&amp; (theNode.fn.name.toLowerCase () === &quot;kernel&quot;) &amp;&amp; (theNode.args.length === 1)) {">
							<outline text="const kernelName = dottedNameForNode (theNode.args [0]);"/>
							<outline text="if (kernelName !== undefined) {">
								<outline text="const kernelVerb = environment.verbs [kernelName.toLowerCase ()];"/>
								<outline text="const kernelArgs = (currentFrame ().callArgs === undefined) ? [] : currentFrame ().callArgs;"/>
								<outline text="if (kernelVerb === undefined) {">
									<outline text="/*  Screen verbs are no-ops here -- there is no screen. An">
										<outline text="is-question answers false, everything else claims"/>
										<outline text="success. Every other missing kernel verb still fails"/>
										<outline text="loudly by name.  */"/>
										</outline>
									<outline text="const screenPrefixes = [&quot;menu.&quot;, &quot;window.&quot;, &quot;speaker.&quot;, &quot;mouse.&quot;, &quot;kb.&quot;, &quot;clipboard.&quot;];"/>
									<outline text="var flScreenVerb = false;"/>
									<outline text="screenPrefixes.forEach (function (prefix) {">
										<outline text="if (kernelName.toLowerCase ().indexOf (prefix) === 0) {">
											<outline text="flScreenVerb = true;"/>
											<outline text="}"/>
											</outline>
										<outline text="});"/>
										</outline>
									<outline text="if (flScreenVerb) {">
										<outline text="const shortName = kernelName.toLowerCase ().split (&quot;.&quot;).pop ();"/>
										<outline text="environment.trace.push ({verb: kernelName, args: kernelArgs, flKernel: true, flScreenNoOp: true});"/>
										<outline text="return (shortName.indexOf (&quot;is&quot;) !== 0);"/>
										<outline text="}"/>
										</outline>
									<outline text="const message = &quot;Can't call the kernel verb &quot; + kernelName + &quot; because it isn't implemented in the verb library.&quot;;"/>
									<outline text="throw new Error (message);"/>
									<outline text="}"/>
									</outline>
								<outline text="environment.trace.push ({verb: kernelName, args: kernelArgs, flKernel: true});"/>
								<outline text="return (kernelVerb (kernelArgs, environment));"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="const args = [];"/>
						<outline text="const argNames = []; //7/27/26 by CC -- flEmptyBodyOk:true binds by name, not position"/>
						<outline text="theNode.args.forEach (function (argNode) {">
							<outline text="args.push (evalExpr (argNode));"/>
							<outline text="argNames.push ((argNode.op === &quot;namedarg&quot;) ? argNode.name : undefined);"/>
							<outline text="});"/>
							</outline>
						<outline text=""/>
						<outline text="//a handler defined in scope?"/>
						<outline text=""/>
						<outline text="const dottedName = dottedNameForNode (theNode.fn);"/>
						<outline text=""/>
						<outline text="if (theNode.fn.op === &quot;id&quot;) {">
							<outline text="const reference = referenceForId (theNode.fn.name);"/>
							<outline text="if (reference !== undefined) {">
								<outline text="const value = reference.get ();"/>
								<outline text="if ((value !== undefined) &amp;&amp; (value.flHandler === true)) {">
									<outline text="return (callHandler (value, args, argNames));"/>
									<outline text="}"/>
									</outline>
								<outline text="if ((value !== undefined) &amp;&amp; (value !== null) &amp;&amp; (value.flOdbScript === true)) { //a macro table in scope holds the script">
									<outline text="environment.trace.push ({verb: theNode.fn.name, args, flOdbScript: true});"/>
									<outline text="return (callOdbScript (value, args, theNode.fn.name, argNames));"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="if (dottedName !== undefined) {">
							<outline text="const verb = environment.verbs [dottedName.toLowerCase ()];"/>
							<outline text="if (verb !== undefined) {">
								<outline text="environment.trace.push ({verb: dottedName, args});"/>
								<outline text="return (verb (args, environment));"/>
								<outline text="}"/>
								</outline>
							<outline text="//a dotted path may name a handler, or a script stored in the odb tree"/>
							<outline text="try {">
								<outline text="const value = referenceForNode (theNode.fn).get ();"/>
								<outline text="if ((value !== undefined) &amp;&amp; (value.flHandler === true)) {">
									<outline text="return (callHandler (value, args, argNames));"/>
									<outline text="}"/>
									</outline>
								<outline text="if ((value !== undefined) &amp;&amp; (value.flOdbScript === true)) {">
									<outline text="environment.trace.push ({verb: dottedName, args, flOdbScript: true});"/>
									<outline text="return (callOdbScript (value, args, dottedName, argNames));"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="catch (err) {">
								<outline text="if (err.flRethrow === true) {">
									<outline text="throw err;"/>
									<outline text="}"/>
									</outline>
								<outline text="//fall through to the unknown-verb error below"/>
								<outline text="}"/>
								</outline>
							<outline text="if (environment.resolveExternalScript !== undefined) { //a sibling build script called by name">
								<outline text="const external = environment.resolveExternalScript (dottedName);"/>
								<outline text="if (external !== undefined) {">
									<outline text="environment.trace.push ({verb: dottedName, args, flExternalScript: true});"/>
									<outline text="return (callOdbScript (external, args, dottedName, argNames));"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="const message = &quot;Can't call &quot; + dottedName + &quot; because it isn't a verb, a handler or a script.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="//calling through a computed value"/>
						<outline text="const fn = evalExpr (theNode.fn);"/>
						<outline text="if ((fn !== undefined) &amp;&amp; (fn.flHandler === true)) {">
							<outline text="return (callHandler (fn, args, argNames));"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((fn !== undefined) &amp;&amp; (fn !== null) &amp;&amp; (fn.flOdbScript === true)) { //a script reached through an address or table walk">
							<outline text="environment.trace.push ({verb: pathTextForNode (theNode.fn), args, flOdbScript: true});"/>
							<outline text="return (callOdbScript (fn, args, pathTextForNode (theNode.fn), argNames));"/>
							<outline text="}"/>
							</outline>
						<outline text="if (typeof fn === &quot;function&quot;) {">
							<outline text="environment.trace.push ({verb: pathTextForNode (theNode.fn), args});"/>
							<outline text="return (fn (args, environment));"/>
							<outline text="}"/>
							</outline>
						<outline text="const message = &quot;Can't call &quot; + pathTextForNode (theNode.fn) + &quot; because it isn't a verb, a handler or a script.&quot;;"/>
						<outline text="throw new Error (message);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function callHandler (theHandler, theArgs, theArgNames) {">
						<outline text=""/>
						<outline text="const frame = {vars: {}, callArgs: theArgs}; //callArgs feed a kernel (x.y) thunk in the body"/>
						<outline text=""/>
						<outline text="const savedFrames = environment.frames;"/>
						<outline text="environment.frames = theHandler.closureFrames.concat ([frame]);"/>
						<outline text=""/>
						<outline text="/*  7/27/26 by CC -- split the arguments: named ones bind to the">
							<outline text="param with that name, the rest bind in order.  */"/>
							</outline>
						<outline text="const positional = [];"/>
						<outline text="const byName = {};"/>
						<outline text="theArgs.forEach (function (value, ixArg) {">
							<outline text="const argName = (theArgNames === undefined) ? undefined : theArgNames [ixArg];"/>
							<outline text="if (argName === undefined) {">
								<outline text="positional.push (value);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="byName [argName.toLowerCase ()] = value;"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text=""/>
						<outline text="var ixPositional = 0;"/>
						<outline text="theHandler.params.forEach (function (param) {">
							<outline text="var value;"/>
							<outline text="if (byName [param.name.toLowerCase ()] !== undefined) {">
								<outline text="value = byName [param.name.toLowerCase ()];"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="if (ixPositional &lt; positional.length) {">
									<outline text="value = positional [ixPositional];"/>
									<outline text="ixPositional++;"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="if (value === undefined) {">
								<outline text="if (param.value !== undefined) {">
									<outline text="value = evalExpr (param.value); //defaults see the params already bound: on copyone (a, b=a)"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="frame.vars [param.name] = value;"/>
							<outline text="});"/>
							</outline>
						<outline text=""/>
						<outline text="try {">
							<outline text="const result = evaluate (theHandler.body, environment);"/>
							<outline text="return (result);"/>
							<outline text="}"/>
							</outline>
						<outline text="catch (signal) {">
							<outline text="if (signal.flReturnSignal) {">
								<outline text="return (signal.value);"/>
								<outline text="}"/>
								</outline>
							<outline text="throw signal;"/>
							<outline text="}"/>
							</outline>
						<outline text="finally {">
							<outline text="environment.frames = savedFrames;"/>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function callOdbScript (theScript, theArgs, theName, theArgNames) {">
						<outline text=""/>
						<outline text="/*  A script value from the odb, called like a verb: parse it once,">
							<outline text="evaluate its module (skipping test-code bundles), then call the"/>
							<outline text="handler named for it -- Frontier's script-call semantics.  */"/>
							</outline>
						<outline text=""/>
						<outline text="if (theScript.parsedStatements === undefined) {">
							<outline text="if (environment.parseScript === undefined) {">
								<outline text="const message = &quot;Can't call &quot; + theName + &quot; because no script parser is installed.&quot;;"/>
								<outline text="throw new Error (message);"/>
								<outline text="}"/>
								</outline>
							<outline text="try {">
								<outline text="theScript.parsedStatements = environment.parseScript (theScript.lines);"/>
								<outline text="}"/>
								</outline>
							<outline text="catch (err) {">
								<outline text="const message = &quot;Can't call &quot; + theName + &quot; because its script doesn't parse: &quot; + err.message;"/>
								<outline text="const parseError = new Error (message);"/>
								<outline text="parseError.flRethrow = true; //7/27/26 by CC -- a parse failure must surface, not read as verb-not-found"/>
								<outline text="throw parseError;"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="const moduleFrame = {vars: {}};"/>
						<outline text="const savedFrames = environment.frames;"/>
						<outline text="environment.frames = [moduleFrame];"/>
						<outline text=""/>
						<outline text="try {">
							<outline text="/*  7/27/26 by CC -- only TRAILING bundles are the test-code">
								<outline text="convention; a bundle in the body of the script is working"/>
								<outline text="code and runs. manilaSuite.init is built entirely of them.  */"/>
								</outline>
							<outline text="var ixLastReal = -1;"/>
							<outline text="theScript.parsedStatements.forEach (function (statement, ixStatement) {">
								<outline text="if (statement.op !== &quot;bundle&quot;) {">
									<outline text="ixLastReal = ixStatement;"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="const statements = [];"/>
							<outline text="theScript.parsedStatements.forEach (function (statement, ixStatement) {">
								<outline text="if (ixStatement &lt;= ixLastReal) {">
									<outline text="statements.push (statement);"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="const moduleValue = evaluate (statements, environment);"/>
							<outline text=""/>
							<outline text="const parts = theName.split (&quot;.&quot;);"/>
							<outline text="const shortName = parts [parts.length - 1];"/>
							<outline text="var handlerKey = findKey (moduleFrame.vars, shortName);"/>
							<outline text=""/>
							<outline text="if (handlerKey === undefined) {">
								<outline text="const handlerNames = [];"/>
								<outline text="Object.keys (moduleFrame.vars).forEach (function (key) {">
									<outline text="const value = moduleFrame.vars [key];"/>
									<outline text="if ((value !== undefined) &amp;&amp; (value.flHandler === true)) {">
										<outline text="handlerNames.push (key);"/>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="if (handlerNames.length === 1) {">
									<outline text="handlerKey = handlerNames [0];"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="if (handlerNames.length === 0) { //a straight-code script: the module run was the call">
										<outline text="return (moduleValue);"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="if (handlerKey === undefined) {">
								<outline text="const message = &quot;Can't call &quot; + theName + &quot; because its script doesn't define a handler by that name.&quot;;"/>
								<outline text="throw new Error (message);"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="return (callHandler (moduleFrame.vars [handlerKey], theArgs, theArgNames));"/>
							<outline text="}"/>
							</outline>
						<outline text="catch (err) {">
							<outline text="if (err.flReturnSignal) { //a straight-code script returning at the top level">
								<outline text="return (err.value);"/>
								<outline text="}"/>
								</outline>
							<outline text="err.flRethrow = true;"/>
							<outline text="throw err;"/>
							<outline text="}"/>
							</outline>
						<outline text="finally {">
							<outline text="environment.frames = savedFrames;"/>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function findValueHome (theValue) {">
						<outline text="/*  7/28/26 by CC -- find the table that holds this exact value, for">
							<outline text="parentOf on a bare value. One full walk builds an identity map;"/>
							<outline text="later calls answer from it, and a miss rebuilds once, since the"/>
							<outline text="odb keeps changing.  */"/>
							</outline>
						<outline text="function buildIndex () {">
							<outline text="const map = new WeakMap ();"/>
							<outline text="const visited = new Set ();"/>
							<outline text="function walk (theTable, thePath) {">
								<outline text="if (visited.has (theTable)) {">
									<outline text="return;"/>
									<outline text="}"/>
									</outline>
								<outline text="visited.add (theTable);"/>
								<outline text="Object.keys (theTable).forEach (function (key) {">
									<outline text="const child = theTable [key];"/>
									<outline text="const childPath = (thePath === &quot;&quot;) ? key : thePath + &quot;.&quot; + key;"/>
									<outline text="if ((child !== null) &amp;&amp; (typeof child === &quot;object&quot;)) {">
										<outline text="if (!map.has (child)) {">
											<outline text="map.set (child, {container: theTable, containerPath: thePath, ownPath: childPath});"/>
											<outline text="}"/>
											</outline>
										<outline text="if ((child.flOdbScript === undefined) &amp;&amp; (child.flAddress === undefined) &amp;&amp; (!Array.isArray (child)) &amp;&amp; (child.type === undefined)) {">
											<outline text="walk (child, childPath);"/>
											<outline text="}"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="walk (environment.odb, &quot;&quot;);"/>
							<outline text="return (map);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (environment.parentIndex === undefined) {">
							<outline text="environment.parentIndex = buildIndex ();"/>
							<outline text="}"/>
							</outline>
						<outline text="var found = environment.parentIndex.get (theValue);"/>
						<outline text="if (found === undefined) {">
							<outline text="environment.parentIndex = buildIndex ();"/>
							<outline text="found = environment.parentIndex.get (theValue);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (found);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="/*  7/28/26 by CC -- the macro processor reaches the evaluator through">
						<outline text="the environment: run parsed statements with extra tables in scope,"/>
						<outline text="innermost last.  */"/>
						</outline>
					<outline text="environment.evaluateWithScopes = function (theStatements, theScopeTables) {">
						<outline text="theScopeTables.forEach (function (scopeTable) {">
							<outline text="environment.withPaths.push (scopeTable);"/>
							<outline text="});"/>
							</outline>
						<outline text="environment.frames.push ({vars: {}});"/>
						<outline text="try {">
							<outline text="return (evaluate (theStatements, environment));"/>
							<outline text="}"/>
							</outline>
						<outline text="catch (signal) {">
							<outline text="if (signal.flReturnSignal) {">
								<outline text="return (signal.value);"/>
								<outline text="}"/>
								</outline>
							<outline text="throw signal;"/>
							<outline text="}"/>
							</outline>
						<outline text="finally {">
							<outline text="environment.frames.pop ();"/>
							<outline text="theScopeTables.forEach (function () {">
								<outline text="environment.withPaths.pop ();"/>
								<outline text="});"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="/*  7/27/26 by CC -- the kernel's callScript reaches the evaluator">
						<outline text="through the environment: run a script value with args, optionally"/>
						<outline text="with a table in scope the way callScript's third parameter works.  */"/>
						</outline>
					<outline text="environment.callScriptValue = function (theScript, theArgs, theScopeTable) {">
						<outline text="if (theScopeTable !== undefined) {">
							<outline text="environment.withPaths.push (theScopeTable);"/>
							<outline text="}"/>
							</outline>
						<outline text="try {">
							<outline text="return (callOdbScript (theScript, theArgs, &quot;callScript&quot;, undefined));"/>
							<outline text="}"/>
							</outline>
						<outline text="finally {">
							<outline text="if (theScopeTable !== undefined) {">
								<outline text="environment.withPaths.pop ();"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="function currentFrame () {">
						<outline text="if (environment.frames.length === 0) {">
							<outline text="environment.frames.push ({vars: {}});"/>
							<outline text="}"/>
							</outline>
						<outline text="return (environment.frames [environment.frames.length - 1]);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function runBody (theBody) {">
						<outline text="return (evaluate (theBody, environment));"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="//statements"/>
					<outline text=""/>
					<outline text="theStatements.forEach (function (statement) {">
						<outline text=""/>
						<outline text="switch (statement.op) {">
							<outline text=""/>
							<outline text="case &quot;noop&quot;:">
								<outline text="break;"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;sequence&quot;:">
								<outline text="lastValue = evaluate (statement.statements, environment);"/>
								<outline text="break;"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;handler&quot;: {">
								<outline text="const handlerRec = {">
									<outline text="flHandler: true,"/>
									<outline text="name: statement.name,"/>
									<outline text="params: statement.params,"/>
									<outline text="body: statement.body,"/>
									<outline text="closureFrames: environment.frames.slice ()"/>
									<outline text="};"/>
									</outline>
								<outline text="currentFrame ().vars [statement.name] = handlerRec;"/>
								<outline text="break;"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;local&quot;: case &quot;global&quot;: {">
								<outline text="statement.inits.forEach (function (init) {">
									<outline text="var value;"/>
									<outline text="if (init.value !== undefined) {">
										<outline text="value = evalExpr (init.value);"/>
										<outline text="}"/>
										</outline>
									<outline text="if (statement.op === &quot;local&quot;) {">
										<outline text="currentFrame ().vars [init.name] = value;"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="if (findKey (environment.odb, init.name) === undefined) {">
											<outline text="environment.odb [init.name] = value;"/>
											<outline text="}"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="break;"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;assign&quot;:">
								<outline text="referenceForNode (statement.target).set (evalExpr (statement.value));"/>
								<outline text="break;"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;expression&quot;:">
								<outline text="lastValue = evalExpr (statement.expr);"/>
								<outline text="break;"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;if&quot;:">
								<outline text="if (flTrue (evalExpr (statement.test))) {">
									<outline text="runBody (statement.body);"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="if (statement.elseBody !== undefined) {">
										<outline text="runBody (statement.elseBody);"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="break;"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;loop&quot;: case &quot;loop3&quot;: case &quot;while&quot;: {">
								<outline text="var guard = 0;"/>
								<outline text="const maxIterations = 1000000;"/>
								<outline text=""/>
								<outline text="if (statement.op === &quot;loop3&quot;) {">
									<outline text="evaluate ([statement.init], environment);"/>
									<outline text="}"/>
									</outline>
								<outline text=""/>
								<outline text="var count;"/>
								<outline text="if ((statement.op === &quot;loop&quot;) &amp;&amp; (statement.count !== undefined)) {">
									<outline text="count = evalExpr (statement.count);"/>
									<outline text="}"/>
									</outline>
								<outline text=""/>
								<outline text="while (true) {">
									<outline text="guard++;"/>
									<outline text="if (guard &gt; maxIterations) {">
										<outline text="const message = &quot;Can't finish the loop because it ran &quot; + maxIterations + &quot; times.&quot;;"/>
										<outline text="throw new Error (message);"/>
										<outline text="}"/>
										</outline>
									<outline text="if ((count !== undefined) &amp;&amp; (guard &gt; count)) {">
										<outline text="break;"/>
										<outline text="}"/>
										</outline>
									<outline text="if ((statement.op === &quot;while&quot;) &amp;&amp; !flTrue (evalExpr (statement.test))) {">
										<outline text="break;"/>
										<outline text="}"/>
										</outline>
									<outline text="if ((statement.op === &quot;loop3&quot;) &amp;&amp; !flTrue (evalExpr (statement.test))) {">
										<outline text="break;"/>
										<outline text="}"/>
										</outline>
									<outline text="try {">
										<outline text="runBody (statement.body);"/>
										<outline text="}"/>
										</outline>
									<outline text="catch (signal) {">
										<outline text="if (signal.flBreakSignal) {">
											<outline text="break;"/>
											<outline text="}"/>
											</outline>
										<outline text="if (!signal.flContinueSignal) {">
											<outline text="throw signal;"/>
											<outline text="}"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="if (statement.op === &quot;loop3&quot;) {">
										<outline text="evaluate ([statement.step], environment);"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="break;"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;for&quot;: {">
								<outline text="const from = evalExpr (statement.from);"/>
								<outline text="const limit = evalExpr (statement.limit);"/>
								<outline text="var counter = from;"/>
								<outline text="while (statement.flDown ? (counter &gt;= limit) : (counter &lt;= limit)) {">
									<outline text="currentFrame ().vars [statement.name] = counter;"/>
									<outline text="try {">
										<outline text="runBody (statement.body);"/>
										<outline text="}"/>
										</outline>
									<outline text="catch (signal) {">
										<outline text="if (signal.flBreakSignal) {">
											<outline text="break;"/>
											<outline text="}"/>
											</outline>
										<outline text="if (!signal.flContinueSignal) {">
											<outline text="throw signal;"/>
											<outline text="}"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="counter = statement.flDown ? counter - 1 : counter + 1;"/>
									<outline text="}"/>
									</outline>
								<outline text="break;"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;forin&quot;: {">
								<outline text="const list = evalExpr (statement.list);"/>
								<outline text="var items = list;"/>
								<outline text="if ((list !== undefined) &amp;&amp; (list.flAddress === true)) {">
									<outline text="/*  7/27/26 by CC -- for adr in @table yields the ADDRESS of">
										<outline text="each entry, the way Frontier does: the body says adr^"/>
										<outline text="for the value and nameOf (adr^) for the entry's name.  */"/>
										</outline>
									<outline text="items = [];"/>
									<outline text="const table = list.reference.get ();"/>
									<outline text="sortedTableKeys (table).forEach (function (key) { //Frontier tables walk in sorted order">
										<outline text="items.push ({">
											<outline text="flAddress: true,"/>
											<outline text="pathText: list.pathText + &quot;.&quot; + key,"/>
											<outline text="reference: {">
												<outline text="get: function () {">
													<outline text="return (table [key]);"/>
													<outline text="},"/>
													</outline>
												<outline text="set: function (theValue) {">
													<outline text="table [key] = theValue;"/>
													<outline text="},"/>
													</outline>
												<outline text="remove: function () {">
													<outline text="delete table [key];"/>
													<outline text="}"/>
													</outline>
												<outline text="}"/>
												</outline>
											<outline text="});"/>
											</outline>
										<outline text="});"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="var flBroke = false;"/>
								<outline text="items.forEach (function (item) {">
									<outline text="if (flBroke) {">
										<outline text="return;"/>
										<outline text="}"/>
										</outline>
									<outline text="currentFrame ().vars [statement.name] = item;"/>
									<outline text="try {">
										<outline text="runBody (statement.body);"/>
										<outline text="}"/>
										</outline>
									<outline text="catch (signal) {">
										<outline text="if (signal.flBreakSignal) {">
											<outline text="flBroke = true;"/>
											<outline text="return;"/>
											<outline text="}"/>
											</outline>
										<outline text="if (!signal.flContinueSignal) {">
											<outline text="throw signal;"/>
											<outline text="}"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="break;"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;fileloop&quot;: {">
								<outline text="const folder = evalExpr (statement.folder);"/>
								<outline text="var depth = 1;"/>
								<outline text="if (statement.depth !== undefined) {">
									<outline text="depth = evalExpr (statement.depth);"/>
									<outline text="}"/>
									</outline>
								<outline text="const fileloopVerb = environment.verbs [&quot;fileloop.list&quot;];"/>
								<outline text="if (fileloopVerb === undefined) {">
									<outline text="const message = &quot;Can't run the fileloop because no fileloop.list verb is installed.&quot;;"/>
									<outline text="throw new Error (message);"/>
									<outline text="}"/>
									</outline>
								<outline text="const paths = fileloopVerb ([folder, depth], environment);"/>
								<outline text="var flBroke = false;"/>
								<outline text="paths.forEach (function (thePath) {">
									<outline text="if (flBroke) {">
										<outline text="return;"/>
										<outline text="}"/>
										</outline>
									<outline text="currentFrame ().vars [statement.name] = thePath;"/>
									<outline text="try {">
										<outline text="runBody (statement.body);"/>
										<outline text="}"/>
										</outline>
									<outline text="catch (signal) {">
										<outline text="if (signal.flBreakSignal) {">
											<outline text="flBroke = true;"/>
											<outline text="return;"/>
											<outline text="}"/>
											</outline>
										<outline text="if (!signal.flContinueSignal) {">
											<outline text="throw signal;"/>
											<outline text="}"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="break;"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;bundle&quot;:">
								<outline text="runBody (statement.body);"/>
								<outline text="break;"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;with&quot;: {">
								<outline text="const table = evalExpr (statement.path);"/>
								<outline text="var withTable = table;"/>
								<outline text="if ((table !== undefined) &amp;&amp; (table.flAddress === true)) {">
									<outline text="withTable = table.reference.get ();"/>
									<outline text="}"/>
									</outline>
								<outline text="environment.withPaths.push (withTable);"/>
								<outline text="try {">
									<outline text="runBody (statement.body);"/>
									<outline text="}"/>
									</outline>
								<outline text="finally {">
									<outline text="environment.withPaths.pop ();"/>
									<outline text="}"/>
									</outline>
								<outline text="break;"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;try&quot;:">
								<outline text="try {">
									<outline text="runBody (statement.body);"/>
									<outline text="}"/>
									</outline>
								<outline text="catch (signal) {">
									<outline text="if (signal.flBreakSignal || signal.flContinueSignal || signal.flReturnSignal) {">
										<outline text="throw signal;"/>
										<outline text="}"/>
										</outline>
									<outline text="currentFrame ().vars [&quot;tryerror&quot;] = signal.message;"/>
									<outline text="if (statement.elseBody !== undefined) {">
										<outline text="runBody (statement.elseBody);"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="break;"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;case&quot;: {">
								<outline text="const value = evalExpr (statement.value);"/>
								<outline text="var ixMatched = -1;"/>
								<outline text="statement.clauses.forEach (function (clause, ixClause) {">
									<outline text="if (ixMatched !== -1) {">
										<outline text="return;"/>
										<outline text="}"/>
										</outline>
									<outline text="const pair = coerceForCompare (value, evalExpr (clause.value));"/>
									<outline text="if (pair.left == pair.right) {">
										<outline text="ixMatched = ixClause;"/>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="if (ixMatched === -1) {">
									<outline text="if (statement.elseBody !== undefined) {">
										<outline text="runBody (statement.elseBody);"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="/*  7/27/26 by CC -- consecutive clause values share the body">
										<outline text="below them: a matched clause with an empty body runs the"/>
										<outline text="next clause's body, the way &quot;WinNT&quot; and &quot;Win95&quot; share one"/>
										<outline text="branch all over the corpus.  */"/>
										</outline>
									<outline text="var ixBody = ixMatched;"/>
									<outline text="while ((ixBody &lt; statement.clauses.length) &amp;&amp; (statement.clauses [ixBody].body.length === 0)) {">
										<outline text="ixBody++;"/>
										<outline text="}"/>
										</outline>
									<outline text="if (ixBody &lt; statement.clauses.length) {">
										<outline text="runBody (statement.clauses [ixBody].body);"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="break;"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;return&quot;:">
								<outline text="throw new ReturnSignal (statement.value === undefined ? undefined : evalExpr (statement.value));"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;break&quot;:">
								<outline text="throw new BreakSignal ();"/>
								</outline>
							<outline text=""/>
							<outline text="case &quot;continue&quot;:">
								<outline text="throw new ContinueSignal ();"/>
								</outline>
							<outline text=""/>
							<outline text="default: {">
								<outline text="const message = &quot;Can't run the statement because the operator &quot; + statement.op + &quot; isn't implemented.&quot;;"/>
								<outline text="throw new Error (message);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text=""/>
					<outline text="return (lastValue);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="exports.makeEnvironment = makeEnvironment;"/>
				<outline text="exports.evaluate = evaluate;"/>
				<outline text="exports.findKey = findKey;"/>
				</outline>
			<outline text="code/verbs.js">
				<outline text="/*  The verb library for the UserTalk interpreter prototype: real file">
					<outline text="verbs over Node fs behind a Mac-colon-path map, the string and clock"/>
					<outline text="verbs the build scripts use, and loud trace-only stubs for the rest."/>
					<outline text=""/>
					<outline text="Unimplemented verbs fail loudly -- nothing silently succeeds."/>
					<outline text=""/>
					<outline text="by CC, 7/27/26 */"/>
					</outline>
				<outline text=""/>
				<outline text="const fs = require (&quot;fs&quot;);"/>
				<outline text="const path = require (&quot;path&quot;);"/>
				<outline text="const {execFileSync} = require (&quot;child_process&quot;); //8/5/26 by CC -- the S3 verbs run a helper, see s3helper.js"/>
				<outline text=""/>
				<outline text="function makeVerbs (thePathMap, theTrace) {">
					<outline text=""/>
					<outline text="function macToReal (theColonPath) {">
						<outline text="theColonPath = String (theColonPath); //filespecs coerce to their path"/>
						<outline text="var found, foundReal;"/>
						<outline text="Object.keys (thePathMap.prefixes).forEach (function (prefix) {">
							<outline text="if (theColonPath.toLowerCase ().indexOf (prefix.toLowerCase ()) === 0) {">
								<outline text="if ((found === undefined) || (prefix.length &gt; found.length)) {">
									<outline text="found = prefix;"/>
									<outline text="foundReal = thePathMap.prefixes [prefix];"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="if (found === undefined) {">
							<outline text="const message = &quot;Can't map the path &quot; + theColonPath + &quot; because no prefix in the path map covers it.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="var rest = theColonPath.slice (found.length);"/>
						<outline text="if (rest.indexOf (&quot;:&quot;) === 0) {">
							<outline text="rest = rest.slice (1);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (rest.endsWith (&quot;:&quot;)) {">
							<outline text="rest = rest.slice (0, rest.length - 1);"/>
							<outline text="}"/>
							</outline>
						<outline text="rest.split (&quot;:&quot;).forEach (function (segment) { //8/4/26 by CC -- a &quot;..&quot; segment would walk out of the mapped folder">
							<outline text="if (segment === &quot;..&quot;) {">
								<outline text="const message = &quot;Can't map the path &quot; + theColonPath + &quot; because it steps outside its folder.&quot;;"/>
								<outline text="throw new Error (message);"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="return (path.join (foundReal, rest.split (&quot;:&quot;).join (&quot;/&quot;)));"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="const verbs = {};"/>
					<outline text=""/>
					<outline text="//file verbs"/>
					<outline text=""/>
					<outline text="verbs [&quot;file.copy&quot;] = function (args) {">
						<outline text="const source = macToReal (args [0]);"/>
						<outline text="const dest = macToReal (args [1]);"/>
						<outline text="fs.copyFileSync (source, dest);"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;file.surefilepath&quot;] = function (args) {">
						<outline text="const dest = macToReal (args [0]);"/>
						<outline text="fs.mkdirSync (path.dirname (dest), {recursive: true});"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;file.surefolder&quot;] = function (args) {">
						<outline text="fs.mkdirSync (macToReal (args [0]), {recursive: true});"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;file.exists&quot;] = function (args) {">
						<outline text="return (fs.existsSync (macToReal (args [0])));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;file.isfolder&quot;] = function (args) {">
						<outline text="const thePath = macToReal (args [0]);"/>
						<outline text="if (!fs.existsSync (thePath)) {">
							<outline text="return (false);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (fs.statSync (thePath).isDirectory ());"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;file.readwholefile&quot;] = function (args) {">
						<outline text="return (fs.readFileSync (macToReal (args [0]), &quot;latin1&quot;));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;file.writewholefile&quot;] = function (args) {">
						<outline text="const dest = macToReal (args [0]);"/>
						<outline text="fs.mkdirSync (path.dirname (dest), {recursive: true});"/>
						<outline text="fs.writeFileSync (dest, String (args [1]), &quot;latin1&quot;);"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;file.delete&quot;] = function (args) {">
						<outline text="const thePath = macToReal (args [0]);"/>
						<outline text="if (fs.existsSync (thePath)) {">
							<outline text="fs.rmSync (thePath, {recursive: true});"/>
							<outline text="}"/>
							</outline>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;file.filefrompath&quot;] = function (args) {">
						<outline text="var theColonPath = String (args [0]);"/>
						<outline text="if (theColonPath.endsWith (&quot;:&quot;)) {">
							<outline text="theColonPath = theColonPath.slice (0, theColonPath.length - 1);"/>
							<outline text="}"/>
							</outline>
						<outline text="const parts = theColonPath.split (&quot;:&quot;);"/>
						<outline text="return (parts [parts.length - 1]);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;file.folderfrompath&quot;] = function (args) {">
						<outline text="var theColonPath = String (args [0]);"/>
						<outline text="if (theColonPath.endsWith (&quot;:&quot;)) {">
							<outline text="theColonPath = theColonPath.slice (0, theColonPath.length - 1);"/>
							<outline text="}"/>
							</outline>
						<outline text="const ixLast = theColonPath.lastIndexOf (&quot;:&quot;);"/>
						<outline text="return (theColonPath.slice (0, ixLast + 1));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;file.modified&quot;] = function (args) {">
						<outline text="return (fs.statSync (macToReal (args [0])).mtime);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;fileloop.list&quot;] = function (args) { //the interpreter's fileloop support: colon paths of everything in the folder">
						<outline text="const folderColon = String (args [0]);"/>
						<outline text="const depth = args [1];"/>
						<outline text="const folderReal = macToReal (folderColon);"/>
						<outline text="const result = [];"/>
						<outline text="function visit (realFolder, colonFolder, level) {">
							<outline text="fs.readdirSync (realFolder).forEach (function (fname) {">
								<outline text="const realChild = path.join (realFolder, fname);"/>
								<outline text="const flFolder = fs.statSync (realChild).isDirectory ();"/>
								<outline text="const colonChild = colonFolder + fname + (flFolder ? &quot;:&quot; : &quot;&quot;);"/>
								<outline text="result.push (colonChild);"/>
								<outline text="if (flFolder &amp;&amp; ((depth === Infinity) || (level &lt; depth))) {">
									<outline text="visit (realChild, colonChild, level + 1);"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="var colonBase = folderColon;"/>
						<outline text="if (!colonBase.endsWith (&quot;:&quot;)) {">
							<outline text="colonBase += &quot;:&quot;;"/>
							<outline text="}"/>
							</outline>
						<outline text="visit (folderReal, colonBase, 1);"/>
						<outline text="return (result);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="//string and value verbs"/>
					<outline text=""/>
					<outline text="verbs [&quot;string.replaceall&quot;] = function (args) {">
						<outline text="return (String (args [0]).split (String (args [1])).join (String (args [2])));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.replace&quot;] = function (args) {">
						<outline text="return (String (args [0]).replace (String (args [1]), String (args [2])));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.delete&quot;] = function (args) { //1-based start, count">
						<outline text="const theString = String (args [0]);"/>
						<outline text="const ixStart = args [1] - 1;"/>
						<outline text="return (theString.slice (0, ixStart) + theString.slice (ixStart + args [2]));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.mid&quot;] = function (args) { //1-based start, count">
						<outline text="return (String (args [0]).substr (args [1] - 1, args [2]));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.lower&quot;] = function (args) {">
						<outline text="return (String (args [0]).toLowerCase ());"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.upper&quot;] = function (args) {">
						<outline text="return (String (args [0]).toUpperCase ());"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.filledstring&quot;] = function (args) {">
						<outline text="return (String (args [0]).repeat (args [1]));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.lastfield&quot;] = function (args) {">
						<outline text="const parts = String (args [0]).split (String (args [1]));"/>
						<outline text="return (parts [parts.length - 1]);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.popsuffix&quot;] = function (args) {">
						<outline text="const theString = String (args [0]);"/>
						<outline text="const ixDot = theString.lastIndexOf (&quot;.&quot;);"/>
						<outline text="if (ixDot === -1) {">
							<outline text="return (theString);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (theString.slice (0, ixDot));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.countfields&quot;] = function (args) {">
						<outline text="return (String (args [0]).split (String (args [1])).length);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.nthfield&quot;] = function (args) {">
						<outline text="return (String (args [0]).split (String (args [1])) [args [2] - 1]);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.multiplereplaceall&quot;] = function (args) {">
						<outline text=""/>
						<outline text="/*  8/4/26 by CC -- string.multipleReplaceAll (s, @table, flCaseSensitive, startCharacters, endCharacters).">
							<outline text="One replace-all per table entry, in sorted order, the search string"/>
							<outline text="built as start + entryName + end, the replacement the entry's value"/>
							<outline text="as a string. Semantics from the kernel's stringmultiplereplaceallverb:"/>
							<outline text="flCaseSensitive defaults true, and false means the match ignores case.  */"/>
							</outline>
						<outline text=""/>
						<outline text="var theString = String (args [0]);"/>
						<outline text="var theTable = args [1];"/>
						<outline text="if ((theTable !== undefined) &amp;&amp; (theTable !== null) &amp;&amp; (theTable.flAddress === true)) {">
							<outline text="theTable = theTable.reference.get ();"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((theTable === undefined) || (theTable === null) || (typeof theTable !== &quot;object&quot;)) {">
							<outline text="const message = &quot;Can't do the replacements because the second parameter isn't a table or the address of one.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="const flCaseSensitive = (args [2] === undefined) ? true : Boolean (args [2]);"/>
						<outline text="const startCharacters = (args [3] === undefined) ? &quot;&quot; : String (args [3]);"/>
						<outline text="const endCharacters = (args [4] === undefined) ? &quot;&quot; : String (args [4]);"/>
						<outline text=""/>
						<outline text="const sortedNames = Object.keys (theTable).sort (function (a, b) {">
							<outline text="return (a.toLowerCase () &lt; b.toLowerCase () ? -1 : 1);"/>
							<outline text="});"/>
							</outline>
						<outline text="sortedNames.forEach (function (name) {">
							<outline text="const searchFor = startCharacters + name + endCharacters;"/>
							<outline text="if (searchFor.length === 0) {">
								<outline text="return;"/>
								<outline text="}"/>
								</outline>
							<outline text="const replaceWith = verbs [&quot;string&quot;] ([theTable [name]]);"/>
							<outline text="if (flCaseSensitive) {">
								<outline text="theString = theString.split (searchFor).join (replaceWith);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="const lowerSearch = searchFor.toLowerCase ();"/>
								<outline text="var result = &quot;&quot;;"/>
								<outline text="var rest = theString;"/>
								<outline text="var ixFound = rest.toLowerCase ().indexOf (lowerSearch);"/>
								<outline text="while (ixFound !== -1) {">
									<outline text="result += rest.slice (0, ixFound) + replaceWith;"/>
									<outline text="rest = rest.slice (ixFound + searchFor.length);"/>
									<outline text="ixFound = rest.toLowerCase ().indexOf (lowerSearch);"/>
									<outline text="}"/>
									</outline>
								<outline text="theString = result + rest;"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="return (theString);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string&quot;] = function (args) {">
						<outline text="const theValue = args [0];"/>
						<outline text="if ((theValue !== undefined) &amp;&amp; (theValue !== null) &amp;&amp; (theValue.flAddress === true)) {">
							<outline text="/*  8/5/26 by CC -- string of an address is the path it names, the way">
								<outline text="Frontier prints an objspec. It was answering &quot;[object Object]&quot;,"/>
								<outline text="and scripts test it: getCanonicalSiteName asks whether the site"/>
								<outline text="address string endsWith a known suffix.  */"/>
								</outline>
							<outline text="return (String (theValue.pathText));"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((theValue !== undefined) &amp;&amp; (theValue !== null) &amp;&amp; (theValue.flOdbScript === true)) {">
							<outline text="/*  string of an outline or script is its text: each line at its">
								<outline text="depth in tabs, lines joined by returns.  */"/>
								</outline>
							<outline text="const textLines = [];"/>
							<outline text="theValue.lines.forEach (function (line) {">
								<outline text="if (line.flComment) {">
									<outline text="return;"/>
									<outline text="}"/>
									</outline>
								<outline text="var tabs = &quot;&quot;;"/>
								<outline text="var ct = line.level;"/>
								<outline text="while (ct &gt; 0) {">
									<outline text="tabs += &quot;\t&quot;;"/>
									<outline text="ct--;"/>
									<outline text="}"/>
									</outline>
								<outline text="textLines.push (tabs + line.text);"/>
								<outline text="});"/>
								</outline>
							<outline text="return (textLines.join (&quot;\r&quot;));"/>
							<outline text="}"/>
							</outline>
						<outline text="return (String (theValue));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;number&quot;] = function (args) {">
						<outline text="return (Number (args [0]));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;sizeof&quot;] = function (args) {">
						<outline text="const theValue = args [0];"/>
						<outline text="if (typeof theValue === &quot;string&quot;) {">
							<outline text="return (theValue.length);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (Array.isArray (theValue)) {">
							<outline text="return (theValue.length);"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((theValue !== undefined) &amp;&amp; (theValue !== null) &amp;&amp; (typeof theValue === &quot;object&quot;)) {">
							<outline text="return (Object.keys (theValue).length);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (0);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;defined&quot;] = function (args) {">
						<outline text="return (args [0] !== undefined);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;typeof&quot;] = function (args) { //answers match the language constants, so case statements compare true">
						<outline text="const theValue = args [0];"/>
						<outline text="if (theValue === undefined) {">
							<outline text="return (&quot;unknowntype&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (typeof theValue === &quot;string&quot;) {">
							<outline text="return (&quot;stringtype&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (typeof theValue === &quot;number&quot;) {">
							<outline text="return (&quot;numbertype&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (typeof theValue === &quot;boolean&quot;) {">
							<outline text="return (&quot;booleantype&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (theValue instanceof Date) {">
							<outline text="return (&quot;datetype&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (Array.isArray (theValue)) {">
							<outline text="return (&quot;listtype&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (theValue.flOdbScript === true) {">
							<outline text="return (theValue.scriptType === &quot;outline&quot; ? &quot;outlinetype&quot; : &quot;scripttype&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (theValue.flAddress === true) {">
							<outline text="return (&quot;addresstype&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (theValue.flFilespec === true) {">
							<outline text="return (&quot;filespectype&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (theValue.flWpText === true) {">
							<outline text="return (&quot;wptexttype&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (theValue.type === &quot;binary&quot;) {">
							<outline text="return (&quot;binarytype&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (theValue.type === &quot;wptext&quot;) {">
							<outline text="return (&quot;wptexttype&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (&quot;tabletype&quot;);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;nameof&quot;] = function (args) { //the last component of an address's path">
						<outline text="const theValue = args [0];"/>
						<outline text="if ((theValue !== undefined) &amp;&amp; (theValue.flAddress === true)) {">
							<outline text="if (theValue.nameText !== undefined) { //8/5/26 by CC -- the address carries its own name, because a name can contain dots">
								<outline text="return (theValue.nameText);"/>
								<outline text="}"/>
								</outline>
							<outline text="const parts = theValue.pathText.split (&quot;.&quot;);"/>
							<outline text="return (parts [parts.length - 1]);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (String (theValue));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;msg&quot;] = function (args) { //7/27/26 by CC -- msg speaks: Frontier showed it to the user, we print it">
						<outline text="console.log (String (args [0]));"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;new&quot;] = function (args) { //new (tabletype, @adr) -- create an empty value at the address">
						<outline text="const theType = args [0];"/>
						<outline text="const theAddress = args [1];"/>
						<outline text="var value = {};"/>
						<outline text="if (theType === &quot;listtype&quot;) {">
							<outline text="value = [];"/>
							<outline text="}"/>
							</outline>
						<outline text="if (theType === &quot;stringtype&quot;) {">
							<outline text="value = &quot;&quot;;"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((theType === &quot;outlinetype&quot;) || (theType === &quot;scripttype&quot;)) {">
							<outline text="value = {flOdbScript: true, scriptType: theType === &quot;outlinetype&quot; ? &quot;outline&quot; : &quot;script&quot;, lines: []};"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((theAddress === undefined) || (theAddress.flAddress !== true)) {">
							<outline text="const message = &quot;Can't create the new &quot; + theType + &quot; because the second parameter isn't an address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="theAddress.reference.set (value);"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;edit&quot;] = function (args) {">
						<outline text="return (true); //opens a window in Frontier; the trace line stands in"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;delete&quot;] = function (args) { //7/27/26 by CC -- delete (@table.entry)">
						<outline text="const theAddress = args [0];"/>
						<outline text="if ((theAddress === undefined) || (theAddress.flAddress !== true)) {">
							<outline text="const message = &quot;Can't delete the object because the parameter isn't an address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (theAddress.reference.remove !== undefined) {">
							<outline text="theAddress.reference.remove ();"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="theAddress.reference.set (undefined);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;script.newscriptobject&quot;] = function (args) { //7/27/26 by CC -- source text to a script object at an address">
						<outline text="const theText = String (args [0]);"/>
						<outline text="const theAddress = args [1];"/>
						<outline text="const lines = [];"/>
						<outline text="theText.split (/\r\n|\r|\n/).forEach (function (lineText) {">
							<outline text="var level = 0;"/>
							<outline text="while (lineText.indexOf (&quot;\t&quot;) === 0) {">
								<outline text="level++;"/>
								<outline text="lineText = lineText.slice (1);"/>
								<outline text="}"/>
								</outline>
							<outline text="lines.push ({level, text: lineText, flExpanded: true, flComment: false, flBreakpoint: false});"/>
							<outline text="});"/>
							</outline>
						<outline text="const theScript = {flOdbScript: true, scriptType: &quot;script&quot;, lines};"/>
						<outline text="if ((theAddress === undefined) || (theAddress.flAddress !== true)) {">
							<outline text="return (theScript);"/>
							<outline text="}"/>
							</outline>
						<outline text="theAddress.reference.set (theScript);"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;file.getpathchar&quot;] = function (args) {">
						<outline text="return (&quot;:&quot;); //Frontier's native path character"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;tcp.mydottedid&quot;] = function (args) {">
						<outline text="return (&quot;localhost&quot;);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;tcp.dns.getmydomainname&quot;] = function (args) {">
						<outline text="return (&quot;localhost&quot;);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;frontier.version&quot;] = function (args) {">
						<outline text="return (&quot;10.1&quot;); //the snapshot generation this odb came from"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;frontier.getprogramname&quot;] = function (args) {">
						<outline text="return (&quot;usertalk&quot;);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;frontier.getprogrampath&quot;] = function (args) {">
						<outline text="return (&quot;Macintosh HD:frontier:OPML.app&quot;); //the folder above it is where Guest Databases lives"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;scripterror&quot;] = function (args) { //the language's throw; &quot;!redirect url&quot; faked errors ride the message">
						<outline text="throw new Error (String (args [0]));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;thread.getcurrentid&quot;] = function (args) {">
						<outline text="return (1); //one thread in this world"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;sys.os&quot;] = function (args) {">
						<outline text="return (&quot;Unix&quot;); //the answers system.environment already gives, as the verb form"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;sys.systemtask&quot;] = function (args) {">
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;sys.time&quot;] = function (args) {">
						<outline text="return (new Date ());"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;sys.milliseconds&quot;] = function (args) {">
						<outline text="return (Date.now ());"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;sys.getusername&quot;] = function (args) {">
						<outline text="return (&quot;manila&quot;);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;sys.memavail&quot;] = function (args) {">
						<outline text="return (64 * 1024 * 1024);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.timemodified&quot;] = function (args) { //timeModified (adr or value) -- no per-cell timestamps here, now is honest enough">
						<outline text="return (new Date ());"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;timemodified&quot;] = verbs [&quot;lang.timemodified&quot;];"/>
					<outline text=""/>
					<outline text="verbs [&quot;timecreated&quot;] = verbs [&quot;lang.timemodified&quot;];"/>
					<outline text=""/>
					<outline text="verbs [&quot;lang.timecreated&quot;] = verbs [&quot;lang.timemodified&quot;];"/>
					<outline text=""/>
					<outline text="verbs [&quot;menu.isinstalled&quot;] = function (args) {">
						<outline text="return (false); //no menu bar in this world"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;thread.sleepfor&quot;] = function (args) {">
						<outline text="return (true); //one thread, no sleeping"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;thread.sleep&quot;] = verbs [&quot;thread.sleepfor&quot;];"/>
					<outline text=""/>
					<outline text="verbs [&quot;thread.exists&quot;] = function (args) {">
						<outline text="return (false);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="//UI-only kernel verbs: safe no-ops, there's no screen here"/>
					<outline text="const uiNoOpNames = [">
						<outline text="&quot;menu.clearmenubar&quot;, &quot;menu.installmenu&quot;, &quot;menu.uninstallmenu&quot;, &quot;menu.update&quot;,"/>
						<outline text="&quot;menu.addmenu&quot;, &quot;menu.deletemenu&quot;, &quot;menu.enable&quot;, &quot;menu.check&quot;,"/>
						<outline text="&quot;menu.buildmenubar&quot;, &quot;menu.getmenubar&quot;, &quot;menu.setmenubar&quot;, &quot;menu.new&quot;,"/>
						<outline text="&quot;window.show&quot;, &quot;window.hide&quot;, &quot;window.close&quot;, &quot;window.bringtofront&quot;, &quot;window.update&quot;,"/>
						<outline text="&quot;window.setposition&quot;, &quot;window.setsize&quot;, &quot;window.settitle&quot;,"/>
						<outline text="&quot;sys.systemtask&quot;, &quot;speaker.sound&quot;"/>
						<outline text="];"/>
						</outline>
					<outline text=""/>
					<outline text="uiNoOpNames.forEach (function (name) {">
						<outline text="verbs [name] = function (args) {">
							<outline text="return (true);"/>
							<outline text="};"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text=""/>
					<outline text="//UI questions answer false: nothing is open, frontmost or on screen here"/>
					<outline text="const uiFalseNames = [">
						<outline text="&quot;window.ismenuscript&quot;, &quot;window.isopen&quot;, &quot;window.isfront&quot;, &quot;window.isvisible&quot;,"/>
						<outline text="&quot;window.frontmost&quot;, &quot;dialog.ask&quot;, &quot;dialog.confirm&quot;, &quot;dialog.yesnocancel&quot;"/>
						<outline text="];"/>
						</outline>
					<outline text=""/>
					<outline text="uiFalseNames.forEach (function (name) {">
						<outline text="verbs [name] = function (args) {">
							<outline text="return (false);"/>
							<outline text="};"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;semaphores.lock&quot;] = function (args) {">
						<outline text="return (true); //one thread, locks always succeed"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;semaphores.unlock&quot;] = function (args) {">
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;semaphore.lock&quot;] = verbs [&quot;semaphores.lock&quot;];"/>
					<outline text=""/>
					<outline text="verbs [&quot;semaphore.unlock&quot;] = verbs [&quot;semaphores.unlock&quot;];"/>
					<outline text=""/>
					<outline text="verbs [&quot;table.sortby&quot;] = function (args) {">
						<outline text="return (true); //tables answer positional reads in sorted-by-name order; other sort orders aren't kept yet"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;table.emptytable&quot;] = function (args) {">
						<outline text="const theAddress = args [0];"/>
						<outline text="if ((theAddress !== undefined) &amp;&amp; (theAddress !== null) &amp;&amp; (theAddress.flAddress === true)) {">
							<outline text="theAddress.reference.set ({});"/>
							<outline text="}"/>
							</outline>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;webserver.builderrorpage&quot;] = function (args) { //kernel verb: the plain error page">
						<outline text="const bigString = String (args [0]);"/>
						<outline text="const littleString = (args [1] === undefined) ? &quot;&quot; : String (args [1]);"/>
						<outline text="return (&quot;&lt;html&gt;&lt;head&gt;&lt;title&gt;&quot; + bigString + &quot;&lt;/title&gt;&lt;/head&gt;&lt;body&gt;&lt;h1&gt;&quot; + bigString + &quot;&lt;/h1&gt;&lt;p&gt;&quot; + littleString + &quot;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;&quot;);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;script.compile&quot;] = function (args, environment) { //compilation here is the parse; do it now so errors surface at compile time">
						<outline text="const theAddress = args [0];"/>
						<outline text="if ((theAddress === undefined) || (theAddress.flAddress !== true)) {">
							<outline text="const message = &quot;Can't compile the script because the parameter isn't an address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="const theScript = theAddress.reference.get ();"/>
						<outline text="if ((theScript === undefined) || (theScript.flOdbScript !== true)) {">
							<outline text="const message = &quot;Can't compile the script at &quot; + theAddress.pathText + &quot; because there is no script there.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((theScript.parsedStatements === undefined) &amp;&amp; (environment.parseScript !== undefined)) {">
							<outline text="theScript.parsedStatements = environment.parseScript (theScript.lines);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;file.newfolder&quot;] = function (args) {">
						<outline text="fs.mkdirSync (macToReal (args [0]), {recursive: true});"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.popleading&quot;] = function (args) { //strip every leading occurrence of the character">
						<outline text="var theString = String (args [0]);"/>
						<outline text="const theChar = String (args [1]);"/>
						<outline text="while (theString.indexOf (theChar) === 0) {">
							<outline text="theString = theString.slice (theChar.length);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (theString);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.parsehttpargs&quot;] = function (args) {">
						<outline text="/*  &quot;a=1&amp;b=2&quot; becomes the flat list {&quot;a&quot;, &quot;1&quot;, &quot;b&quot;, &quot;2&quot;} -- names and">
							<outline text="values alternating, url-decoded; webserver.parseArgs walks it two"/>
							<outline text="at a time.  */"/>
							</outline>
						<outline text="const theText = String (args [0]);"/>
						<outline text="const result = [];"/>
						<outline text="if (theText.trim ().length === 0) {">
							<outline text="return (result);"/>
							<outline text="}"/>
							</outline>
						<outline text="function decodePart (thePart) {">
							<outline text="try {">
								<outline text="return (decodeURIComponent (thePart.split (&quot;+&quot;).join (&quot; &quot;)));"/>
								<outline text="}"/>
								</outline>
							<outline text="catch (err) {">
								<outline text="return (thePart.split (&quot;+&quot;).join (&quot; &quot;)); //malformed escapes come through as themselves"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="theText.split (&quot;&amp;&quot;).forEach (function (pair) {">
							<outline text="if (pair.length === 0) {">
								<outline text="return;"/>
								<outline text="}"/>
								</outline>
							<outline text="const ixEquals = pair.indexOf (&quot;=&quot;);"/>
							<outline text="if (ixEquals === -1) {">
								<outline text="result.push (decodePart (pair));"/>
								<outline text="result.push (&quot;&quot;);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="result.push (decodePart (pair.slice (0, ixEquals)));"/>
								<outline text="result.push (decodePart (pair.slice (ixEquals + 1)));"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="return (result);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.urldecode&quot;] = function (args) {">
						<outline text="return (decodeURIComponent (String (args [0]).split (&quot;+&quot;).join (&quot; &quot;)));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.urlencode&quot;] = function (args) {">
						<outline text="return (encodeURIComponent (String (args [0])));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.poptrailing&quot;] = function (args) { //strip every trailing occurrence of the character">
						<outline text="var theString = String (args [0]);"/>
						<outline text="const theChar = String (args [1]);"/>
						<outline text="while (theString.endsWith (theChar)) {">
							<outline text="theString = theString.slice (0, theString.length - theChar.length);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (theString);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.trimwhitespace&quot;] = function (args) {">
						<outline text="return (String (args [0]).trim ());"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.patternmatch&quot;] = function (args) { //1-based index of the pattern, 0 if absent">
						<outline text="return (String (args [1]).indexOf (String (args [0])) + 1);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.urlsplit&quot;] = function (args) { //{protocol, host, path} the Frontier way">
						<outline text="const theUrl = String (args [0]);"/>
						<outline text="const ixColon = theUrl.indexOf (&quot;://&quot;);"/>
						<outline text="const protocol = theUrl.slice (0, ixColon);"/>
						<outline text="const rest = theUrl.slice (ixColon + 3);"/>
						<outline text="const ixSlash = rest.indexOf (&quot;/&quot;);"/>
						<outline text="if (ixSlash === -1) {">
							<outline text="return ([protocol, rest, &quot;/&quot;]);"/>
							<outline text="}"/>
							</outline>
						<outline text="return ([protocol, rest.slice (0, ixSlash), rest.slice (ixSlash)]);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;table.tablecontains&quot;] = function (args) { //is the second address inside the first table? shallow walk">
						<outline text="const adrTable = args [0];"/>
						<outline text="const adrItem = args [1];"/>
						<outline text="if ((adrTable === undefined) || (adrTable.flAddress !== true) || (adrItem === undefined) || (adrItem.flAddress !== true)) {">
							<outline text="return (false);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (adrItem.pathText.toLowerCase ().indexOf (adrTable.pathText.toLowerCase () + &quot;.&quot;) === 0);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="/*  Guest databases: an open database is a table at the odb root whose">
						<outline text="name is the file's full colon path, which is exactly what [f]"/>
						<outline text="resolves to. Opening reads a real .root through frontierOdb;"/>
						<outline text="creating registers an empty table and touches the real file so"/>
						<outline text="file.exists agrees; saving is a no-op in this in-memory world.  */"/>
						</outline>
					<outline text=""/>
					<outline text="function findDatabaseKey (theOdb, thePath) {">
						<outline text="const lower = thePath.toLowerCase ();"/>
						<outline text="var found;"/>
						<outline text="Object.keys (theOdb).forEach (function (key) {">
							<outline text="if ((found === undefined) &amp;&amp; (key.toLowerCase () === lower)) {">
								<outline text="found = key;"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="return (found);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;filemenu.open&quot;] = function (args, environment) {">
						<outline text="const thePath = String (args [0]);"/>
						<outline text="if (findDatabaseKey (environment.odb, thePath) !== undefined) {">
							<outline text="return (true); //already open"/>
							<outline text="}"/>
							</outline>
						<outline text="const odbHomeTools = require (&quot;./odbHome.js&quot;);"/>
						<outline text="const frontierOdb = odbHomeTools.requireFrontierOdb ();"/>
						<outline text="const realPath = macToReal (thePath);"/>
						<outline text="if (!fs.existsSync (realPath)) {">
							<outline text="const message = &quot;Can't open the database &quot; + thePath + &quot; because there is no file with that name.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (fs.statSync (realPath).size === 0) { //a marker for a database created in this world: empty table">
							<outline text="environment.odb [thePath] = {};"/>
							<outline text="return (true);"/>
							<outline text="}"/>
							</outline>
						<outline text="const theTopLevel = frontierOdb.readRootFile (realPath);"/>
						<outline text="const theTable = {};"/>
						<outline text="Object.keys (theTopLevel).forEach (function (name) {">
							<outline text="theTable [name] = odbHomeTools.convertValue (theTopLevel [name]);"/>
							<outline text="});"/>
							</outline>
						<outline text="environment.odb [thePath] = theTable;"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;filemenu.new&quot;] = function (args, environment) {">
						<outline text="const thePath = String (args [0]);"/>
						<outline text="if (findDatabaseKey (environment.odb, thePath) === undefined) {">
							<outline text="environment.odb [thePath] = {};"/>
							<outline text="}"/>
							</outline>
						<outline text="const realPath = macToReal (thePath);"/>
						<outline text="fs.mkdirSync (path.dirname (realPath), {recursive: true});"/>
						<outline text="if (!fs.existsSync (realPath)) {">
							<outline text="fs.writeFileSync (realPath, &quot;&quot;); //the marker file, so file.exists agrees the db exists"/>
							<outline text="}"/>
							</outline>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;filemenu.save&quot;] = function (args) {">
						<outline text="return (true); //the in-memory world has nothing to flush yet"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;filemenu.savemyroot&quot;] = function (args) {">
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;filemenu.close&quot;] = function (args) {">
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.isalpha&quot;] = function (args) {">
						<outline text="const theChar = String (args [0]).charAt (0);"/>
						<outline text="return (((theChar &gt;= &quot;a&quot;) &amp;&amp; (theChar &lt;= &quot;z&quot;)) || ((theChar &gt;= &quot;A&quot;) &amp;&amp; (theChar &lt;= &quot;Z&quot;)));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.isnumeric&quot;] = function (args) {">
						<outline text="const theChar = String (args [0]).charAt (0);"/>
						<outline text="return ((theChar &gt;= &quot;0&quot;) &amp;&amp; (theChar &lt;= &quot;9&quot;));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.nthchar&quot;] = function (args) {">
						<outline text="return (String (args [0]).charAt (args [1] - 1));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.innercasename&quot;] = function (args) { //&quot;Nirvana Server&quot; -&gt; &quot;nirvanaServer&quot;">
						<outline text="const words = String (args [0]).split (&quot; &quot;);"/>
						<outline text="var result = &quot;&quot;;"/>
						<outline text="words.forEach (function (word, ixWord) {">
							<outline text="if (word.length === 0) {">
								<outline text="return;"/>
								<outline text="}"/>
								</outline>
							<outline text="if (result.length === 0) {">
								<outline text="result += word.charAt (0).toLowerCase () + word.slice (1);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="result += word.charAt (0).toUpperCase () + word.slice (1);"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="return (result);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.insert&quot;] = function (args) { //insert the first string into the second at a 1-based position">
						<outline text="const theInsert = String (args [0]);"/>
						<outline text="const theString = String (args [1]);"/>
						<outline text="const ixAt = args [2] - 1;"/>
						<outline text="return (theString.slice (0, ixAt) + theInsert + theString.slice (ixAt));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.padwithzeros&quot;] = function (args) {">
						<outline text="var theString = String (args [0]);"/>
						<outline text="while (theString.length &lt; args [1]) {">
							<outline text="theString = &quot;0&quot; + theString;"/>
							<outline text="}"/>
							</outline>
						<outline text="return (theString);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.binary&quot;] = function (args) { //binary coercion; a wrapped string survives the string () round trip">
						<outline text="const theValue = args [0];"/>
						<outline text="if ((theValue !== undefined) &amp;&amp; (theValue !== null) &amp;&amp; (typeof theValue === &quot;object&quot;) &amp;&amp; (theValue.type === &quot;binary&quot;)) {">
							<outline text="return (theValue);"/>
							<outline text="}"/>
							</outline>
						<outline text="return ({">
							<outline text="type: &quot;binary&quot;,"/>
							<outline text="data: String (theValue),"/>
							<outline text="toString: function () {">
								<outline text="return (this.data);"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;binary&quot;] = verbs [&quot;lang.binary&quot;];"/>
					<outline text=""/>
					<outline text="verbs [&quot;lang.boolean&quot;] = function (args) {">
						<outline text="const theValue = args [0];"/>
						<outline text="return ((theValue !== false) &amp;&amp; (theValue !== undefined) &amp;&amp; (theValue !== 0) &amp;&amp; (theValue !== &quot;&quot;) &amp;&amp; (theValue !== &quot;false&quot;));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;boolean&quot;] = verbs [&quot;lang.boolean&quot;];"/>
					<outline text=""/>
					<outline text="verbs [&quot;char&quot;] = function (args) {">
						<outline text="return (String.fromCharCode (Number (args [0])));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;random&quot;] = function (args) { //random (min, max), character bounds legal">
						<outline text="var min = args [0], max = args [1];"/>
						<outline text="if (typeof min === &quot;string&quot;) {">
							<outline text="min = min.charCodeAt (0);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (typeof max === &quot;string&quot;) {">
							<outline text="max = max.charCodeAt (0);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (min + Math.floor (Math.random () * (max - min + 1)));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.parseaddress&quot;] = function (args, environment) {">
						<outline text="/*  Address text to an address value: &quot;config.manila.sites&quot; or">
							<outline text="&quot;[Macintosh HD:...:site.root].siteTable.sub&quot;. Resolves lazily"/>
							<outline text="against the odb each time it's used, parents created on set.  */"/>
							</outline>
						<outline text="const theText = String (args [0]);"/>
						<outline text="const parts = [];"/>
						<outline text="var rest = theText;"/>
						<outline text="while (rest.length &gt; 0) {">
							<outline text="if (rest.indexOf (&quot;[&quot;) === 0) {">
								<outline text="const ixClose = rest.indexOf (&quot;]&quot;);"/>
								<outline text="var bracketed = rest.slice (1, ixClose);"/>
								<outline text="if ((bracketed.indexOf (&quot;\&quot;&quot;) === 0) &amp;&amp; (bracketed.lastIndexOf (&quot;\&quot;&quot;) === bracketed.length - 1)) {">
									<outline text="bracketed = bracketed.slice (1, bracketed.length - 1);"/>
									<outline text="}"/>
									</outline>
								<outline text="parts.push (bracketed);"/>
								<outline text="rest = rest.slice (ixClose + 1);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="var ixDot = rest.indexOf (&quot;.&quot;);"/>
								<outline text="var ixBracket = rest.indexOf (&quot;[&quot;);"/>
								<outline text="if (ixDot === -1) {">
									<outline text="ixDot = rest.length;"/>
									<outline text="}"/>
									</outline>
								<outline text="if ((ixBracket !== -1) &amp;&amp; (ixBracket &lt; ixDot)) {">
									<outline text="ixDot = ixBracket;"/>
									<outline text="}"/>
									</outline>
								<outline text="if (ixDot &gt; 0) {">
									<outline text="parts.push (rest.slice (0, ixDot));"/>
									<outline text="}"/>
									</outline>
								<outline text="rest = rest.slice (ixDot);"/>
								<outline text="}"/>
								</outline>
							<outline text="if (rest.indexOf (&quot;.&quot;) === 0) {">
								<outline text="rest = rest.slice (1);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="function findKeyHere (theTable, theName) {">
							<outline text="if (theTable [theName] !== undefined) {">
								<outline text="return (theName);"/>
								<outline text="}"/>
								</outline>
							<outline text="const lower = theName.toLowerCase ();"/>
							<outline text="var found;"/>
							<outline text="Object.keys (theTable).forEach (function (key) {">
								<outline text="if ((found === undefined) &amp;&amp; (key.toLowerCase () === lower)) {">
									<outline text="found = key;"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="return (found);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="function walkToParent (flCreate) {">
							<outline text="var current = environment.odb;"/>
							<outline text="var ixPart;"/>
							<outline text="for (ixPart = 0; ixPart &lt; parts.length - 1; ixPart++) {">
								<outline text="if ((current === undefined) || (current === null) || (typeof current !== &quot;object&quot;)) {">
									<outline text="return (undefined);"/>
									<outline text="}"/>
									</outline>
								<outline text="var key = findKeyHere (current, parts [ixPart]);"/>
								<outline text="if (key === undefined) {">
									<outline text="if (!flCreate) {">
										<outline text="return (undefined);"/>
										<outline text="}"/>
										</outline>
									<outline text="key = parts [ixPart];"/>
									<outline text="current [key] = {};"/>
									<outline text="}"/>
									</outline>
								<outline text="current = current [key];"/>
								<outline text="}"/>
								</outline>
							<outline text="return (current);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="const lastPart = parts [parts.length - 1];"/>
						<outline text=""/>
						<outline text="return ({">
							<outline text="flAddress: true,"/>
							<outline text="pathText: parts.join (&quot;.&quot;),"/>
							<outline text="reference: {">
								<outline text="get: function () {">
									<outline text="const parent = walkToParent (false);"/>
									<outline text="if ((parent === undefined) || (parent === null) || (typeof parent !== &quot;object&quot;)) {">
										<outline text="return (undefined);"/>
										<outline text="}"/>
										</outline>
									<outline text="const key = findKeyHere (parent, lastPart);"/>
									<outline text="return ((key === undefined) ? undefined : parent [key]);"/>
									<outline text="},"/>
									</outline>
								<outline text="set: function (theValue) {">
									<outline text="const parent = walkToParent (true);"/>
									<outline text="if ((parent === undefined) || (parent === null) || (typeof parent !== &quot;object&quot;)) {">
										<outline text="const message = &quot;Can't set the value at &quot; + theText + &quot; because the path can't be reached.&quot;;"/>
										<outline text="throw new Error (message);"/>
										<outline text="}"/>
										</outline>
									<outline text="var key = findKeyHere (parent, lastPart);"/>
									<outline text="if (key === undefined) {">
										<outline text="key = lastPart;"/>
										<outline text="}"/>
										</outline>
									<outline text="parent [key] = theValue;"/>
									<outline text="},"/>
									</outline>
								<outline text="remove: function () {">
									<outline text="const parent = walkToParent (false);"/>
									<outline text="if ((parent === undefined) || (parent === null) || (typeof parent !== &quot;object&quot;)) {">
										<outline text="return;"/>
										<outline text="}"/>
										</outline>
									<outline text="const key = findKeyHere (parent, lastPart);"/>
									<outline text="if (key !== undefined) {">
										<outline text="delete parent [key];"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="/*  Word-processing text: a string that knows it's a wp object. New">
						<outline text="templates are built from strings, so this covers the create path;"/>
						<outline text="wptext loaded from old databases still arrives as an undecoded"/>
						<outline text="marker until frontierOdb learns the format.  */"/>
						</outline>
					<outline text=""/>
					<outline text="function makeWpText (theText) {">
						<outline text="return ({">
							<outline text="flWpText: true,"/>
							<outline text="text: String (theText),"/>
							<outline text="toString: function () {">
								<outline text="return (this.text);"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;wp.newtextobject&quot;] = function (args) {">
						<outline text="const theObject = makeWpText (args [0]);"/>
						<outline text="const theAddress = args [1];"/>
						<outline text="if ((theAddress !== undefined) &amp;&amp; (theAddress !== null) &amp;&amp; (theAddress.flAddress === true)) {">
							<outline text="theAddress.reference.set (theObject);"/>
							<outline text="return (true);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (theObject);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;target.set&quot;] = function (args, environment) { //returns the previous target">
						<outline text="if (environment.targetStack === undefined) {">
							<outline text="environment.targetStack = [];"/>
							<outline text="}"/>
							</outline>
						<outline text="const oldTarget = environment.targetStack [environment.targetStack.length - 1];"/>
						<outline text="environment.targetStack.push (args [0]);"/>
						<outline text="return (oldTarget);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;target.get&quot;] = function (args, environment) {">
						<outline text="if (environment.targetStack === undefined) {">
							<outline text="return (undefined);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (environment.targetStack [environment.targetStack.length - 1]);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;target.clear&quot;] = function (args, environment) {">
						<outline text="if (environment.targetStack !== undefined) {">
							<outline text="environment.targetStack.pop ();"/>
							<outline text="}"/>
							</outline>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="function currentTargetReference (environment) {">
						<outline text="if ((environment.targetStack === undefined) || (environment.targetStack.length === 0)) {">
							<outline text="const message = &quot;Can't operate on the target because no target is set.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="const theTarget = environment.targetStack [environment.targetStack.length - 1];"/>
						<outline text="if ((theTarget === undefined) || (theTarget.flAddress !== true)) {">
							<outline text="const message = &quot;Can't operate on the target because it isn't an address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (theTarget.reference);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;wp.settext&quot;] = function (args, environment) {">
						<outline text="currentTargetReference (environment).set (makeWpText (args [0]));"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;wp.gettext&quot;] = function (args, environment) {">
						<outline text="return (String (currentTargetReference (environment).get ()));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.callscript&quot;] = function (args, environment) { //callScript (@adrScript, {params}, adrTableInScope)">
						<outline text="var theScript = args [0];"/>
						<outline text="while ((theScript !== undefined) &amp;&amp; (theScript !== null) &amp;&amp; (theScript.flAddress === true)) {">
							<outline text="theScript = theScript.reference.get ();"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((theScript === undefined) || (theScript.flOdbScript !== true)) {">
							<outline text="const message = &quot;Can't call the script because the first parameter doesn't lead to a script.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="const theArgs = Array.isArray (args [1]) ? args [1] : [];"/>
						<outline text="var theScopeTable = args [2];"/>
						<outline text="if ((theScopeTable !== undefined) &amp;&amp; (theScopeTable !== null) &amp;&amp; (theScopeTable.flAddress === true)) {">
							<outline text="theScopeTable = theScopeTable.reference.get ();"/>
							<outline text="}"/>
							</outline>
						<outline text="return (environment.callScriptValue (theScript, theArgs, theScopeTable));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;callscript&quot;] = verbs [&quot;lang.callscript&quot;];"/>
					<outline text=""/>
					<outline text="verbs [&quot;table.assign&quot;] = function (args) { //table.assign (@adr, value)">
						<outline text="const theAddress = args [0];"/>
						<outline text="if ((theAddress === undefined) || (theAddress.flAddress !== true)) {">
							<outline text="const message = &quot;Can't assign because the first parameter isn't an address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="theAddress.reference.set (args [1]);"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.get&quot;] = function (args) { //date.get (d, @day, @month, @year, @hour, @minute, @second)">
						<outline text="const theDate = new Date (args [0]);"/>
						<outline text="const values = [theDate.getDate (), theDate.getMonth () + 1, theDate.getFullYear (), theDate.getHours (), theDate.getMinutes (), theDate.getSeconds ()];"/>
						<outline text="values.forEach (function (value, ixValue) {">
							<outline text="const theAddress = args [ixValue + 1];"/>
							<outline text="if ((theAddress !== undefined) &amp;&amp; (theAddress !== null) &amp;&amp; (theAddress.flAddress === true)) {">
								<outline text="theAddress.reference.set (value);"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;mrcalendar.getdayaddress&quot;] = function (args) {">
						<outline text="/*  The calendar bottleneck: a date becomes year/month/day nested">
							<outline text="tables under the calendar, created on the way in when allowed."/>
							<outline text="Spec preserved in the comment of mainResponder.calendar.getDayAddress.  */"/>
							</outline>
						<outline text="const adrCalendar = args [0];"/>
						<outline text="const theDate = new Date (args [1]);"/>
						<outline text="const flCreate = (args [2] === undefined) ? true : (args [2] !== false);"/>
						<outline text="const objType = (args [3] === undefined) ? &quot;tabletype&quot; : args [3];"/>
						<outline text="if ((adrCalendar === undefined) || (adrCalendar.flAddress !== true)) {">
							<outline text="const message = &quot;Can't get the day address because the first parameter isn't an address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="const year = String (theDate.getFullYear ());"/>
						<outline text="var month = String (theDate.getMonth () + 1);"/>
						<outline text="var day = String (theDate.getDate ());"/>
						<outline text="while (month.length &lt; 2) {">
							<outline text="month = &quot;0&quot; + month;"/>
							<outline text="}"/>
							</outline>
						<outline text="while (day.length &lt; 2) {">
							<outline text="day = &quot;0&quot; + day;"/>
							<outline text="}"/>
							</outline>
						<outline text="var container = adrCalendar.reference.get ();"/>
						<outline text="if ((container === undefined) &amp;&amp; flCreate) {">
							<outline text="adrCalendar.reference.set ({});"/>
							<outline text="container = adrCalendar.reference.get ();"/>
							<outline text="}"/>
							</outline>
						<outline text="const parts = [year, month];"/>
						<outline text="var flBroken = false;"/>
						<outline text="parts.forEach (function (part) {">
							<outline text="if (flBroken) {">
								<outline text="return;"/>
								<outline text="}"/>
								</outline>
							<outline text="if (container [part] === undefined) {">
								<outline text="if (flCreate) {">
									<outline text="container [part] = {};"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="flBroken = true;"/>
									<outline text="return;"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="container = container [part];"/>
							<outline text="});"/>
							</outline>
						<outline text="if (flBroken) {">
							<outline text="container = undefined;"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((container !== undefined) &amp;&amp; (container [day] === undefined) &amp;&amp; flCreate &amp;&amp; (objType !== undefined)) {">
							<outline text="container [day] = (objType === &quot;outlinetype&quot;) ? {flOdbScript: true, scriptType: &quot;outline&quot;, lines: []} : {};"/>
							<outline text="}"/>
							</outline>
						<outline text="const dayContainer = container;"/>
						<outline text="return ({">
							<outline text="flAddress: true,"/>
							<outline text="pathText: adrCalendar.pathText + &quot;.&quot; + year + &quot;.&quot; + month + &quot;.&quot; + day,"/>
							<outline text="reference: {">
								<outline text="get: function () {">
									<outline text="return ((dayContainer === undefined) ? undefined : dayContainer [day]);"/>
									<outline text="},"/>
									</outline>
								<outline text="set: function (theValue) {">
									<outline text="if (dayContainer === undefined) {">
										<outline text="const message = &quot;Can't set the day because the calendar path couldn't be reached.&quot;;"/>
										<outline text="throw new Error (message);"/>
										<outline text="}"/>
										</outline>
									<outline text="dayContainer [day] = theValue;"/>
									<outline text="},"/>
									</outline>
								<outline text="remove: function () {">
									<outline text="if (dayContainer !== undefined) {">
										<outline text="delete dayContainer [day];"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;html.drawcalendar&quot;] = function (args, environment) {">
						<outline text="/*  The month calendar, from the original script preserved in the">
							<outline text="comment of mainResponder.calendar.draw: a table for curdate's"/>
							<outline text="month, days that exist in the calendar table become links to"/>
							<outline text="urlprefix + year + delim + month + delim + day.  */"/>
							</outline>
						<outline text="const adrCalendar = args [0];"/>
						<outline text="const urlPrefix = (args [1] === undefined) ? &quot;&quot; : String (args [1]);"/>
						<outline text="const colWidth = (args [2] === undefined) ? 32 : args [2];"/>
						<outline text="const rowHeight = (args [3] === undefined) ? 22 : args [3];"/>
						<outline text="const tableBorder = (args [4] === undefined) ? 0 : args [4];"/>
						<outline text="const bgColor = args [5];"/>
						<outline text="const monthYearTemplate = (args [6] === undefined) ? &quot;&lt;b&gt;&lt;center&gt;***&lt;/center&gt;&lt;/b&gt;&quot; : String (args [6]);"/>
						<outline text="const dayNameTemplate = (args [7] === undefined) ? &quot;&lt;center&gt;***&lt;/center&gt;&quot; : String (args [7]);"/>
						<outline text="const dayTemplate = (args [8] === undefined) ? &quot;&lt;center&gt;&lt;b&gt;***&lt;/b&gt;&lt;/center&gt;&quot; : String (args [8]);"/>
						<outline text="const curDate = (args [9] === undefined) ? new Date () : new Date (args [9]);"/>
						<outline text="const urlDelimiter = (args [10] === undefined) ? &quot;/&quot; : String (args [10]);"/>
						<outline text=""/>
						<outline text="const monthNames = [&quot;January&quot;, &quot;February&quot;, &quot;March&quot;, &quot;April&quot;, &quot;May&quot;, &quot;June&quot;, &quot;July&quot;, &quot;August&quot;, &quot;September&quot;, &quot;October&quot;, &quot;November&quot;, &quot;December&quot;];"/>
						<outline text="const dayNames = [&quot;Sun&quot;, &quot;Mon&quot;, &quot;Tue&quot;, &quot;Wed&quot;, &quot;Thu&quot;, &quot;Fri&quot;, &quot;Sat&quot;];"/>
						<outline text=""/>
						<outline text="var calendarTable;"/>
						<outline text="if ((adrCalendar !== undefined) &amp;&amp; (adrCalendar !== null) &amp;&amp; (adrCalendar.flAddress === true)) {">
							<outline text="calendarTable = adrCalendar.reference.get ();"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="const year = curDate.getFullYear ();"/>
						<outline text="const month = curDate.getMonth (); //0-based here, 1-based in names below"/>
						<outline text="const yearName = String (year);"/>
						<outline text="var monthName = String (month + 1);"/>
						<outline text="while (monthName.length &lt; 2) {">
							<outline text="monthName = &quot;0&quot; + monthName;"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="function dayEntryExists (dayNumber) {">
							<outline text="if ((calendarTable === undefined) || (calendarTable === null) || (typeof calendarTable !== &quot;object&quot;)) {">
								<outline text="return (false);"/>
								<outline text="}"/>
								</outline>
							<outline text="var dayName = String (dayNumber);"/>
							<outline text="while (dayName.length &lt; 2) {">
								<outline text="dayName = &quot;0&quot; + dayName;"/>
								<outline text="}"/>
								</outline>
							<outline text="var found = false;"/>
							<outline text="Object.keys (calendarTable).forEach (function (yearKey) {">
								<outline text="if (yearKey === yearName) {">
									<outline text="const monthTable = calendarTable [yearKey];"/>
									<outline text="if ((monthTable !== null) &amp;&amp; (typeof monthTable === &quot;object&quot;)) {">
										<outline text="Object.keys (monthTable).forEach (function (monthKey) {">
											<outline text="if (monthKey === monthName) {">
												<outline text="const dayTable = monthTable [monthKey];"/>
												<outline text="if ((dayTable !== null) &amp;&amp; (typeof dayTable === &quot;object&quot;) &amp;&amp; (dayTable [dayName] !== undefined)) {">
													<outline text="found = true;"/>
													<outline text="}"/>
													</outline>
												<outline text="}"/>
												</outline>
											<outline text="});"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="return (found);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="const bgColorString = ((bgColor === undefined) || (bgColor === null)) ? &quot;&quot; : &quot; bgcolor=\&quot;&quot; + String (bgColor) + &quot;\&quot;&quot;;"/>
						<outline text="var htmlText = &quot;&quot;;"/>
						<outline text=""/>
						<outline text="htmlText += &quot;&lt;table border=\&quot;&quot; + tableBorder + &quot;\&quot;&gt;\r&quot;;"/>
						<outline text="htmlText += &quot;&lt;tr&gt;&lt;td colspan=\&quot;7\&quot;&gt;&quot; + monthYearTemplate.split (&quot;***&quot;).join (monthNames [month] + &quot; &quot; + year) + &quot;&lt;/td&gt;&lt;/tr&gt;\r&quot;;"/>
						<outline text="htmlText += &quot;&lt;tr&gt;&quot;;"/>
						<outline text="dayNames.forEach (function (name) {">
							<outline text="htmlText += &quot;&lt;td width=\&quot;&quot; + colWidth + &quot;\&quot;&gt;&quot; + dayNameTemplate.split (&quot;***&quot;).join (name) + &quot;&lt;/td&gt;&quot;;"/>
							<outline text="});"/>
							</outline>
						<outline text="htmlText += &quot;&lt;/tr&gt;\r&quot;;"/>
						<outline text=""/>
						<outline text="const firstDay = new Date (year, month, 1).getDay ();"/>
						<outline text="const daysInMonth = new Date (year, month + 1, 0).getDate ();"/>
						<outline text=""/>
						<outline text="var cellText = &quot;&quot;;"/>
						<outline text="var ctCells = 0;"/>
						<outline text="var ixCell;"/>
						<outline text="for (ixCell = 0; ixCell &lt; firstDay; ixCell++) {">
							<outline text="cellText += &quot;&lt;td width=\&quot;&quot; + colWidth + &quot;\&quot; height=\&quot;&quot; + rowHeight + &quot;\&quot;&quot; + bgColorString + &quot;&gt;&lt;/td&gt;&quot;;"/>
							<outline text="ctCells++;"/>
							<outline text="}"/>
							</outline>
						<outline text="var dayNumber;"/>
						<outline text="for (dayNumber = 1; dayNumber &lt;= daysInMonth; dayNumber++) {">
							<outline text="var inner = dayTemplate.split (&quot;***&quot;).join (String (dayNumber));"/>
							<outline text="if (dayEntryExists (dayNumber)) {">
								<outline text="var dayName = String (dayNumber);"/>
								<outline text="while (dayName.length &lt; 2) {">
									<outline text="dayName = &quot;0&quot; + dayName;"/>
									<outline text="}"/>
									</outline>
								<outline text="inner = &quot;&lt;a href=\&quot;&quot; + urlPrefix + yearName + urlDelimiter + monthName + urlDelimiter + dayName + &quot;\&quot;&gt;&quot; + inner + &quot;&lt;/a&gt;&quot;;"/>
								<outline text="}"/>
								</outline>
							<outline text="cellText += &quot;&lt;td width=\&quot;&quot; + colWidth + &quot;\&quot; height=\&quot;&quot; + rowHeight + &quot;\&quot;&quot; + bgColorString + &quot;&gt;&quot; + inner + &quot;&lt;/td&gt;&quot;;"/>
							<outline text="ctCells++;"/>
							<outline text="if ((ctCells % 7) === 0) {">
								<outline text="htmlText += &quot;&lt;tr&gt;&quot; + cellText + &quot;&lt;/tr&gt;\r&quot;;"/>
								<outline text="cellText = &quot;&quot;;"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="if (cellText.length &gt; 0) {">
							<outline text="while ((ctCells % 7) !== 0) {">
								<outline text="cellText += &quot;&lt;td width=\&quot;&quot; + colWidth + &quot;\&quot; height=\&quot;&quot; + rowHeight + &quot;\&quot;&quot; + bgColorString + &quot;&gt;&lt;/td&gt;&quot;;"/>
								<outline text="ctCells++;"/>
								<outline text="}"/>
								</outline>
							<outline text="htmlText += &quot;&lt;tr&gt;&quot; + cellText + &quot;&lt;/tr&gt;\r&quot;;"/>
							<outline text="}"/>
							</outline>
						<outline text="htmlText += &quot;&lt;/table&gt;\r&quot;;"/>
						<outline text=""/>
						<outline text="return (htmlText);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;html.processmacros&quot;] = function (args, environment) {">
						<outline text="/*  The macro processor: everything between balanced curly braces is">
							<outline text="a UserTalk expression, evaluated with the macro tables and the"/>
							<outline text="page table in scope, its result substituted into the text. A"/>
							<outline text="macro that fails leaves its error in the page, in brackets, so"/>
							<outline text="the page still renders and the problem names itself.  */"/>
							</outline>
						<outline text="const theText = String (args [0]);"/>
						<outline text="const adrPageTable = args [2];"/>
						<outline text=""/>
						<outline text="const scopeTables = [];"/>
						<outline text="function pushScope (theTable) {">
							<outline text="if ((theTable !== undefined) &amp;&amp; (theTable !== null) &amp;&amp; (typeof theTable === &quot;object&quot;)) {">
								<outline text="scopeTables.push (theTable);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="function tableAt (theParent, theName) {">
							<outline text="if ((theParent === undefined) || (theParent === null) || (typeof theParent !== &quot;object&quot;)) {">
								<outline text="return (undefined);"/>
								<outline text="}"/>
								</outline>
							<outline text="return (theParent [theName]);"/>
							<outline text="}"/>
							</outline>
						<outline text="const builtins = environment.odb.system.verbs.builtins;"/>
						<outline text="pushScope (tableAt (tableAt (builtins.html, &quot;data&quot;), &quot;standardMacros&quot;));"/>
						<outline text="pushScope (tableAt (tableAt (environment.odb.user, &quot;html&quot;), &quot;macros&quot;));"/>
						<outline text="pushScope (environment.odb.manilaMacros); //the manilaMacros search-path addition, PBS 05/11/00"/>
						<outline text="var pageTable;"/>
						<outline text="if ((adrPageTable !== undefined) &amp;&amp; (adrPageTable !== null) &amp;&amp; (adrPageTable.flAddress === true)) {">
							<outline text="pageTable = adrPageTable.reference.get ();"/>
							<outline text="pushScope (pageTable); //innermost: {title} answers the page table's title"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="var result = &quot;&quot;;"/>
						<outline text="var ix = 0;"/>
						<outline text="while (ix &lt; theText.length) {">
							<outline text="const ch = theText.charAt (ix);"/>
							<outline text="if (ch !== &quot;{&quot;) {">
								<outline text="result += ch;"/>
								<outline text="ix++;"/>
								<outline text="continue;"/>
								<outline text="}"/>
								</outline>
							<outline text="//find the balanced closing brace, quotes respected"/>
							<outline text="var depth = 0;"/>
							<outline text="var ixScan = ix;"/>
							<outline text="var quoteChar = &quot;&quot;;"/>
							<outline text="var ixClose = -1;"/>
							<outline text="while (ixScan &lt; theText.length) {">
								<outline text="const chScan = theText.charAt (ixScan);"/>
								<outline text="if (quoteChar !== &quot;&quot;) {">
									<outline text="if (chScan === &quot;\\&quot;) {">
										<outline text="ixScan++;"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="if (chScan === quoteChar) {">
											<outline text="quoteChar = &quot;&quot;;"/>
											<outline text="}"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="if ((chScan === &quot;\&quot;&quot;) || (chScan === &quot;'&quot;)) {">
										<outline text="quoteChar = chScan;"/>
										<outline text="}"/>
										</outline>
									<outline text="if (chScan === &quot;{&quot;) {">
										<outline text="depth++;"/>
										<outline text="}"/>
										</outline>
									<outline text="if (chScan === &quot;}&quot;) {">
										<outline text="depth--;"/>
										<outline text="if (depth === 0) {">
											<outline text="ixClose = ixScan;"/>
											<outline text="break;"/>
											<outline text="}"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="ixScan++;"/>
								<outline text="}"/>
								</outline>
							<outline text="if (ixClose === -1) { //no closing brace: the rest is literal">
								<outline text="result += theText.slice (ix);"/>
								<outline text="break;"/>
								<outline text="}"/>
								</outline>
							<outline text="const macroText = theText.slice (ix + 1, ixClose);"/>
							<outline text="var expansion;"/>
							<outline text="try {">
								<outline text="const statements = environment.parseScript ([{level: 0, text: macroText, flComment: false}]);"/>
								<outline text="const value = environment.evaluateWithScopes (statements, scopeTables);"/>
								<outline text="expansion = ((value === undefined) || (value === true)) ? &quot;&quot; : String (value);"/>
								<outline text="}"/>
								</outline>
							<outline text="catch (err) {">
								<outline text="expansion = &quot;[Macro error: &quot; + err.message + &quot;]&quot;;"/>
								<outline text="}"/>
								</outline>
							<outline text="result += expansion;"/>
							<outline text="ix = ixClose + 1;"/>
							<outline text="}"/>
							</outline>
						<outline text="return (result);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;html.getpref&quot;] = function (args, environment) {">
						<outline text="/*  A page-build preference: the page table answers first (directives">
							<outline text="land there), then user.html.prefs, then false.  */"/>
							</outline>
						<outline text="const prefName = String (args [0]).toLowerCase ();"/>
						<outline text="const adrPageTable = args [1];"/>
						<outline text="function lookIn (theTable) {">
							<outline text="if ((theTable === undefined) || (theTable === null) || (typeof theTable !== &quot;object&quot;)) {">
								<outline text="return (undefined);"/>
								<outline text="}"/>
								</outline>
							<outline text="var found;"/>
							<outline text="Object.keys (theTable).forEach (function (key) {">
								<outline text="if ((found === undefined) &amp;&amp; (key.toLowerCase () === prefName)) {">
									<outline text="found = theTable [key];"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="return (found);"/>
							<outline text="}"/>
							</outline>
						<outline text="var value;"/>
						<outline text="if ((adrPageTable !== undefined) &amp;&amp; (adrPageTable !== null) &amp;&amp; (adrPageTable.flAddress === true)) {">
							<outline text="value = lookIn (adrPageTable.reference.get ());"/>
							<outline text="}"/>
							</outline>
						<outline text="if (value === undefined) {">
							<outline text="const userTable = environment.odb.user;"/>
							<outline text="if ((userTable !== undefined) &amp;&amp; (userTable.html !== undefined)) {">
								<outline text="value = lookIn (userTable.html.prefs);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="if (value === undefined) {">
							<outline text="return (false);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (value);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="function calendarBoundaryDay (args, flLast) {">
						<outline text="const adrCalendar = args [0];"/>
						<outline text="var calendarTable;"/>
						<outline text="if ((adrCalendar !== undefined) &amp;&amp; (adrCalendar !== null) &amp;&amp; (adrCalendar.flAddress === true)) {">
							<outline text="calendarTable = adrCalendar.reference.get ();"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((calendarTable === undefined) || (calendarTable === null) || (typeof calendarTable !== &quot;object&quot;)) {">
							<outline text="const message = &quot;Can't get the &quot; + (flLast ? &quot;last&quot; : &quot;first&quot;) + &quot; day because the calendar can't be reached.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="function numericKeys (theTable) {">
							<outline text="const keys = [];"/>
							<outline text="Object.keys (theTable).forEach (function (key) {">
								<outline text="if (/^\d+$/.test (key) &amp;&amp; (theTable [key] !== null) &amp;&amp; (typeof theTable [key] === &quot;object&quot;)) {">
									<outline text="keys.push (key);"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="keys.sort ();"/>
							<outline text="return (keys);"/>
							<outline text="}"/>
							</outline>
						<outline text="const years = numericKeys (calendarTable);"/>
						<outline text="if (years.length === 0) {">
							<outline text="const message = &quot;Can't get the &quot; + (flLast ? &quot;last&quot; : &quot;first&quot;) + &quot; day because the calendar is empty.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="const year = flLast ? years [years.length - 1] : years [0];"/>
						<outline text="const months = numericKeys (calendarTable [year]);"/>
						<outline text="const month = flLast ? months [months.length - 1] : months [0];"/>
						<outline text="const days = numericKeys (calendarTable [year] [month]);"/>
						<outline text="const day = flLast ? days [days.length - 1] : days [0];"/>
						<outline text="return (new Date (Number (year), Number (month) - 1, Number (day)));"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;mrcalendar.getfirstday&quot;] = function (args) {">
						<outline text="return (calendarBoundaryDay (args, false));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;mrcalendar.getlastday&quot;] = function (args) {">
						<outline text="return (calendarBoundaryDay (args, true));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="function callS3Helper (theCommand) { //8/5/26 by CC">
						<outline text=""/>
						<outline text="/*  Run one S3 operation in a child process and wait for it. UserTalk is">
							<outline text="synchronous and daveS3 is callback-based; this is the seam. The path"/>
							<outline text="map's s3 section supplies the default ACL and, when daveS3 doesn't"/>
							<outline text="live beside us, where to find the helper.  */"/>
							</outline>
						<outline text=""/>
						<outline text="const theSettings = (thePathMap.s3 === undefined) ? {} : thePathMap.s3;"/>
						<outline text="const pathHelper = (theSettings.pathHelper === undefined) ? (__dirname + &quot;/s3helper.js&quot;) : theSettings.pathHelper;"/>
						<outline text=""/>
						<outline text="var theAnswer;"/>
						<outline text="try {">
							<outline text="const theOutput = execFileSync (process.execPath, [pathHelper], {">
								<outline text="input: JSON.stringify (theCommand),"/>
								<outline text="encoding: &quot;utf8&quot;,"/>
								<outline text="maxBuffer: 64 * 1024 * 1024,"/>
								<outline text="cwd: (theSettings.folderHelper === undefined) ? path.dirname (pathHelper) : theSettings.folderHelper"/>
								<outline text="});"/>
								</outline>
							<outline text="theAnswer = JSON.parse (theOutput);"/>
							<outline text="}"/>
							</outline>
						<outline text="catch (err) {">
							<outline text="const message = &quot;Can't reach S3 because the helper failed: &quot; + err.message;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="if (theAnswer.flError === true) {">
							<outline text="const message = &quot;Can't &quot; + theCommand.verb + &quot; &quot; + theCommand.path + &quot; because &quot; + theAnswer.message;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (theAnswer.value);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;s3.newobject&quot;] = function (args) { //8/5/26 by CC -- s3.newObject (path, data, type, acl)">
						<outline text="const theSettings = (thePathMap.s3 === undefined) ? {} : thePathMap.s3;"/>
						<outline text="const theType = ((args [2] === undefined) || (args [2] === null)) ? undefined : String (args [2]);"/>
						<outline text="const theAcl = ((args [3] === undefined) || (args [3] === null)) ? theSettings.defaultAcl : String (args [3]);"/>
						<outline text="return (callS3Helper ({verb: &quot;newobject&quot;, path: String (args [0]), data: String (args [1]), type: theType, acl: theAcl}));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;s3.getobject&quot;] = function (args) { //8/5/26 by CC">
						<outline text="return (callS3Helper ({verb: &quot;getobject&quot;, path: String (args [0])}));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;s3.objectexists&quot;] = function (args) { //8/5/26 by CC">
						<outline text="return (callS3Helper ({verb: &quot;objectexists&quot;, path: String (args [0])}));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="function deepCopyValue (theValue) { //8/5/26 by CC -- a table copies structurally; everything else is a value">
						<outline text=""/>
						<outline text="if ((theValue === undefined) || (theValue === null) || (typeof theValue !== &quot;object&quot;)) {">
							<outline text="return (theValue);"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((theValue.flAddress === true) || (theValue.flOdbScript === true) || (theValue.flWpText === true) || (theValue.flOdbSqlTable === true) || Array.isArray (theValue) || (theValue instanceof Date) || (theValue.type !== undefined)) {">
							<outline text="return (theValue);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="const seen = new Map ();"/>
						<outline text="function copyTable (theTable) {">
							<outline text="if (seen.has (theTable)) {">
								<outline text="return (seen.get (theTable));"/>
								<outline text="}"/>
								</outline>
							<outline text="const theCopy = {};"/>
							<outline text="seen.set (theTable, theCopy);"/>
							<outline text="Object.keys (theTable).forEach (function (theKey) {">
								<outline text="theCopy [theKey] = deepCopyValue (theTable [theKey]);"/>
								<outline text="});"/>
								</outline>
							<outline text="return (theCopy);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (copyTable (theValue));"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;table.copy&quot;] = function (args) { //8/5/26 by CC -- table.copy (adrSource, adrDest)">
						<outline text=""/>
						<outline text="/*  Copy what's at one address to another. The copy is structural, the way">
							<outline text="Frontier's is: the destination is independent of the source, so editing"/>
							<outline text="one never shows up in the other.  */"/>
							</outline>
						<outline text=""/>
						<outline text="const adrSource = args [0];"/>
						<outline text="const adrDest = args [1];"/>
						<outline text="if ((adrSource === undefined) || (adrSource === null) || (adrSource.flAddress !== true)) {">
							<outline text="const message = &quot;Can't copy because the first parameter isn't an address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((adrDest === undefined) || (adrDest === null) || (adrDest.flAddress !== true)) {">
							<outline text="const message = &quot;Can't copy because the second parameter isn't an address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="adrDest.reference.set (deepCopyValue (adrSource.reference.get ()));"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;html.neutermacros&quot;] = function (args) { //8/5/26 by CC">
						<outline text=""/>
						<outline text="/*  html.neuterMacros (s, adrLegalMacros) -- defang the macros in text that">
							<outline text="came from outside, leaving the ones the site has declared legal."/>
							<outline text="Manila's own manilaSuite.unTaint says what neutering is: &quot;All {"/>
							<outline text="characters are translated to &amp;#123;&quot;, which stops the macro from"/>
							<outline text="expanding. The second parameter is the address of a table whose entry"/>
							<outline text="names are the macros allowed to survive.  */"/>
							</outline>
						<outline text=""/>
						<outline text="const theText = String (args [0]);"/>
						<outline text="const theAddress = args [1];"/>
						<outline text="var theLegal = undefined;"/>
						<outline text="if ((theAddress !== undefined) &amp;&amp; (theAddress !== null) &amp;&amp; (theAddress.flAddress === true)) {">
							<outline text="theLegal = theAddress.reference.get ();"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="if ((theAddress !== null) &amp;&amp; (typeof theAddress === &quot;object&quot;)) {">
								<outline text="theLegal = theAddress;"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="function flIsLegal (theName) {">
							<outline text="if ((theLegal === undefined) || (theLegal === null) || (typeof theLegal !== &quot;object&quot;)) {">
								<outline text="return (false);"/>
								<outline text="}"/>
								</outline>
							<outline text="const theLower = theName.toLowerCase ();"/>
							<outline text="var flFound = false;"/>
							<outline text="Object.keys (theLegal).forEach (function (theKey) {">
								<outline text="if (theKey.toLowerCase () === theLower) {">
									<outline text="flFound = true;"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="return (flFound);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="var theResult = &quot;&quot;;"/>
						<outline text="var ixScan = 0;"/>
						<outline text="while (ixScan &lt; theText.length) {">
							<outline text="const theChar = theText.charAt (ixScan);"/>
							<outline text="if (theChar === &quot;{&quot;) {">
								<outline text="var ixName = ixScan + 1;"/>
								<outline text="while ((ixName &lt; theText.length) &amp;&amp; (/[A-Za-z0-9_.]/.test (theText.charAt (ixName)))) {">
									<outline text="ixName++;"/>
									<outline text="}"/>
									</outline>
								<outline text="const theName = theText.slice (ixScan + 1, ixName);"/>
								<outline text="if ((theName.length &gt; 0) &amp;&amp; flIsLegal (theName)) {">
									<outline text="theResult += theChar;"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="theResult += &quot;&amp;#123;&quot;;"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="theResult += theChar;"/>
								<outline text="}"/>
								</outline>
							<outline text="ixScan++;"/>
							<outline text="}"/>
							</outline>
						<outline text="return (theResult);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.set&quot;] = function (args) { //8/5/26 by CC -- date.set (day, month, year, hour, minute, second), the inverse of date.get">
						<outline text="const theDay = (args [0] === undefined) ? 1 : Number (args [0]);"/>
						<outline text="const theMonth = (args [1] === undefined) ? 1 : Number (args [1]);"/>
						<outline text="const theYear = (args [2] === undefined) ? 1904 : Number (args [2]);"/>
						<outline text="const theHour = (args [3] === undefined) ? 0 : Number (args [3]);"/>
						<outline text="const theMinute = (args [4] === undefined) ? 0 : Number (args [4]);"/>
						<outline text="const theSecond = (args [5] === undefined) ? 0 : Number (args [5]);"/>
						<outline text="return (new Date (theYear, theMonth - 1, theDay, theHour, theMinute, theSecond));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;mrcalendar.getmostrecentday&quot;] = function (args) { //8/5/26 by CC">
						<outline text=""/>
						<outline text="/*  The day at or before d that the calendar actually has, as a date at">
							<outline text="midnight. The spec is written out in the old-code comment inside"/>
							<outline text="mainResponder.calendar.getMostRecentDay: walk backwards from d until"/>
							<outline text="a day exists, and fail when the calendar holds nothing that early."/>
							<outline text="The old script walked one day at a time; picking the greatest day"/>
							<outline text="that isn't after d gives the same answer without the walk.  */"/>
							</outline>
						<outline text=""/>
						<outline text="const adrCalendar = args [0];"/>
						<outline text="var calendarTable;"/>
						<outline text="if ((adrCalendar !== undefined) &amp;&amp; (adrCalendar !== null) &amp;&amp; (adrCalendar.flAddress === true)) {">
							<outline text="calendarTable = adrCalendar.reference.get ();"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="calendarTable = adrCalendar;"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((calendarTable === undefined) || (calendarTable === null) || (typeof calendarTable !== &quot;object&quot;)) {">
							<outline text="const message = &quot;Can't get the most recent day because the calendar can't be reached.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="const theDate = (args [1] === undefined) ? new Date () : new Date (args [1]);"/>
						<outline text="const theLimit = new Date (theDate.getFullYear (), theDate.getMonth (), theDate.getDate ()).getTime ();"/>
						<outline text=""/>
						<outline text="function numericKeys (theTable) {">
							<outline text="const theKeys = [];"/>
							<outline text="Object.keys (theTable).forEach (function (theKey) {">
								<outline text="if (/^\d+$/.test (theKey) &amp;&amp; (theTable [theKey] !== null) &amp;&amp; (typeof theTable [theKey] === &quot;object&quot;)) {">
									<outline text="theKeys.push (theKey);"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="theKeys.sort ();"/>
							<outline text="return (theKeys);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="var theBest = undefined;"/>
						<outline text="numericKeys (calendarTable).forEach (function (theYear) {">
							<outline text="numericKeys (calendarTable [theYear]).forEach (function (theMonth) {">
								<outline text="numericKeys (calendarTable [theYear] [theMonth]).forEach (function (theDay) {">
									<outline text="const theCandidate = new Date (Number (theYear), Number (theMonth) - 1, Number (theDay)).getTime ();"/>
									<outline text="if (theCandidate &lt;= theLimit) {">
										<outline text="if ((theBest === undefined) || (theCandidate &gt; theBest)) {">
											<outline text="theBest = theCandidate;"/>
											<outline text="}"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text=""/>
						<outline text="if (theBest === undefined) {">
							<outline text="const message = &quot;Can't get the most recent day in the calendar because the calendar doesn't contain any elements before &quot; + theDate + &quot;.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (new Date (theBest));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;html.neutertags&quot;] = function (args) {">
						<outline text="/*  The kernel primitive that defangs markup; the policy lives in">
							<outline text="mainResponder.neuterText, which calls this. Pass-through for"/>
							<outline text="now -- fine for a local sandbox, not for a public server.  */"/>
							</outline>
						<outline text="return (String (args [0]));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;html.getpagetableaddress&quot;] = function (args, environment) {">
						<outline text="/*  The current page table: the address registered per thread at">
							<outline text="system.temp.pageTableAddresses -- the webserver registers the"/>
							<outline text="request's param table, and buildObject registers the table it"/>
							<outline text="renders into. One thread here, so one slot. With nothing"/>
							<outline text="registered, a scratch table stands in, the way an editor-run"/>
							<outline text="macro gets one.  */"/>
							</outline>
						<outline text="const systemTemp = environment.odb.system.temp;"/>
						<outline text="if (systemTemp.pageTableAddresses !== undefined) {">
							<outline text="const registered = systemTemp.pageTableAddresses [&quot;1&quot;];"/>
							<outline text="if ((registered !== undefined) &amp;&amp; (registered !== null) &amp;&amp; (registered.flAddress === true)) {">
								<outline text="return (registered);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="if (systemTemp.currentPageTable === undefined) {">
							<outline text="systemTemp.currentPageTable = {};"/>
							<outline text="}"/>
							</outline>
						<outline text="return ({">
							<outline text="flAddress: true,"/>
							<outline text="pathText: &quot;system.temp.currentPageTable&quot;,"/>
							<outline text="reference: {">
								<outline text="get: function () {">
									<outline text="return (environment.odb.system.temp.currentPageTable);"/>
									<outline text="},"/>
									</outline>
								<outline text="set: function (theValue) {">
									<outline text="environment.odb.system.temp.currentPageTable = theValue;"/>
									<outline text="},"/>
									</outline>
								<outline text="remove: function () {">
									<outline text="delete environment.odb.system.temp.currentPageTable;"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;html.deletepagetableaddress&quot;] = function (args, environment) {">
						<outline text="const systemTemp = environment.odb.system.temp;"/>
						<outline text="if (systemTemp.pageTableAddresses !== undefined) {">
							<outline text="delete systemTemp.pageTableAddresses [&quot;1&quot;];"/>
							<outline text="}"/>
							</outline>
						<outline text="delete systemTemp.currentPageTable;"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.new&quot;] = function (args, environment) {">
						<outline text="return (verbs [&quot;new&quot;] (args, environment));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.msg&quot;] = function (args, environment) {">
						<outline text="return (verbs [&quot;msg&quot;] (args, environment));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.delete&quot;] = function (args, environment) {">
						<outline text="return (verbs [&quot;delete&quot;] (args, environment));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.sizeof&quot;] = function (args, environment) {">
						<outline text="return (verbs [&quot;sizeof&quot;] (args, environment));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.defined&quot;] = function (args, environment) {">
						<outline text="return (verbs [&quot;defined&quot;] (args, environment));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.typeof&quot;] = function (args, environment) {">
						<outline text="return (verbs [&quot;typeof&quot;] (args, environment));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.nameof&quot;] = function (args, environment) {">
						<outline text="return (verbs [&quot;nameof&quot;] (args, environment));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.string&quot;] = function (args, environment) {">
						<outline text="return (verbs [&quot;string&quot;] (args, environment));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.number&quot;] = function (args, environment) {">
						<outline text="return (verbs [&quot;number&quot;] (args, environment));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.date&quot;] = function (args, environment) {">
						<outline text="return (verbs [&quot;date&quot;] (args, environment));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.char&quot;] = function (args, environment) {">
						<outline text="return (verbs [&quot;char&quot;] (args, environment));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.random&quot;] = function (args, environment) {">
						<outline text="return (verbs [&quot;random&quot;] (args, environment));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.scripterror&quot;] = function (args, environment) {">
						<outline text="return (verbs [&quot;scripterror&quot;] (args, environment));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.list&quot;] = function (args, environment) {">
						<outline text="return (verbs [&quot;list&quot;] (args, environment));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.address&quot;] = function (args, environment) { //address coercion: text becomes an address, an address passes through">
						<outline text="const theValue = args [0];"/>
						<outline text="if ((theValue !== undefined) &amp;&amp; (theValue !== null) &amp;&amp; (theValue.flAddress === true)) {">
							<outline text="return (theValue);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (verbs [&quot;string.parseaddress&quot;] ([String (theValue)], environment));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;address&quot;] = verbs [&quot;lang.address&quot;];"/>
					<outline text=""/>
					<outline text="verbs [&quot;lang.long&quot;] = function (args) {">
						<outline text="return (Math.trunc (Number (args [0])));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;long&quot;] = verbs [&quot;lang.long&quot;];"/>
					<outline text=""/>
					<outline text="verbs [&quot;lang.double&quot;] = function (args) {">
						<outline text="return (Number (args [0]));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;double&quot;] = verbs [&quot;lang.double&quot;];"/>
					<outline text=""/>
					<outline text="verbs [&quot;lang.abs&quot;] = function (args) {">
						<outline text="return (Math.abs (Number (args [0])));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;abs&quot;] = verbs [&quot;lang.abs&quot;];"/>
					<outline text=""/>
					<outline text="verbs [&quot;lang.mod&quot;] = function (args) {">
						<outline text="return (Number (args [0]) % Number (args [1]));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;lang.filespec&quot;] = function (args) {">
						<outline text="/*  A filespec is a value that knows it's a file path. It coerces to">
							<outline text="its path in string context, so path arithmetic just works.  */"/>
							</outline>
						<outline text="return ({">
							<outline text="flFilespec: true,"/>
							<outline text="path: String (args [0]),"/>
							<outline text="toString: function () {">
								<outline text="return (this.path);"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;filespec&quot;] = verbs [&quot;lang.filespec&quot;];"/>
					<outline text=""/>
					<outline text="verbs [&quot;list&quot;] = function (args) { //coerce to a list">
						<outline text="const theValue = args [0];"/>
						<outline text="if (Array.isArray (theValue)) {">
							<outline text="return (theValue);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (theValue === undefined) {">
							<outline text="return ([]);"/>
							<outline text="}"/>
							</outline>
						<outline text="return ([theValue]);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;string.popfilefromaddress&quot;] = function (args) { //the address's path with the database part popped">
						<outline text="const theAddress = args [0];"/>
						<outline text="if ((theAddress !== undefined) &amp;&amp; (theAddress !== null) &amp;&amp; (theAddress.flAddress === true)) {">
							<outline text="var pathText = theAddress.pathText;"/>
							<outline text="if (pathText.indexOf (&quot;(deref).&quot;) === 0) {">
								<outline text="pathText = pathText.slice (&quot;(deref).&quot;.length);"/>
								<outline text="}"/>
								</outline>
							<outline text="return (pathText);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (String (theAddress));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date&quot;] = function (args) {">
						<outline text="if (args.length === 0) {">
							<outline text="return (new Date ());"/>
							<outline text="}"/>
							</outline>
						<outline text="return (new Date (args [0]));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;clock.ticks&quot;] = function (args) {">
						<outline text="return (Math.floor (Date.now () * 60 / 1000)); //Frontier ticks are 60ths of a second"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;file.rename&quot;] = function (args) {">
						<outline text="const from = macToReal (args [0]);"/>
						<outline text="fs.renameSync (from, path.join (path.dirname (from), String (args [1])));"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;clock.now&quot;] = function (args) {">
						<outline text="return (new Date ());"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.netstandardstring&quot;] = function (args) {">
						<outline text="return (new Date (args [0]).toUTCString ());"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.versionlessthan&quot;] = function (args) { //compare version strings like &quot;7.0d8&quot; component-wise">
						<outline text="function componentsOf (theVersion) {">
							<outline text="const result = [];"/>
							<outline text="String (theVersion).split (&quot;.&quot;).forEach (function (part) {">
								<outline text="const match = part.match (/^\d+/);"/>
								<outline text="result.push ((match === null) ? 0 : Number (match [0]));"/>
								<outline text="});"/>
								</outline>
							<outline text="return (result);"/>
							<outline text="}"/>
							</outline>
						<outline text="const left = componentsOf (args [0]);"/>
						<outline text="const right = componentsOf (args [1]);"/>
						<outline text="var ixPart;"/>
						<outline text="for (ixPart = 0; ixPart &lt; Math.max (left.length, right.length); ixPart++) {">
							<outline text="const a = left [ixPart] || 0;"/>
							<outline text="const b = right [ixPart] || 0;"/>
							<outline text="if (a &lt; b) {">
								<outline text="return (true);"/>
								<outline text="}"/>
								</outline>
							<outline text="if (a &gt; b) {">
								<outline text="return (false);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="return (false);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.prevmonth&quot;] = function (args) {">
						<outline text="const theDate = new Date (args [0]);"/>
						<outline text="return (new Date (theDate.getFullYear (), theDate.getMonth () - 1, Math.min (theDate.getDate (), 28)));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.nextmonth&quot;] = function (args) {">
						<outline text="const theDate = new Date (args [0]);"/>
						<outline text="return (new Date (theDate.getFullYear (), theDate.getMonth () + 1, Math.min (theDate.getDate (), 28)));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.firstofmonth&quot;] = function (args) {">
						<outline text="const theDate = new Date (args [0]);"/>
						<outline text="return (new Date (theDate.getFullYear (), theDate.getMonth (), 1));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.lastofmonth&quot;] = function (args) {">
						<outline text="const theDate = new Date (args [0]);"/>
						<outline text="return (new Date (theDate.getFullYear (), theDate.getMonth () + 1, 0));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.daysinmonth&quot;] = function (args) {">
						<outline text="const theDate = new Date (args [0]);"/>
						<outline text="return (new Date (theDate.getFullYear (), theDate.getMonth () + 1, 0).getDate ());"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.yesterday&quot;] = function (args) {">
						<outline text="return (new Date (Date.now () - (24 * 60 * 60 * 1000)));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.tomorrow&quot;] = function (args) {">
						<outline text="return (new Date (Date.now () + (24 * 60 * 60 * 1000)));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.year&quot;] = function (args) {">
						<outline text="return (new Date (args [0]).getFullYear ());"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.month&quot;] = function (args) {">
						<outline text="return (new Date (args [0]).getMonth () + 1);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.day&quot;] = function (args) {">
						<outline text="return (new Date (args [0]).getDate ());"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.hour&quot;] = function (args) {">
						<outline text="return (new Date (args [0]).getHours ());"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.minute&quot;] = function (args) {">
						<outline text="return (new Date (args [0]).getMinutes ());"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.second&quot;] = function (args) {">
						<outline text="return (new Date (args [0]).getSeconds ());"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;date.dayofweek&quot;] = function (args) {">
						<outline text="return (new Date (args [0]).getDay () + 1); //1-based, Sunday first"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;speaker.beep&quot;] = function (args) {">
						<outline text="return (true); //the trace line is the beep"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;dialog.alert&quot;] = function (args) {">
						<outline text="return (true); //the trace line is the dialog"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;dialog.notify&quot;] = verbs [&quot;dialog.alert&quot;];"/>
					<outline text=""/>
					<outline text="//stubs: recorded in the trace by the evaluator, loud about what they are"/>
					<outline text=""/>
					<outline text="const stubNames = [">
						<outline text="&quot;nodeeditorsuite.savesourceopmltorepo&quot;, &quot;nodeeditorsuite.building.copyfile&quot;,"/>
						<outline text="&quot;nodeeditorsuite.utilities.deletedsstorefiles&quot;,"/>
						<outline text="&quot;tcp.httpreadurl&quot;,"/>
						<outline text="&quot;op.xmltooutline&quot;, &quot;op.firstsummit&quot;, &quot;op.go&quot;, &quot;op.insert&quot;,"/>
						<outline text="&quot;op.deleteline&quot;, &quot;op.getlinetext&quot;, &quot;op.setlinetext&quot;, &quot;op.wipe&quot;, &quot;op.sort&quot;,"/>
						<outline text="&quot;json.compile&quot;, &quot;json.decompile&quot;,"/>
						<outline text="&quot;window.frontmost&quot;, &quot;op.getcursor&quot;, &quot;tcp.dns.getdottedid&quot;,"/>
						<outline text="&quot;export.sendobject&quot;, &quot;file.getdatepath&quot;,"/>
						<outline text="&quot;op.setcursor&quot;, &quot;fatpages.buildfileatts&quot;"/>
						<outline text="];"/>
						</outline>
					<outline text=""/>
					<outline text="stubNames.forEach (function (name) {">
						<outline text="verbs [name] = function (args) {">
							<outline text="return ({flStub: true, verb: name});"/>
							<outline text="};"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text=""/>
					<outline text="/*  The xml verbs, Frontier's XML-tables convention: an element is a">
						<outline text="table entry whose name is &quot;NNNNN\tname&quot; (numbered for document"/>
						<outline text="order), attributes live in a &quot;/atts&quot; subtable, character data in a"/>
						<outline text="&quot;/pcdata&quot; entry.  */"/>
						</outline>
					<outline text=""/>
					<outline text="function xmlEntityEncode (theString) {">
						<outline text="/*  8/4/26 by CC -- &quot;&gt;&quot; stays raw, matching Frontier: nodeEditorSuite's">
							<outline text="title replacement searches for &quot;&amp;lt;%title%&gt;&quot; with a bare &quot;&gt;&quot;, so an"/>
							<outline text="encoder that touched &quot;&gt;&quot; would break every glossary substitution in"/>
							<outline text="generated opml.  */"/>
							</outline>
						<outline text="return (String (theString)">
							<outline text=".split (&quot;&amp;&quot;).join (&quot;&amp;amp;&quot;)"/>
							<outline text=".split (&quot;&lt;&quot;).join (&quot;&amp;lt;&quot;)"/>
							<outline text=".split (&quot;\&quot;&quot;).join (&quot;&amp;quot;&quot;));"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function xmlEntityDecode (theString) {">
						<outline text="return (String (theString)">
							<outline text=".split (&quot;&amp;lt;&quot;).join (&quot;&lt;&quot;)"/>
							<outline text=".split (&quot;&amp;gt;&quot;).join (&quot;&gt;&quot;)"/>
							<outline text=".split (&quot;&amp;quot;&quot;).join (&quot;\&quot;&quot;)"/>
							<outline text=".split (&quot;&amp;apos;&quot;).join (&quot;'&quot;)"/>
							<outline text=".split (&quot;&amp;amp;&quot;).join (&quot;&amp;&quot;));"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function xmlDisplayName (theName) { //strip the &quot;NNNNN\t&quot; ordering prefix">
						<outline text="const ixTab = String (theName).indexOf (&quot;\t&quot;);"/>
						<outline text="if (ixTab === -1) {">
							<outline text="return (String (theName));"/>
							<outline text="}"/>
							</outline>
						<outline text="return (String (theName).slice (ixTab + 1));"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function xmlNumberedName (theCounter, theName) {">
						<outline text="var counterText = String (theCounter);"/>
						<outline text="while (counterText.length &lt; 5) {">
							<outline text="counterText = &quot;0&quot; + counterText;"/>
							<outline text="}"/>
							</outline>
						<outline text="return (counterText + &quot;\t&quot; + theName);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function xmlCompileText (theText) {">
						<outline text=""/>
						<outline text="/*  A small well-formed-XML parser, enough for the documents Manila">
							<outline text="writes for itself: elements, attributes, pcdata, comments and"/>
							<outline text="processing instructions skipped.  */"/>
							</outline>
						<outline text=""/>
						<outline text="var ix = 0;"/>
						<outline text="var counter = 0;"/>
						<outline text=""/>
						<outline text="function skipUntil (theMarker) {">
							<outline text="const ixFound = theText.indexOf (theMarker, ix);"/>
							<outline text="ix = (ixFound === -1) ? theText.length : ixFound + theMarker.length;"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="function parseElement () { //ix is at &quot;&lt;&quot; of an open tag; returns {name, table}">
							<outline text=""/>
							<outline text="/*  8/4/26 by CC -- the tag ends at the first &quot;&gt;&quot; OUTSIDE quotes:">
								<outline text="attribute values legally carry raw &quot;&gt;&quot; (Frontier's encoder leaves"/>
								<outline text="it raw), so indexOf would cut the tag mid-attribute.  */"/>
								</outline>
							<outline text=""/>
							<outline text="var ixScanEnd = ix + 1;"/>
							<outline text="var flInQuote = false;"/>
							<outline text="while (ixScanEnd &lt; theText.length) {">
								<outline text="const ch = theText.charAt (ixScanEnd);"/>
								<outline text="if (ch === &quot;\&quot;&quot;) {">
									<outline text="flInQuote = !flInQuote;"/>
									<outline text="}"/>
									</outline>
								<outline text="if ((ch === &quot;&gt;&quot;) &amp;&amp; !flInQuote) {">
									<outline text="break;"/>
									<outline text="}"/>
									</outline>
								<outline text="ixScanEnd++;"/>
								<outline text="}"/>
								</outline>
							<outline text="const ixEnd = ixScanEnd;"/>
							<outline text="var tagText = theText.slice (ix + 1, ixEnd);"/>
							<outline text="const flSelfClosing = tagText.endsWith (&quot;/&quot;);"/>
							<outline text="if (flSelfClosing) {">
								<outline text="tagText = tagText.slice (0, tagText.length - 1);"/>
								<outline text="}"/>
								</outline>
							<outline text="ix = ixEnd + 1;"/>
							<outline text=""/>
							<outline text="const nameMatch = tagText.match (/^[^\s]+/);"/>
							<outline text="const elementName = nameMatch [0];"/>
							<outline text="const theTable = {};"/>
							<outline text=""/>
							<outline text="const attsPattern = /([A-Za-z_][\w:.-]*)\s*=\s*&quot;([^&quot;]*)&quot;/g;"/>
							<outline text="var attsMatch;"/>
							<outline text="const atts = {};"/>
							<outline text="var ctAtts = 0;"/>
							<outline text="while ((attsMatch = attsPattern.exec (tagText)) !== null) {">
								<outline text="atts [attsMatch [1]] = xmlEntityDecode (attsMatch [2]);"/>
								<outline text="ctAtts++;"/>
								<outline text="}"/>
								</outline>
							<outline text="if (ctAtts &gt; 0) {">
								<outline text="theTable [&quot;/atts&quot;] = atts;"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="if (flSelfClosing) {">
								<outline text="return ({name: elementName, table: theTable});"/>
								<outline text="}"/>
								</outline>
							<outline text=""/>
							<outline text="var pcdata = &quot;&quot;;"/>
							<outline text="while (ix &lt; theText.length) {">
								<outline text="if (theText.charAt (ix) === &quot;&lt;&quot;) {">
									<outline text="if (theText.slice (ix, ix + 4) === &quot;&lt;!--&quot;) {">
										<outline text="skipUntil (&quot;--&gt;&quot;);"/>
										<outline text="continue;"/>
										<outline text="}"/>
										</outline>
									<outline text="if (theText.slice (ix, ix + 9).toLowerCase () === &quot;&lt;![cdata[&quot;) {">
										<outline text="const ixCdataEnd = theText.indexOf (&quot;]]&gt;&quot;, ix);"/>
										<outline text="pcdata += theText.slice (ix + 9, ixCdataEnd);"/>
										<outline text="ix = ixCdataEnd + 3;"/>
										<outline text="continue;"/>
										<outline text="}"/>
										</outline>
									<outline text="if (theText.charAt (ix + 1) === &quot;/&quot;) { //our close tag">
										<outline text="skipUntil (&quot;&gt;&quot;);"/>
										<outline text="break;"/>
										<outline text="}"/>
										</outline>
									<outline text="if ((theText.charAt (ix + 1) === &quot;?&quot;) || (theText.charAt (ix + 1) === &quot;!&quot;)) {">
										<outline text="skipUntil (&quot;&gt;&quot;);"/>
										<outline text="continue;"/>
										<outline text="}"/>
										</outline>
									<outline text="counter++;"/>
									<outline text="const child = parseElement ();"/>
									<outline text="theTable [xmlNumberedName (counter, child.name)] = child.table;"/>
									<outline text="continue;"/>
									<outline text="}"/>
									</outline>
								<outline text="pcdata += theText.charAt (ix);"/>
								<outline text="ix++;"/>
								<outline text="}"/>
								</outline>
							<outline text="if (pcdata.trim ().length &gt; 0) {">
								<outline text="theTable [&quot;/pcdata&quot;] = xmlEntityDecode (pcdata.trim ());"/>
								<outline text="}"/>
								</outline>
							<outline text="return ({name: elementName, table: theTable});"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="/*  Walk the prolog to the root element. 8/4/26 by CC: processing">
							<outline text="instructions are CAPTURED as entries, the way Frontier's xml.compile"/>
							<outline text="stores them -- &quot;?xml&quot; with the attributes as plain entries -- so a"/>
							<outline text="structure round-trips through decompile with its declaration."/>
							<outline text="Comments and doctypes are still skipped.  */"/>
							</outline>
						<outline text=""/>
						<outline text="const thePis = [];"/>
						<outline text="while (ix &lt; theText.length) {">
							<outline text="if (theText.charAt (ix) === &quot;&lt;&quot;) {">
								<outline text="if (theText.charAt (ix + 1) === &quot;?&quot;) {">
									<outline text="const ixEnd = theText.indexOf (&quot;&gt;&quot;, ix);"/>
									<outline text="var piText = theText.slice (ix + 2, (ixEnd === -1) ? theText.length : ixEnd);"/>
									<outline text="if (piText.endsWith (&quot;?&quot;)) {">
										<outline text="piText = piText.slice (0, piText.length - 1);"/>
										<outline text="}"/>
										</outline>
									<outline text="const piName = (piText.match (/^[^\s]*/)) [0];"/>
									<outline text="const piTable = {};"/>
									<outline text="const piAttsPattern = /([A-Za-z_][\w:.-]*)\s*=\s*&quot;([^&quot;]*)&quot;/g;"/>
									<outline text="var piMatch;"/>
									<outline text="while ((piMatch = piAttsPattern.exec (piText)) !== null) {">
										<outline text="piTable [piMatch [1]] = xmlEntityDecode (piMatch [2]);"/>
										<outline text="}"/>
										</outline>
									<outline text="if (piName.length &gt; 0) {">
										<outline text="thePis.push ({name: &quot;?&quot; + piName, table: piTable});"/>
										<outline text="}"/>
										</outline>
									<outline text="ix = (ixEnd === -1) ? theText.length : ixEnd + 1;"/>
									<outline text="continue;"/>
									<outline text="}"/>
									</outline>
								<outline text="if (theText.charAt (ix + 1) === &quot;!&quot;) {">
									<outline text="skipUntil (&quot;&gt;&quot;);"/>
									<outline text="continue;"/>
									<outline text="}"/>
									</outline>
								<outline text="break;"/>
								<outline text="}"/>
								</outline>
							<outline text="ix++;"/>
							<outline text="}"/>
							</outline>
						<outline text="if (ix &gt;= theText.length) {">
							<outline text="if (theText.trim ().length === 0) {">
								<outline text="return ({}); //nothing to compile: an empty structure, which the callers' emptiness guards understand"/>
								<outline text="}"/>
								</outline>
							<outline text="const message = &quot;Can't compile the XML because no root element was found in \&quot;&quot; + theText.slice (0, 80) + &quot;\&quot;.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="const compiled = {};"/>
						<outline text="thePis.forEach (function (pi) {">
							<outline text="counter++;"/>
							<outline text="compiled [xmlNumberedName (counter, pi.name)] = pi.table;"/>
							<outline text="});"/>
							</outline>
						<outline text="counter++;"/>
						<outline text="const root = parseElement ();"/>
						<outline text="compiled [xmlNumberedName (counter, root.name)] = root.table;"/>
						<outline text="return (compiled);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;xml.compile&quot;] = function (args) {">
						<outline text="const compiled = xmlCompileText (String (args [0]));"/>
						<outline text="const theAddress = args [1];"/>
						<outline text="if ((theAddress !== undefined) &amp;&amp; (theAddress !== null) &amp;&amp; (theAddress.flAddress === true)) {">
							<outline text="theAddress.reference.set (compiled);"/>
							<outline text="return (true);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (compiled);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;xml.converttodisplayname&quot;] = function (args) {">
						<outline text="return (xmlDisplayName (args [0]));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;xml.entityencode&quot;] = function (args) {">
						<outline text="return (xmlEntityEncode (args [0]));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;xml.entitydecode&quot;] = function (args) {">
						<outline text="return (xmlEntityDecode (args [0]));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="function xmlChildEntry (theTable, theName) { //find a child element by display name, case-insensitive">
						<outline text="const lowerName = String (theName).toLowerCase ();"/>
						<outline text="var foundKey;"/>
						<outline text="Object.keys (theTable).forEach (function (key) {">
							<outline text="if ((foundKey === undefined) &amp;&amp; (xmlDisplayName (key).toLowerCase () === lowerName)) {">
								<outline text="foundKey = key;"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="return (foundKey);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;xml.getaddress&quot;] = function (args) { //xml.getAddress (@struct, name) -&gt; address of the named child element">
						<outline text="const theAddress = args [0];"/>
						<outline text="const theName = String (args [1]);"/>
						<outline text="if ((theAddress === undefined) || (theAddress.flAddress !== true)) {">
							<outline text="const message = &quot;Can't get the XML address because the first parameter isn't an address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="const theTable = theAddress.reference.get ();"/>
						<outline text="if ((theTable === undefined) || (theTable === null) || (typeof theTable !== &quot;object&quot;)) {">
							<outline text="const message = &quot;Can't get the XML address of &quot; + theName + &quot; because the structure can't be reached.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="const foundKey = xmlChildEntry (theTable, theName);"/>
						<outline text="if (foundKey === undefined) {">
							<outline text="const message = &quot;Can't get the XML address of &quot; + theName + &quot; because there is no element with that name.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="return ({">
							<outline text="flAddress: true,"/>
							<outline text="pathText: theAddress.pathText + &quot;.[\&quot;&quot; + foundKey + &quot;\&quot;]&quot;,"/>
							<outline text="reference: {">
								<outline text="get: function () {">
									<outline text="return (theTable [foundKey]);"/>
									<outline text="},"/>
									</outline>
								<outline text="set: function (theValue) {">
									<outline text="theTable [foundKey] = theValue;"/>
									<outline text="},"/>
									</outline>
								<outline text="remove: function () {">
									<outline text="delete theTable [foundKey];"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;xml.getaddresslist&quot;] = function (args) { //every child element with that name, as addresses">
						<outline text="const theAddress = args [0];"/>
						<outline text="const theName = String (args [1]).toLowerCase ();"/>
						<outline text="if ((theAddress === undefined) || (theAddress.flAddress !== true)) {">
							<outline text="const message = &quot;Can't get the XML address list because the first parameter isn't an address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="const theTable = theAddress.reference.get ();"/>
						<outline text="const result = [];"/>
						<outline text="if ((theTable === undefined) || (theTable === null) || (typeof theTable !== &quot;object&quot;)) {">
							<outline text="return (result);"/>
							<outline text="}"/>
							</outline>
						<outline text="Object.keys (theTable).forEach (function (key) {">
							<outline text="if (xmlDisplayName (key).toLowerCase () !== theName) {">
								<outline text="return;"/>
								<outline text="}"/>
								</outline>
							<outline text="result.push ({">
								<outline text="flAddress: true,"/>
								<outline text="pathText: theAddress.pathText + &quot;.[\&quot;&quot; + key + &quot;\&quot;]&quot;,"/>
								<outline text="reference: {">
									<outline text="get: function () {">
										<outline text="return (theTable [key]);"/>
										<outline text="},"/>
										</outline>
									<outline text="set: function (theValue) {">
										<outline text="theTable [key] = theValue;"/>
										<outline text="},"/>
										</outline>
									<outline text="remove: function () {">
										<outline text="delete theTable [key];"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="return (result);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;xml.getvalue&quot;] = function (args) { //xml.getValue (@struct, name) -&gt; the named child's pcdata">
						<outline text="const childAddress = verbs [&quot;xml.getaddress&quot;] (args);"/>
						<outline text="const childTable = childAddress.reference.get ();"/>
						<outline text="if ((childTable !== null) &amp;&amp; (typeof childTable === &quot;object&quot;)) {">
							<outline text="if (childTable [&quot;/pcdata&quot;] !== undefined) {">
								<outline text="return (childTable [&quot;/pcdata&quot;]);"/>
								<outline text="}"/>
								</outline>
							<outline text="return (&quot;&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="return (String (childTable));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;xml.getattribute&quot;] = function (args) { //the ADDRESS of an attribute -- callers dereference it">
						<outline text="const theAddress = args [0];"/>
						<outline text="const theName = String (args [1]);"/>
						<outline text="if ((theAddress === undefined) || (theAddress.flAddress !== true)) {">
							<outline text="const message = &quot;Can't get the XML attribute because the first parameter isn't an address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="const theTable = theAddress.reference.get ();"/>
						<outline text="if ((theTable === undefined) || (theTable === null) || (typeof theTable !== &quot;object&quot;) || (theTable [&quot;/atts&quot;] === undefined)) {">
							<outline text="const message = &quot;Can't get the XML attribute &quot; + theName + &quot; because the element has no attributes.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="const atts = theTable [&quot;/atts&quot;];"/>
						<outline text="var foundKey;"/>
						<outline text="Object.keys (atts).forEach (function (key) {">
							<outline text="if ((foundKey === undefined) &amp;&amp; (key.toLowerCase () === theName.toLowerCase ())) {">
								<outline text="foundKey = key;"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="if (foundKey === undefined) {">
							<outline text="const message = &quot;Can't get the XML attribute &quot; + theName + &quot; because there is no attribute with that name.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="return ({">
							<outline text="flAddress: true,"/>
							<outline text="pathText: theAddress.pathText + &quot;.[\&quot;/atts\&quot;].[\&quot;&quot; + foundKey + &quot;\&quot;]&quot;,"/>
							<outline text="reference: {">
								<outline text="get: function () {">
									<outline text="return (atts [foundKey]);"/>
									<outline text="},"/>
									</outline>
								<outline text="set: function (theValue) {">
									<outline text="atts [foundKey] = theValue;"/>
									<outline text="},"/>
									</outline>
								<outline text="remove: function () {">
									<outline text="delete atts [foundKey];"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;xml.getattributevalue&quot;] = function (args) { //xml.getAttributeValue (@element, name)">
						<outline text="const theAddress = args [0];"/>
						<outline text="const theName = String (args [1]);"/>
						<outline text="if ((theAddress === undefined) || (theAddress.flAddress !== true)) {">
							<outline text="const message = &quot;Can't get the XML attribute because the first parameter isn't an address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="const theTable = theAddress.reference.get ();"/>
						<outline text="if ((theTable !== undefined) &amp;&amp; (theTable !== null) &amp;&amp; (typeof theTable === &quot;object&quot;) &amp;&amp; (theTable [&quot;/atts&quot;] !== undefined)) {">
							<outline text="const atts = theTable [&quot;/atts&quot;];"/>
							<outline text="var found;"/>
							<outline text="Object.keys (atts).forEach (function (key) {">
								<outline text="if ((found === undefined) &amp;&amp; (key.toLowerCase () === theName.toLowerCase ())) {">
									<outline text="found = atts [key];"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="if (found !== undefined) {">
								<outline text="return (found);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="const message = &quot;Can't get the XML attribute &quot; + theName + &quot; because there is no attribute with that name.&quot;;"/>
						<outline text="throw new Error (message);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;xml.addtable&quot;] = function (args) { //xml.addTable (@struct, name) -&gt; address of a new numbered child table">
						<outline text="const theAddress = args [0];"/>
						<outline text="const theName = String (args [1]);"/>
						<outline text="if ((theAddress === undefined) || (theAddress.flAddress !== true)) {">
							<outline text="const message = &quot;Can't add the XML table because the first parameter isn't an address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="var theTable = theAddress.reference.get ();"/>
						<outline text="if ((theTable === undefined) || (theTable === null) || (typeof theTable !== &quot;object&quot;)) {">
							<outline text="theAddress.reference.set ({});"/>
							<outline text="theTable = theAddress.reference.get ();"/>
							<outline text="}"/>
							</outline>
						<outline text="const newKey = xmlNumberedName (Object.keys (theTable).length + 1, theName);"/>
						<outline text="theTable [newKey] = {};"/>
						<outline text="return ({">
							<outline text="flAddress: true,"/>
							<outline text="pathText: theAddress.pathText + &quot;.[\&quot;&quot; + newKey + &quot;\&quot;]&quot;,"/>
							<outline text="reference: {">
								<outline text="get: function () {">
									<outline text="return (theTable [newKey]);"/>
									<outline text="},"/>
									</outline>
								<outline text="set: function (theValue) {">
									<outline text="theTable [newKey] = theValue;"/>
									<outline text="},"/>
									</outline>
								<outline text="remove: function () {">
									<outline text="delete theTable [newKey];"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;xml.addvalue&quot;] = function (args) { //xml.addValue (@struct, name, value)">
						<outline text="const theAddress = args [0];"/>
						<outline text="if ((theAddress === undefined) || (theAddress === null) || (theAddress.flAddress !== true)) {">
							<outline text="return (true); //a nil debug log just swallows the value"/>
							<outline text="}"/>
							</outline>
						<outline text="const theName = String (args [1]);"/>
						<outline text="var theTable = theAddress.reference.get ();"/>
						<outline text="if ((theTable === undefined) || (theTable === null) || (typeof theTable !== &quot;object&quot;)) {">
							<outline text="theAddress.reference.set ({});"/>
							<outline text="theTable = theAddress.reference.get ();"/>
							<outline text="}"/>
							</outline>
						<outline text="theTable [xmlNumberedName (Object.keys (theTable).length + 1, theName)] = args [2];"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="function xmlDecompileTable (theTable, theIndent) {">
						<outline text="var result = &quot;&quot;;"/>
						<outline text="Object.keys (theTable).forEach (function (key) {">
							<outline text="if ((key === &quot;/atts&quot;) || (key === &quot;/pcdata&quot;)) {">
								<outline text="return;"/>
								<outline text="}"/>
								</outline>
							<outline text="const child = theTable [key];"/>
							<outline text="const elementName = xmlDisplayName (key);"/>
							<outline text="if (elementName.startsWith (&quot;?&quot;)) {">
								<outline text=""/>
								<outline text="/*  8/4/26 by CC -- a processing instruction, the way Frontier's">
									<outline text="xml.compile stores one: the entries are its attributes, in"/>
									<outline text="table order. The shell struct's ?xml entry emits as"/>
									<outline text="&lt;?xml encoding=&quot;...&quot; version=&quot;...&quot;?&gt; -- the attribute order"/>
									<outline text="nodeEditorSuite.fixBuggyXml exists to correct, so the desktop"/>
									<outline text="pipeline behaves identically here.  */"/>
									</outline>
								<outline text=""/>
								<outline text="var piText = &quot;&lt;&quot; + elementName;"/>
								<outline text="if ((child !== null) &amp;&amp; (typeof child === &quot;object&quot;)) {">
									<outline text="Object.keys (child).forEach (function (attName) {">
										<outline text="if ((attName !== &quot;/atts&quot;) &amp;&amp; (attName !== &quot;/pcdata&quot;)) {">
											<outline text="piText += &quot; &quot; + attName + &quot;=\&quot;&quot; + xmlEntityEncode (child [attName]) + &quot;\&quot;&quot;;"/>
											<outline text="}"/>
											</outline>
										<outline text="});"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="result += theIndent + piText + &quot;?&gt;\r\n&quot;;"/>
								<outline text="return;"/>
								<outline text="}"/>
								</outline>
							<outline text="var attsText = &quot;&quot;;"/>
							<outline text="if ((child !== null) &amp;&amp; (typeof child === &quot;object&quot;) &amp;&amp; (child [&quot;/atts&quot;] !== undefined)) {">
								<outline text="Object.keys (child [&quot;/atts&quot;]).forEach (function (attName) {">
									<outline text="attsText += &quot; &quot; + attName + &quot;=\&quot;&quot; + xmlEntityEncode (child [&quot;/atts&quot;] [attName]) + &quot;\&quot;&quot;;"/>
									<outline text="});"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="if ((child !== null) &amp;&amp; (typeof child === &quot;object&quot;)) {">
								<outline text="const inner = xmlDecompileTable (child, theIndent + &quot;\t&quot;);"/>
								<outline text="const pcdata = (child [&quot;/pcdata&quot;] === undefined) ? &quot;&quot; : xmlEntityEncode (child [&quot;/pcdata&quot;]);"/>
								<outline text="if ((inner.length === 0) &amp;&amp; (pcdata.length === 0)) {">
									<outline text="result += theIndent + &quot;&lt;&quot; + elementName + attsText + &quot; /&gt;\r\n&quot;;"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="if (inner.length === 0) {">
										<outline text="result += theIndent + &quot;&lt;&quot; + elementName + attsText + &quot;&gt;&quot; + pcdata + &quot;&lt;/&quot; + elementName + &quot;&gt;\r\n&quot;;"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="result += theIndent + &quot;&lt;&quot; + elementName + attsText + &quot;&gt;\r\n&quot; + inner + theIndent + &quot;&lt;/&quot; + elementName + &quot;&gt;\r\n&quot;;"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="result += theIndent + &quot;&lt;&quot; + elementName + attsText + &quot;&gt;&quot; + xmlEntityEncode (child) + &quot;&lt;/&quot; + elementName + &quot;&gt;\r\n&quot;;"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="return (result);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;xml.decompile&quot;] = function (args) {">
						<outline text="const theAddress = args [0];"/>
						<outline text="var theTable = theAddress;"/>
						<outline text="if ((theAddress !== undefined) &amp;&amp; (theAddress !== null) &amp;&amp; (theAddress.flAddress === true)) {">
							<outline text="theTable = theAddress.reference.get ();"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((theTable === undefined) || (theTable === null) || (typeof theTable !== &quot;object&quot;)) {">
							<outline text="const message = &quot;Can't decompile the XML because the structure can't be reached.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="var flHasPi = false; //8/4/26 by CC -- a structure carrying its own ?xml entry supplies the declaration"/>
						<outline text="Object.keys (theTable).forEach (function (key) {">
							<outline text="if (xmlDisplayName (key).startsWith (&quot;?&quot;)) {">
								<outline text="flHasPi = true;"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="if (flHasPi) {">
							<outline text="return (xmlDecompileTable (theTable, &quot;&quot;));"/>
							<outline text="}"/>
							</outline>
						<outline text="return (&quot;&lt;?xml version=\&quot;1.0\&quot;?&gt;\r\n&quot; + xmlDecompileTable (theTable, &quot;&quot;));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;xml.opml.getbodyaddress&quot;] = function (args) {">
						<outline text=""/>
						<outline text="/*  8/4/26 by CC -- the address of the body element inside a compiled">
							<outline text="OPML document: the opml element's body child, found the same way"/>
							<outline text="xml.getAddress finds any child.  */"/>
							</outline>
						<outline text=""/>
						<outline text="const theAddress = args [0];"/>
						<outline text="if ((theAddress === undefined) || (theAddress === null) || (theAddress.flAddress !== true)) {">
							<outline text="const message = &quot;Can't get the body address because the parameter isn't the address of a compiled XML structure.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="const opmlAddress = verbs [&quot;xml.getaddress&quot;] ([theAddress, &quot;opml&quot;]);"/>
						<outline text="return (verbs [&quot;xml.getaddress&quot;] ([opmlAddress, &quot;body&quot;]));"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;op.outlinetoxml&quot;] = function (args) {">
						<outline text=""/>
						<outline text="/*  8/4/26 by CC -- serialize an outline value to OPML text. The lines">
							<outline text="carry a level each; the stack holds the level of every open element,"/>
							<outline text="so level jumps the database can hold still close correctly (the same"/>
							<outline text="debugged shape as trigger's scriptToOpml). Comment lines are emitted"/>
							<outline text="with isComment=&quot;true&quot; so downstream filters see them.  */"/>
							</outline>
						<outline text=""/>
						<outline text="var theValue = args [0];"/>
						<outline text="var theTitle = &quot;outline&quot;;"/>
						<outline text="if ((theValue !== undefined) &amp;&amp; (theValue !== null) &amp;&amp; (theValue.flAddress === true)) {">
							<outline text="const parts = theValue.pathText.split (&quot;.&quot;);"/>
							<outline text="theTitle = parts [parts.length - 1];"/>
							<outline text="theValue = theValue.reference.get ();"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((theValue === undefined) || (theValue === null) || (!Array.isArray (theValue.lines))) {">
							<outline text="const message = &quot;Can't convert the outline to XML because the value isn't an outline or a script.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="var theText = &quot;&lt;?xml version=\&quot;1.0\&quot; encoding=\&quot;UTF-8\&quot;?&gt;\n&lt;opml version=\&quot;2.0\&quot;&gt;\n\t&lt;head&gt;\n\t\t&lt;title&gt;&quot; + xmlEntityEncode (theTitle) + &quot;&lt;/title&gt;\n\t\t&lt;/head&gt;\n\t&lt;body&gt;\n&quot;;"/>
						<outline text="const openLevels = [];"/>
						<outline text="function indent (ctTabs) {">
							<outline text="var theTabs = &quot;&quot;;"/>
							<outline text="while (ctTabs &gt; 0) {">
								<outline text="theTabs += &quot;\t&quot;;"/>
								<outline text="ctTabs--;"/>
								<outline text="}"/>
								</outline>
							<outline text="return (theTabs);"/>
							<outline text="}"/>
							</outline>
						<outline text="function closeOne () {">
							<outline text="openLevels.pop ();"/>
							<outline text="theText += indent (openLevels.length + 2) + &quot;&lt;/outline&gt;\n&quot;;"/>
							<outline text="}"/>
							</outline>
						<outline text="theValue.lines.forEach (function (line) {">
							<outline text="if ((line !== null) &amp;&amp; (typeof line === &quot;object&quot;) &amp;&amp; (typeof line.text === &quot;string&quot;)) {">
								<outline text="const theLevel = Math.min (Math.max (Number (line.level) || 0, 0), 100);"/>
								<outline text="while ((openLevels.length &gt; 0) &amp;&amp; (openLevels [openLevels.length - 1] &gt;= theLevel)) {">
									<outline text="closeOne ();"/>
									<outline text="}"/>
									</outline>
								<outline text="theText += indent (openLevels.length + 2) + &quot;&lt;outline text=\&quot;&quot; + xmlEntityEncode (line.text) + &quot;\&quot;&quot; + ((line.flComment) ? &quot; isComment=\&quot;true\&quot;&quot; : &quot;&quot;) + &quot;&gt;\n&quot;;"/>
								<outline text="openLevels.push (theLevel);"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="while (openLevels.length &gt; 0) {">
							<outline text="closeOne ();"/>
							<outline text="}"/>
							</outline>
						<outline text="theText += &quot;\t\t&lt;/body&gt;\n\t&lt;/opml&gt;\n&quot;;"/>
						<outline text="return (theText);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="verbs [&quot;html.directory.getrawhtml&quot;] = function (args) {">
						<outline text=""/>
						<outline text="/*  8/4/26 by CC -- the renderer at the heart of uploadScripts, as a">
							<outline text="verb, shadowing the database's 2012 two-param copy (hard tabs, \r\n,"/>
							<outline text="no comment filter -- rendering comment nodes into output files)."/>
							<outline text="The desktop's current version honors the parameters; its semantics"/>
							<outline text="were verified byte-for-byte against Dave's deployed renders (7/23):"/>
							<outline text="one line per node, a tab per depth level when flIndent, line ends"/>
							<outline text="&quot;\n&quot; times ctLineEnds, comment nodes skipped unless"/>
							<outline text="flIncludeComments. args [2] (ignore # directives) and args [4]"/>
							<outline text="(lineEndChars) are accepted and unused -- the verified renders"/>
							<outline text="use &quot;\n&quot;.  */"/>
							</outline>
						<outline text=""/>
						<outline text="const adrNode = args [0];"/>
						<outline text="const adrText = args [1];"/>
						<outline text="const ctLineEnds = (args [3] === undefined) ? 1 : Number (args [3]);"/>
						<outline text="const flIndent = (args [5] === undefined) ? true : Boolean (args [5]);"/>
						<outline text="const flIncludeComments = (args [6] === undefined) ? false : Boolean (args [6]);"/>
						<outline text="if ((adrNode === undefined) || (adrNode === null) || (adrNode.flAddress !== true)) {">
							<outline text="const message = &quot;Can't render the node because the first parameter isn't an address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="if ((adrText === undefined) || (adrText === null) || (adrText.flAddress !== true)) {">
							<outline text="const message = &quot;Can't render the node because the second parameter isn't the address to answer through.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="const theTable = adrNode.reference.get ();"/>
						<outline text="if ((theTable === undefined) || (theTable === null) || (typeof theTable !== &quot;object&quot;)) {">
							<outline text="const message = &quot;Can't render the node because there is no element at the address.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="var htmltext = &quot;&quot;;"/>
						<outline text="var lineEnd = &quot;&quot;;"/>
						<outline text="var ctEnds = ctLineEnds;"/>
						<outline text="while (ctEnds &gt; 0) {">
							<outline text="lineEnd += &quot;\n&quot;;"/>
							<outline text="ctEnds--;"/>
							<outline text="}"/>
							</outline>
						<outline text="function doLevel (levelTable, depth) {">
							<outline text="Object.keys (levelTable).forEach (function (key) {">
								<outline text="if ((key === &quot;/atts&quot;) || (key === &quot;/pcdata&quot;)) {">
									<outline text="return;"/>
									<outline text="}"/>
									</outline>
								<outline text="if (!xmlDisplayName (key).toLowerCase ().endsWith (&quot;outline&quot;)) {">
									<outline text="return;"/>
									<outline text="}"/>
									</outline>
								<outline text="const child = levelTable [key];"/>
								<outline text="if ((child === null) || (typeof child !== &quot;object&quot;)) {">
									<outline text="return;"/>
									<outline text="}"/>
									</outline>
								<outline text="const atts = (child [&quot;/atts&quot;] === undefined) ? {} : child [&quot;/atts&quot;];"/>
								<outline text="if ((atts.isComment === &quot;true&quot;) &amp;&amp; !flIncludeComments) {">
									<outline text="return;"/>
									<outline text="}"/>
									</outline>
								<outline text="var theLine = (atts.text === undefined) ? &quot;&quot; : String (atts.text);"/>
								<outline text="if (flIndent) {">
									<outline text="var tabs = &quot;&quot;;"/>
									<outline text="var ctTabs = depth;"/>
									<outline text="while (ctTabs &gt; 0) {">
										<outline text="tabs += &quot;\t&quot;;"/>
										<outline text="ctTabs--;"/>
										<outline text="}"/>
										</outline>
									<outline text="theLine = tabs + theLine;"/>
									<outline text="}"/>
									</outline>
								<outline text="htmltext += theLine + lineEnd;"/>
								<outline text="doLevel (child, depth + 1);"/>
								<outline text="});"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="doLevel (theTable, 0);"/>
						<outline text="adrText.reference.set (htmltext);"/>
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="//the folder helpers resolve from the path map so folder math works end-to-end"/>
					<outline text=""/>
					<outline text="/*  8/7/26 by CC -- these install ONLY when the path map supplies a">
						<outline text="value. They used to install unconditionally, which meant the real"/>
						<outline text="scripts at these addresses in the database NEVER ran: DW edited"/>
						<outline text="nodeEditorSuite.getAllServersFolder and his change had no effect,"/>
						<outline text="because the helper shadowed it. With no helper configured, the verb"/>
						<outline text="isn't registered, and the call falls through to the script.  */"/>
						</outline>
					</outline>
				<outline text="">
					<outline text="if (thePathMap.helpers.getFolder !== undefined) {">
						<outline text="verbs [&quot;nodeeditorsuite.getfolder&quot;] = function (args) {">
							<outline text="return (thePathMap.helpers.getFolder);"/>
							<outline text="};"/>
							</outline>
						<outline text="}"/>
						</outline>
					</outline>
				<outline text="">
					<outline text="if (thePathMap.helpers.getAllServersFolder !== undefined) {">
						<outline text="verbs [&quot;nodeeditorsuite.getallserversfolder&quot;] = function (args) {">
							<outline text="return (thePathMap.helpers.getAllServersFolder);"/>
							<outline text="};"/>
							</outline>
						<outline text="}"/>
						</outline>
					</outline>
				<outline text="">
					<outline text="if (thePathMap.helpers.getGitHubFolder !== undefined) {">
						<outline text="verbs [&quot;nodeeditorsuite.getgithubfolder&quot;] = function (args) {">
							<outline text="return (thePathMap.helpers.getGitHubFolder);"/>
							<outline text="};"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="return ({verbs, macToReal});"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="exports.makeVerbs = makeVerbs;"/>
				</outline>
			<outline text="code/odbLoader.js">
				<outline text="/*  Load Dave's real object database into the interpreter's namespace:">
					<outline text="user.* from root.user.fttb, config.nodeEditor.projects from the"/>
					<outline text="projects fttb, and the whole nodeEditor guest database (the suite)."/>
					<outline text=""/>
					<outline text="Tables become plain objects. Scripts and outlines become"/>
					<outline text="{flOdbScript, lines} records the evaluator can parse and call on"/>
					<outline text="first use. Addresses become {flOdbAddressText, path}."/>
					<outline text=""/>
					<outline text="by CC, 7/27/26 */"/>
					</outline>
				<outline text=""/>
				<outline text="const fs = require (&quot;fs&quot;);"/>
				<outline text=""/>
				<outline text="var frontierOdb; //assigned by requireFrontierOdb, on the first loadOdb"/>
				<outline text=""/>
				<outline text="const options = { //where the database files live; defaults are DW's Mac, loadOdb (userOptions) overrides">
					<outline text="pathFrontierOdb: &quot;/Users/davewiner/Claude/frontierOdb/frontierodb.js&quot;,"/>
					<outline text="pathUserFttb: &quot;/Users/davewiner/Claude/frontierOdb/misc/root.user.fttb&quot;,"/>
					<outline text="pathProjectsFttb: &quot;/Users/davewiner/Claude/frontierOdb/misc/nodeEditor.projects.fttb&quot;,"/>
					<outline text="pathSuiteJson: &quot;/Users/davewiner/Claude/daveMigrates/misc/nodeEditor.json&quot;"/>
					<outline text="};"/>
					</outline>
				<outline text=""/>
				<outline text="function requireFrontierOdb () { //the require happens here, not when the module loads, so requiring usertalk works on machines that don't have these files">
					<outline text="if (frontierOdb === undefined) {">
						<outline text="try {">
							<outline text="frontierOdb = require (&quot;frontierodb&quot;); //an installed copy wins"/>
							<outline text="}"/>
							</outline>
						<outline text="catch (err) {">
							<outline text="frontierOdb = require (options.pathFrontierOdb);"/>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function convertValue (theValue) {">
					<outline text=""/>
					<outline text="if ((theValue === undefined) || (theValue === null)) {">
						<outline text="return (undefined);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="if (typeof theValue !== &quot;object&quot;) {">
						<outline text="return (theValue);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="if (theValue.type === &quot;table&quot;) {">
						<outline text="const table = {};"/>
						<outline text="Object.keys (theValue.value).forEach (function (name) {">
							<outline text="table [name] = convertValue (theValue.value [name]);"/>
							<outline text="});"/>
							</outline>
						<outline text="return (table);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="if (((theValue.type === &quot;script&quot;) || (theValue.type === &quot;outline&quot;)) &amp;&amp; (theValue.lines !== undefined)) {">
						<outline text="return ({flOdbScript: true, scriptType: theValue.type, lines: theValue.lines});"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="if (theValue.type === &quot;address&quot;) {">
						<outline text="return ({flOdbAddressText: true, path: theValue.path});"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="return (theValue); //binary and friends ride along as markers"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function convertTopLevel (theTable) {">
					<outline text="const result = {};"/>
					<outline text="Object.keys (theTable).forEach (function (name) {">
						<outline text="result [name] = convertValue (theTable [name]);"/>
						<outline text="});"/>
						</outline>
					<outline text="return (result);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function loadOdb (userOptions) {">
					<outline text=""/>
					<outline text="if (userOptions !== undefined) {">
						<outline text="for (var x in userOptions) {">
							<outline text="options [x] = userOptions [x];"/>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="requireFrontierOdb ();"/>
					<outline text=""/>
					<outline text="const theOdb = {};"/>
					<outline text=""/>
					<outline text="//the whole nodeEditor guest database: nodeEditorSuite and friends"/>
					<outline text="const theSuiteDb = JSON.parse (fs.readFileSync (options.pathSuiteJson, &quot;utf8&quot;));"/>
					<outline text="Object.keys (theSuiteDb).forEach (function (name) {">
						<outline text="theOdb [name] = convertValue (theSuiteDb [name]);"/>
						<outline text="});"/>
						</outline>
					<outline text=""/>
					<outline text="//user.* -- his real user table"/>
					<outline text="const theUserPage = frontierOdb.readFatPage (options.pathUserFttb);"/>
					<outline text="theOdb.user = convertTopLevel (theUserPage.value.value);"/>
					<outline text=""/>
					<outline text="//config.nodeEditor.projects -- the 511 projects"/>
					<outline text="const theProjectsPage = frontierOdb.readFatPage (options.pathProjectsFttb);"/>
					<outline text="theOdb.config = {">
						<outline text="nodeEditor: {">
							<outline text="projects: convertTopLevel (theProjectsPage.value.value)"/>
							<outline text="}"/>
							</outline>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="theOdb.scratchpad = {};"/>
					<outline text="theOdb.system = theOdb.system || {};"/>
					<outline text="theOdb.frontier = {pathstring: &quot;Macintosh HD:Users:davewiner:frontier:&quot;};"/>
					<outline text=""/>
					<outline text="return (theOdb);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="exports.loadOdb = loadOdb;"/>
				</outline>
			<outline text="code/odbHome.js">
				<outline text="/*  Assemble the interpreter's object database from a folder -- Dave's">
					<outline text="way of putting his universe back together by manipulating the file"/>
					<outline text="system and reloading."/>
					<outline text=""/>
					<outline text="The rules, from the top of the folder down:"/>
					<outline text=""/>
					<outline text="1. A subfolder is a table, named for the folder."/>
					<outline text="2. A .root file (a Frontier guest database) or a .json file (a"/>
					<outline text="   database already dumped by frontierOdb) is a DATABASE: its"/>
					<outline text="   top-level entries merge into the table at that spot, the way"/>
					<outline text="   guest databases blend into Frontier's namespace via system.paths."/>
					<outline text="3. A .fttb, .ftop or .ftsc file (a fat page export) is a SINGLE"/>
					<outline text="   OBJECT: it mounts as one entry named for the file, extension"/>
					<outline text="   dropped. Name the file what you want the object called."/>
					<outline text="4. Later arrivals win collisions -- files load alphabetically, then"/>
					<outline text="   subfolders. When both sides are tables they merge; otherwise the"/>
					<outline text="   newcomer replaces, and the collision is logged."/>
					<outline text=""/>
					<outline text="Tables become plain objects, scripts and outlines become"/>
					<outline text="{flOdbScript, lines} records the evaluator parses on first call,"/>
					<outline text="addresses become {flOdbAddressText, path} -- the same shapes"/>
					<outline text="odbLoader.js produces."/>
					<outline text=""/>
					<outline text="by CC, 7/27/26 */"/>
					</outline>
				<outline text=""/>
				<outline text="const fs = require (&quot;fs&quot;);"/>
				<outline text="const pathTool = require (&quot;path&quot;);"/>
				<outline text=""/>
				<outline text="function requireFrontierOdb () { //the npm package if installed, else a checkout beside this one">
					<outline text=""/>
					<outline text="try {">
						<outline text="return (require (&quot;frontierodb&quot;));"/>
						<outline text="}"/>
						</outline>
					<outline text="catch (err) {">
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="var found;"/>
					<outline text="const places = [">
						<outline text="pathTool.join (__dirname, &quot;..&quot;, &quot;..&quot;, &quot;frontierOdb&quot;, &quot;frontierodb.js&quot;), //packages side by side"/>
						<outline text="pathTool.join (__dirname, &quot;..&quot;, &quot;frontierOdb&quot;, &quot;frontierodb.js&quot;), //shipped inside one folder"/>
						<outline text="&quot;/Users/davewiner/Claude/frontierOdb/frontierodb.js&quot;"/>
						<outline text="];"/>
						</outline>
					<outline text="places.forEach (function (thePlace) {">
						<outline text="if ((found === undefined) &amp;&amp; fs.existsSync (thePlace)) {">
							<outline text="found = thePlace;"/>
							<outline text="}"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text=""/>
					<outline text="if (found === undefined) {">
						<outline text="const message = &quot;Can't read the object database because frontierodb isn't installed and no copy was found beside this package.&quot;;"/>
						<outline text="throw new Error (message);"/>
						<outline text="}"/>
						</outline>
					<outline text="return (require (found));"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function convertValue (theValue) {">
					<outline text=""/>
					<outline text="if ((theValue === undefined) || (theValue === null)) {">
						<outline text="return (undefined);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="if (typeof theValue !== &quot;object&quot;) {">
						<outline text="return (theValue);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="if (theValue.type === &quot;table&quot;) {">
						<outline text="const table = {};"/>
						<outline text="Object.keys (theValue.value).forEach (function (name) {">
							<outline text="table [name] = convertValue (theValue.value [name]);"/>
							<outline text="});"/>
							</outline>
						<outline text="return (table);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="if (((theValue.type === &quot;script&quot;) || (theValue.type === &quot;outline&quot;)) &amp;&amp; (theValue.lines !== undefined)) {">
						<outline text="return ({flOdbScript: true, scriptType: theValue.type, lines: theValue.lines});"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="if (theValue.type === &quot;address&quot;) {">
						<outline text="return ({flOdbAddressText: true, path: theValue.path});"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="if ((theValue.type === &quot;wptext&quot;) &amp;&amp; (theValue.text !== undefined)) {">
						<outline text="return ({ //word-processing text: knows what it is, reads as its text">
							<outline text="flWpText: true,"/>
							<outline text="text: theValue.text,"/>
							<outline text="toString: function () {">
								<outline text="return (this.text);"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="return (theValue); //binary and friends ride along as markers"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function loadFolder (folderPath, logCallback) {">
					<outline text=""/>
					<outline text="const log = (logCallback === undefined) ? function () {} : logCallback;"/>
					<outline text="const frontierOdb = requireFrontierOdb ();"/>
					<outline text=""/>
					<outline text="function flTable (theValue) {">
						<outline text="return ((theValue !== undefined) &amp;&amp; (theValue !== null) &amp;&amp;">
							<outline text="(typeof theValue === &quot;object&quot;) &amp;&amp;"/>
							<outline text="(theValue.flOdbScript === undefined) &amp;&amp; (theValue.flOdbAddressText === undefined) &amp;&amp;"/>
							<outline text="(theValue.type === undefined) &amp;&amp; (!Array.isArray (theValue)));"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function mergeInto (theTable, theName, theValue, theSource, thePath) {">
						<outline text="const existing = theTable [theName];"/>
						<outline text="const entryPath = (thePath === &quot;&quot;) ? theName : thePath + &quot;.&quot; + theName;"/>
						<outline text="if (flTable (existing) &amp;&amp; flTable (theValue)) {">
							<outline text="Object.keys (theValue).forEach (function (childName) {">
								<outline text="mergeInto (existing, childName, theValue [childName], theSource, entryPath);"/>
								<outline text="});"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="/*  Replacing a value with a newer one is the normal way later">
								<outline text="files win -- only a shape change is worth a log line.  */"/>
								</outline>
							<outline text="if ((existing !== undefined) &amp;&amp; (flTable (existing) !== flTable (theValue))) {">
								<outline text="log (&quot;Collision at &quot; + entryPath + &quot;: &quot; + theSource + &quot; replaced a &quot; + (flTable (existing) ? &quot;table&quot; : &quot;value&quot;) + &quot; with a &quot; + (flTable (theValue) ? &quot;table&quot; : &quot;value&quot;) + &quot;.&quot;);"/>
								<outline text="}"/>
								</outline>
							<outline text="theTable [theName] = theValue;"/>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function mergeDatabase (theTable, theTopLevel, theSource) { //a .root or .json: top-level entries blend in">
						<outline text="Object.keys (theTopLevel).forEach (function (name) {">
							<outline text="mergeInto (theTable, name, convertValue (theTopLevel [name]), theSource, &quot;&quot;);"/>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function loadOneFolder (theFolderPath, theTable) {">
						<outline text=""/>
						<outline text="const folderNames = [];"/>
						<outline text="const fileNames = [];"/>
						<outline text=""/>
						<outline text="fs.readdirSync (theFolderPath).forEach (function (fname) {">
							<outline text="if (fname.indexOf (&quot;.&quot;) === 0) { //.DS_Store and friends">
								<outline text="return;"/>
								<outline text="}"/>
								</outline>
							<outline text="if (fs.statSync (pathTool.join (theFolderPath, fname)).isDirectory ()) {">
								<outline text="folderNames.push (fname);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="fileNames.push (fname);"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text=""/>
						<outline text="fileNames.sort ();"/>
						<outline text="folderNames.sort ();"/>
						<outline text=""/>
						<outline text="fileNames.forEach (function (fname) {">
							<outline text="const filePath = pathTool.join (theFolderPath, fname);"/>
							<outline text="const extension = pathTool.extname (fname).toLowerCase ();"/>
							<outline text="const baseName = pathTool.basename (fname, pathTool.extname (fname));"/>
							<outline text="if (extension === &quot;.root&quot;) {">
								<outline text="mergeDatabase (theTable, frontierOdb.readRootFile (filePath), fname);"/>
								<outline text="log (&quot;Merged the database &quot; + fname + &quot;.&quot;);"/>
								<outline text="return;"/>
								<outline text="}"/>
								</outline>
							<outline text="if (extension === &quot;.json&quot;) {">
								<outline text="mergeDatabase (theTable, JSON.parse (fs.readFileSync (filePath, &quot;utf8&quot;)), fname);"/>
								<outline text="log (&quot;Merged the database &quot; + fname + &quot;.&quot;);"/>
								<outline text="return;"/>
								<outline text="}"/>
								</outline>
							<outline text="if ((extension === &quot;.fttb&quot;) || (extension === &quot;.ftop&quot;) || (extension === &quot;.ftsc&quot;)) {">
								<outline text="const thePage = frontierOdb.readFatPage (filePath);"/>
								<outline text="mergeInto (theTable, baseName, convertValue (thePage.value), fname, &quot;&quot;);"/>
								<outline text="log (&quot;Mounted &quot; + fname + &quot; as &quot; + baseName + &quot;.&quot;);"/>
								<outline text="return;"/>
								<outline text="}"/>
								</outline>
							<outline text="if ((extension === &quot;.md&quot;) || (extension === &quot;.txt&quot;)) { //notes ride along quietly">
								<outline text="return;"/>
								<outline text="}"/>
								</outline>
							<outline text="log (&quot;Skipped &quot; + fname + &quot; because &quot; + extension + &quot; isn't a database or a fat page.&quot;);"/>
							<outline text="});"/>
							</outline>
						<outline text=""/>
						<outline text="folderNames.forEach (function (fname) {">
							<outline text="if (theTable [fname] === undefined) {">
								<outline text="theTable [fname] = {};"/>
								<outline text="}"/>
								</outline>
							<outline text="loadOneFolder (pathTool.join (theFolderPath, fname), theTable [fname]);"/>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="if (!fs.existsSync (folderPath)) {">
						<outline text="const message = &quot;Can't load the odb folder &quot; + folderPath + &quot; because there is no folder with that name.&quot;;"/>
						<outline text="throw new Error (message);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="const theOdb = {};"/>
					<outline text="loadOneFolder (folderPath, theOdb);"/>
					<outline text=""/>
					<outline text="//the tables every script assumes are there"/>
					<outline text="if (theOdb.scratchpad === undefined) {">
						<outline text="theOdb.scratchpad = {};"/>
						<outline text="}"/>
						</outline>
					<outline text="if (theOdb.config === undefined) {">
						<outline text="theOdb.config = {};"/>
						<outline text="}"/>
						</outline>
					<outline text="if (theOdb.system === undefined) {">
						<outline text="theOdb.system = {};"/>
						<outline text="}"/>
						</outline>
					<outline text="if (theOdb.user === undefined) {">
						<outline text="theOdb.user = {};"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="return (theOdb);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="exports.loadFolder = loadFolder;"/>
				<outline text="exports.convertValue = convertValue;"/>
				<outline text="exports.requireFrontierOdb = requireFrontierOdb;"/>
				</outline>
			<outline text="code/odbSql.js">
				<outline text="/*  The object database in SQL.">
					<outline text=""/>
					<outline text="One row per object, identified by an integer id, with parentid"/>
					<outline text="pointing at the table it lives in. Names are opaque -- a Frontier name"/>
					<outline text="can contain dots, spaces and tabs, so nothing is built by gluing names"/>
					<outline text="together. An address like system.verbs.builtins.string.lower resolves"/>
					<outline text="by walking, one indexed lookup per component."/>
					<outline text=""/>
					<outline text="Nothing is written back to the .root format: a database is built from"/>
					<outline text="roots once, and from then on the database is the truth."/>
					<outline text=""/>
					<outline text="The reader hands the evaluator ordinary-looking tables that are really"/>
					<outline text="proxies -- a child materializes when something asks for it, the way"/>
					<outline text="the kernel loads a value when it's touched instead of holding the"/>
					<outline text="whole database in memory."/>
					<outline text=""/>
					<outline text="by CC, 7/28/26 */"/>
					</outline>
				<outline text=""/>
				<outline text="const fs = require (&quot;fs&quot;);"/>
				<outline text="const pathTool = require (&quot;path&quot;);"/>
				<outline text=""/>
				<outline text="const idRoot = 0; //the root table's children have parentid 0"/>
				<outline text=""/>
				<outline text="function requireSqlite () {">
					<outline text="try {">
						<outline text="return (require (&quot;better-sqlite3&quot;));"/>
						<outline text="}"/>
						</outline>
					<outline text="catch (err) {">
						<outline text="const message = &quot;Can't use the SQL object database because better-sqlite3 isn't installed.&quot;;"/>
						<outline text="throw new Error (message);"/>
						<outline text="}"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="const createScript = `">
					<outline text="create table if not exists odb (">
						<outline text="id integer primary key autoincrement,"/>
						<outline text="parentid integer not null,"/>
						<outline text="name text not null,"/>
						<outline text="lowername text not null,"/>
						<outline text="type text not null,"/>
						<outline text="value text"/>
						<outline text=");"/>
						</outline>
					<outline text="create index if not exists odbparent on odb (parentid, lowername);"/>
					<outline text="`;"/>
					</outline>
				<outline text=""/>
				<outline text="function valueType (theValue) { //the type name that goes in the row">
					<outline text="if ((theValue === undefined) || (theValue === null)) {">
						<outline text="return (&quot;novalue&quot;);"/>
						<outline text="}"/>
						</outline>
					<outline text="if (typeof theValue === &quot;string&quot;) {">
						<outline text="return (&quot;string&quot;);"/>
						<outline text="}"/>
						</outline>
					<outline text="if (typeof theValue === &quot;number&quot;) {">
						<outline text="return (&quot;number&quot;);"/>
						<outline text="}"/>
						</outline>
					<outline text="if (typeof theValue === &quot;boolean&quot;) {">
						<outline text="return (&quot;boolean&quot;);"/>
						<outline text="}"/>
						</outline>
					<outline text="if (theValue instanceof Date) {">
						<outline text="return (&quot;date&quot;);"/>
						<outline text="}"/>
						</outline>
					<outline text="if (Array.isArray (theValue)) {">
						<outline text="return (&quot;list&quot;);"/>
						<outline text="}"/>
						</outline>
					<outline text="if (theValue.flOdbScript === true) {">
						<outline text="return (theValue.scriptType === &quot;outline&quot; ? &quot;outline&quot; : &quot;script&quot;);"/>
						<outline text="}"/>
						</outline>
					<outline text="if (theValue.flWpText === true) {">
						<outline text="return (&quot;wptext&quot;);"/>
						<outline text="}"/>
						</outline>
					<outline text="if (theValue.flOdbAddressText === true) {">
						<outline text="return (&quot;address&quot;);"/>
						<outline text="}"/>
						</outline>
					<outline text="if (theValue.flOdbSqlTable === true) {">
						<outline text="return (&quot;table&quot;);"/>
						<outline text="}"/>
						</outline>
					<outline text="if (theValue.type !== undefined) {">
						<outline text="/*  An undecoded value -- frontierOdb kept it as a marker carrying">
							<outline text="its Frontier type and byte count. It gets its own row type, so a"/>
							<outline text="marker that says &quot;string&quot; is never mistaken for a string.  */"/>
							</outline>
						<outline text="return (&quot;marker&quot;);"/>
						<outline text="}"/>
						</outline>
					<outline text="return (&quot;table&quot;);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function encodeValue (theValue, theType) {">
					<outline text="const theText = encodeValueText (theValue, theType);"/>
					<outline text="return ((theText === undefined) ? null : theText); //the column is never undefined"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function encodeValueText (theValue, theType) { //everything but a table becomes text">
					<outline text="switch (theType) {">
						<outline text="case &quot;novalue&quot;: case &quot;table&quot;:">
							<outline text="return (null);"/>
							</outline>
						<outline text="case &quot;string&quot;:">
							<outline text="return (theValue);"/>
							</outline>
						<outline text="case &quot;number&quot;: case &quot;boolean&quot;:">
							<outline text="return (String (theValue));"/>
							</outline>
						<outline text="case &quot;date&quot;:">
							<outline text="return (theValue.toISOString ());"/>
							</outline>
						<outline text="case &quot;list&quot;:">
							<outline text="return (JSON.stringify (theValue));"/>
							</outline>
						<outline text="case &quot;script&quot;: case &quot;outline&quot;:">
							<outline text="return (JSON.stringify (theValue.lines));"/>
							</outline>
						<outline text="case &quot;wptext&quot;:">
							<outline text="return (theValue.text);"/>
							</outline>
						<outline text="case &quot;address&quot;:">
							<outline text="return (theValue.path);"/>
							</outline>
						<outline text="default: //a marker: the Frontier type and how many bytes, not the bytes">
							<outline text="return (JSON.stringify ({type: theValue.type, length: theValue.length}));"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function decodeValue (theText, theType) {">
					<outline text="switch (theType) {">
						<outline text="case &quot;novalue&quot;:">
							<outline text="return (undefined);"/>
							</outline>
						<outline text="case &quot;string&quot;:">
							<outline text="return (theText);"/>
							</outline>
						<outline text="case &quot;number&quot;:">
							<outline text="return (Number (theText));"/>
							</outline>
						<outline text="case &quot;boolean&quot;:">
							<outline text="return (theText === &quot;true&quot;);"/>
							</outline>
						<outline text="case &quot;date&quot;:">
							<outline text="return (new Date (theText));"/>
							</outline>
						<outline text="case &quot;list&quot;:">
							<outline text="return (JSON.parse (theText));"/>
							</outline>
						<outline text="case &quot;script&quot;: case &quot;outline&quot;:">
							<outline text="return ({flOdbScript: true, scriptType: theType, lines: JSON.parse (theText)});"/>
							</outline>
						<outline text="case &quot;wptext&quot;:">
							<outline text="return ({">
								<outline text="flWpText: true,"/>
								<outline text="text: theText,"/>
								<outline text="toString: function () {">
									<outline text="return (this.text);"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							</outline>
						<outline text="case &quot;address&quot;:">
							<outline text="return ({flOdbAddressText: true, path: theText});"/>
							</outline>
						<outline text="default: //a marker comes back the shape frontierOdb gave it">
							<outline text="return (JSON.parse (theText));"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function flPlainTable (theValue) { //a table, as opposed to a value that happens to be an object">
					<outline text="if ((theValue === undefined) || (theValue === null) || (typeof theValue !== &quot;object&quot;)) {">
						<outline text="return (false);"/>
						<outline text="}"/>
						</outline>
					<outline text="if (theValue.flOdbSqlTable === true) { //already one of ours">
						<outline text="return (true);"/>
						<outline text="}"/>
						</outline>
					<outline text="return ((theValue.flOdbScript === undefined) &amp;&amp; (theValue.flWpText === undefined) &amp;&amp;">
						<outline text="(theValue.flOdbAddressText === undefined) &amp;&amp; (theValue.type === undefined) &amp;&amp;"/>
						<outline text="(!Array.isArray (theValue)) &amp;&amp; (!(theValue instanceof Date)));"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function buildDatabase (folderOdb, pathDatabase, logCallback) {">
					<outline text=""/>
					<outline text="/*  Read a folder of roots the way odbHome does and write it into a">
						<outline text="database. This happens once; after it, the roots are history.  */"/>
						</outline>
					<outline text=""/>
					<outline text="const log = (logCallback === undefined) ? function () {} : logCallback;"/>
					<outline text="const sqlite3 = requireSqlite ();"/>
					<outline text="const odbHome = require (&quot;./odbHome.js&quot;);"/>
					<outline text=""/>
					<outline text="if (fs.existsSync (pathDatabase)) {">
						<outline text="fs.unlinkSync (pathDatabase);"/>
						<outline text="}"/>
						</outline>
					<outline text="fs.mkdirSync (pathTool.dirname (pathDatabase), {recursive: true});"/>
					<outline text=""/>
					<outline text="const theDatabase = new sqlite3 (pathDatabase);"/>
					<outline text="theDatabase.pragma (&quot;journal_mode = WAL&quot;);"/>
					<outline text="theDatabase.exec (createScript);"/>
					<outline text=""/>
					<outline text="const insert = theDatabase.prepare (&quot;insert into odb (parentid, name, lowername, type, value) values (?, ?, ?, ?, ?);&quot;);"/>
					<outline text=""/>
					<outline text="log (&quot;reading the roots&quot;);"/>
					<outline text="const theTree = odbHome.loadFolder (folderOdb, log);"/>
					<outline text=""/>
					<outline text="var ctRows = 0;"/>
					<outline text=""/>
					<outline text="const writeTree = theDatabase.transaction (function (theTable, parentId) {">
						<outline text="Object.keys (theTable).forEach (function (name) {">
							<outline text="const theValue = theTable [name];"/>
							<outline text="const theType = flPlainTable (theValue) ? &quot;table&quot; : valueType (theValue);"/>
							<outline text="const theId = insert.run (parentId, name, String (name).toLowerCase (), theType, encodeValue (theValue, theType)).lastInsertRowid;"/>
							<outline text="ctRows++;"/>
							<outline text="if (theType === &quot;table&quot;) {">
								<outline text="writeTree (theValue, theId);"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text=""/>
					<outline text="log (&quot;writing rows&quot;);"/>
					<outline text="writeTree (theTree, idRoot);"/>
					<outline text=""/>
					<outline text="log (ctRows + &quot; rows written to &quot; + pathDatabase);"/>
					<outline text="theDatabase.close ();"/>
					<outline text="return (ctRows);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function openDatabase (pathDatabase) {">
					<outline text=""/>
					<outline text="/*  Open a built database and hand back a root table. Children">
						<outline text="materialize on access -- a table is a proxy over the rows whose"/>
						<outline text="parentid is its own, so the database is never all in memory.  */"/>
						</outline>
					<outline text=""/>
					<outline text="const sqlite3 = requireSqlite ();"/>
					<outline text="const theDatabase = new sqlite3 (pathDatabase);"/>
					<outline text="theDatabase.pragma (&quot;journal_mode = WAL&quot;);"/>
					<outline text="theDatabase.exec (createScript);"/>
					<outline text=""/>
					<outline text="const selectChildren = theDatabase.prepare (&quot;select name from odb where parentid = ? order by lowername;&quot;);"/>
					<outline text="const selectChild = theDatabase.prepare (&quot;select id, name, type, value from odb where parentid = ? and lowername = ?;&quot;);"/>
					<outline text="const insertChild = theDatabase.prepare (&quot;insert into odb (parentid, name, lowername, type, value) values (?, ?, ?, ?, ?);&quot;);"/>
					<outline text="const updateChild = theDatabase.prepare (&quot;update odb set type = ?, value = ? where id = ?;&quot;);"/>
					<outline text="const deleteById = theDatabase.prepare (&quot;delete from odb where id = ?;&quot;);"/>
					<outline text=""/>
					<outline text="const proxyCache = new Map (); //one proxy per id, so identity holds across reads"/>
					<outline text=""/>
					<outline text="function removeSubtree (theId) { //a table's children go with it">
						<outline text="selectChildren.all (theId).forEach (function (row) {">
							<outline text="const child = selectChild.get (theId, String (row.name).toLowerCase ());"/>
							<outline text="if (child !== undefined) {">
								<outline text="removeSubtree (child.id);"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="deleteById.run (theId);"/>
						<outline text="proxyCache.delete (theId);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function writeValue (parentId, name, theValue) { //set an entry, replacing whatever was there">
						<outline text="const existing = selectChild.get (parentId, String (name).toLowerCase ());"/>
						<outline text="const theType = flPlainTable (theValue) ? &quot;table&quot; : valueType (theValue);"/>
						<outline text="const theColumn = encodeValue (theValue, theType);"/>
						<outline text="var theId;"/>
						<outline text="if (existing === undefined) {">
							<outline text="theId = insertChild.run (parentId, name, String (name).toLowerCase (), theType, theColumn).lastInsertRowid;"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="theId = existing.id;"/>
							<outline text="if (existing.type === &quot;table&quot;) { //replacing a table drops what was under it">
								<outline text="selectChildren.all (theId).forEach (function (row) {">
									<outline text="const child = selectChild.get (theId, String (row.name).toLowerCase ());"/>
									<outline text="if (child !== undefined) {">
										<outline text="removeSubtree (child.id);"/>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="proxyCache.delete (theId);"/>
								<outline text="}"/>
								</outline>
							<outline text="updateChild.run (theType, theColumn, theId);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (theType === &quot;table&quot;) {">
							<outline text="const source = theValue;"/>
							<outline text="Object.keys (source).forEach (function (childName) {">
								<outline text="writeValue (theId, childName, source [childName]);"/>
								<outline text="});"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="return (theId);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function readChild (parentId, name) {">
						<outline text="const row = selectChild.get (parentId, String (name).toLowerCase ());"/>
						<outline text="if (row === undefined) {">
							<outline text="return (undefined);"/>
							<outline text="}"/>
							</outline>
						<outline text="if (row.type === &quot;table&quot;) {">
							<outline text="return (tableForId (row.id));"/>
							<outline text="}"/>
							</outline>
						<outline text="return (decodeValue (row.value, row.type));"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function tableForId (theId) {">
						<outline text=""/>
						<outline text="if (proxyCache.has (theId)) {">
							<outline text="return (proxyCache.get (theId));"/>
							<outline text="}"/>
							</outline>
						<outline text=""/>
						<outline text="const target = {flOdbSqlTable: true, odbId: theId};"/>
						<outline text=""/>
						<outline text="const handler = {">
							<outline text=""/>
							<outline text="ownKeys: function () {">
								<outline text="const keys = [];"/>
								<outline text="selectChildren.all (theId).forEach (function (row) {">
									<outline text="keys.push (row.name);"/>
									<outline text="});"/>
									</outline>
								<outline text="return (keys);"/>
								<outline text="},"/>
								</outline>
							<outline text=""/>
							<outline text="getOwnPropertyDescriptor: function (theTarget, name) {">
								<outline text="if (typeof name !== &quot;string&quot;) {">
									<outline text="return (undefined);"/>
									<outline text="}"/>
									</outline>
								<outline text="const row = selectChild.get (theId, name.toLowerCase ());"/>
								<outline text="if (row === undefined) {">
									<outline text="return (undefined);"/>
									<outline text="}"/>
									</outline>
								<outline text="return ({enumerable: true, configurable: true, writable: true, value: readChild (theId, name)});"/>
								<outline text="},"/>
								</outline>
							<outline text=""/>
							<outline text="has: function (theTarget, name) {">
								<outline text="if ((name === &quot;flOdbSqlTable&quot;) || (name === &quot;odbId&quot;)) {">
									<outline text="return (true);"/>
									<outline text="}"/>
									</outline>
								<outline text="if (typeof name !== &quot;string&quot;) {">
									<outline text="return (false);"/>
									<outline text="}"/>
									</outline>
								<outline text="return (selectChild.get (theId, name.toLowerCase ()) !== undefined);"/>
								<outline text="},"/>
								</outline>
							<outline text=""/>
							<outline text="get: function (theTarget, name) {">
								<outline text="if ((name === &quot;flOdbSqlTable&quot;) || (name === &quot;odbId&quot;)) {">
									<outline text="return (theTarget [name]);"/>
									<outline text="}"/>
									</outline>
								<outline text="if (typeof name !== &quot;string&quot;) { //Symbol.toPrimitive and friends">
									<outline text="return (undefined);"/>
									<outline text="}"/>
									</outline>
								<outline text="return (readChild (theId, name));"/>
								<outline text="},"/>
								</outline>
							<outline text=""/>
							<outline text="set: function (theTarget, name, theValue) {">
								<outline text="writeValue (theId, String (name), theValue);"/>
								<outline text="return (true);"/>
								<outline text="},"/>
								</outline>
							<outline text=""/>
							<outline text="deleteProperty: function (theTarget, name) {">
								<outline text="const row = selectChild.get (theId, String (name).toLowerCase ());"/>
								<outline text="if (row !== undefined) {">
									<outline text="removeSubtree (row.id);"/>
									<outline text="}"/>
									</outline>
								<outline text="return (true);"/>
								<outline text="}"/>
								</outline>
							<outline text="};"/>
							</outline>
						<outline text=""/>
						<outline text="const theProxy = new Proxy (target, handler);"/>
						<outline text="proxyCache.set (theId, theProxy);"/>
						<outline text="return (theProxy);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="return ({">
						<outline text="odb: tableForId (idRoot),"/>
						<outline text="close: function () {">
							<outline text="theDatabase.close ();"/>
							<outline text="},"/>
							</outline>
						<outline text="countRows: function () {">
							<outline text="return (theDatabase.prepare (&quot;select count (*) as ct from odb;&quot;).get ().ct);"/>
							<outline text="}"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="exports.buildDatabase = buildDatabase;"/>
				<outline text="exports.openDatabase = openDatabase;"/>
				</outline>
			<outline text="code/s3helper.js">
				<outline text="/*  One S3 operation, performed and reported, then the process exits.">
					<outline text=""/>
					<outline text="UserTalk is synchronous -- a script says s3.newobject (path, text, type) and"/>
					<outline text="expects the object to exist on the next line -- and daveS3 is callback-based."/>
					<outline text="Nothing in node can wait for a callback synchronously, so the verbs run this"/>
					<outline text="helper with execFileSync and read its answer off stdout. One process per"/>
					<outline text="object is the cost; correctness is what it buys."/>
					<outline text=""/>
					<outline text="The command arrives as JSON on stdin, and the answer leaves as JSON on stdout:">
						<outline text="{&quot;verb&quot;: &quot;newobject&quot;, &quot;path&quot;: &quot;/bucket/key&quot;, &quot;type&quot;: &quot;text/html&quot;, &quot;acl&quot;: &quot;public-read&quot;, &quot;data&quot;: &quot;...&quot;}"/>
						<outline text="{&quot;verb&quot;: &quot;getobject&quot;, &quot;path&quot;: &quot;/bucket/key&quot;}"/>
						<outline text="{&quot;verb&quot;: &quot;objectexists&quot;, &quot;path&quot;: &quot;/bucket/key&quot;}"/>
						</outline>
					<outline text=""/>
					<outline text="by CC, 8/5/26 */"/>
					</outline>
				<outline text=""/>
				<outline text="/*  daveS3 narrates to the console, and stdout is where the answer goes -- one">
					<outline text="log line would make the JSON unparseable. Send everything it says to stderr,"/>
					<outline text="where it still shows up in the log, and keep stdout for the answer.  */"/>
					</outline>
				<outline text="console.log = function () {">
					<outline text="process.stderr.write (Array.prototype.slice.call (arguments).join (&quot; &quot;) + &quot;\n&quot;);"/>
					<outline text="};"/>
					</outline>
				<outline text=""/>
				<outline text="const s3 = require (&quot;daves3&quot;);"/>
				<outline text=""/>
				<outline text="function readCommand (callback) {">
					<outline text="var theText = &quot;&quot;;"/>
					<outline text="process.stdin.setEncoding (&quot;utf8&quot;);"/>
					<outline text="process.stdin.on (&quot;data&quot;, function (theChunk) {">
						<outline text="theText += theChunk;"/>
						<outline text="});"/>
						</outline>
					<outline text="process.stdin.on (&quot;end&quot;, function () {">
						<outline text="callback (JSON.parse (theText));"/>
						<outline text="});"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function answer (theObject) {">
					<outline text="process.stdout.write (JSON.stringify (theObject));"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="readCommand (function (theCommand) {">
					<outline text="switch (theCommand.verb) {">
						<outline text=""/>
						<outline text="case &quot;newobject&quot;:">
							<outline text="s3.newObject (theCommand.path, theCommand.data, theCommand.type, theCommand.acl, function (err) {">
								<outline text="if (err) {">
									<outline text="answer ({flError: true, message: err.message});"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="answer ({value: true});"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="break;"/>
							</outline>
						<outline text=""/>
						<outline text="case &quot;getobject&quot;:">
							<outline text="s3.getObject (theCommand.path, function (err, theData) {">
								<outline text="if (err) {">
									<outline text="answer ({flError: true, message: err.message});"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="/*  daveS3 hands back the whole AWS response; the object's">
										<outline text="contents are the Body, and a UserTalk script wants the"/>
										<outline text="text, not a description of the response.  */"/>
										</outline>
									<outline text="answer ({value: ((theData === undefined) || (theData === null) || (theData.Body === undefined)) ? String (theData) : theData.Body.toString (&quot;utf8&quot;)});"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="break;"/>
							</outline>
						<outline text=""/>
						<outline text="case &quot;objectexists&quot;:">
							<outline text="/*  daveS3 answers the metadata, or undefined when there is no such">
								<outline text="object. An error is also a no -- the caller asked a yes/no"/>
								<outline text="question, not for the reason.  */"/>
								</outline>
							<outline text="s3.getObjectMetadata (theCommand.path, function (theStats) {">
								<outline text="answer ({value: ((theStats !== undefined) &amp;&amp; (theStats !== null))});"/>
								<outline text="});"/>
								</outline>
							<outline text="break;"/>
							</outline>
						<outline text=""/>
						<outline text="default:">
							<outline text="answer ({flError: true, message: &quot;Can't do the S3 operation because \&quot;&quot; + theCommand.verb + &quot;\&quot; isn't one this helper knows.&quot;});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="});"/>
					</outline>
				</outline>
			<outline text="code/usertalk.js">
				<outline text="const myProductName = &quot;usertalk&quot;, myVersion = &quot;0.2.0&quot;; //7/27/26 by CC -- the UserTalk language running on Node; born in the 7/26-27 overnight research run, named by DW 7/27"/>
				<outline text=""/>
				<outline text="const parse = require (&quot;./parse.js&quot;);"/>
				<outline text="const evaluate = require (&quot;./evaluate.js&quot;);"/>
				<outline text="const verbs = require (&quot;./verbs.js&quot;);"/>
				<outline text="const odbLoader = require (&quot;./odbLoader.js&quot;);"/>
				<outline text="const odbHome = require (&quot;./odbHome.js&quot;); //7/27/26 by CC -- assemble the odb from a folder of roots and fat pages"/>
				<outline text=""/>
				<outline text="exports.parseLine = parse.parseLine;"/>
				<outline text="exports.parseOutline = parse.parseOutline;"/>
				<outline text="exports.tokenize = parse.tokenize;"/>
				<outline text="exports.linesToTree = parse.linesToTree;"/>
				<outline text="exports.makeEnvironment = evaluate.makeEnvironment;"/>
				<outline text="exports.evaluate = evaluate.evaluate;"/>
				<outline text="exports.makeVerbs = verbs.makeVerbs;"/>
				<outline text="exports.loadOdb = odbLoader.loadOdb;"/>
				<outline text="exports.loadFolder = odbHome.loadFolder;"/>
				<outline text="exports.myProductName = myProductName;"/>
				<outline text="exports.myVersion = myVersion;"/>
				</outline>
			<outline text="code/run.js">
				<outline text="/*  Run one UserTalk script outline under the interpreter.">
					<outline text=""/>
					<outline text="node run.js path/to/script.opml [--trace] [--odb folder]"/>
					<outline text="node run.js buildBelter.opml [--trace]"/>
					<outline text=""/>
					<outline text="A path that exists is run as given; a bare name is looked up in the"/>
					<outline text="build-scripts folder. Binds user.prefs from the path map, runs the"/>
					<outline text="top-level handler, prints every verb call."/>
					<outline text=""/>
					<outline text="With --odb, the object database is assembled from the folder by"/>
					<outline text="odbHome.js -- drop .root files, fat pages and subfolders in the"/>
					<outline text="folder and they become the namespace the script runs in."/>
					<outline text=""/>
					<outline text="by CC, 7/27/26 */"/>
					</outline>
				<outline text=""/>
				<outline text="const fs = require (&quot;fs&quot;);"/>
				<outline text="const parse = require (&quot;./parse.js&quot;);"/>
				<outline text="const evaluate = require (&quot;./evaluate.js&quot;);"/>
				<outline text="const verbsMaker = require (&quot;./verbs.js&quot;);"/>
				<outline text="const odbHome = require (&quot;./odbHome.js&quot;);"/>
				<outline text=""/>
				<outline text="const folderBuildScripts = &quot;/Users/davewiner/Claude/daveMigrates/usertalk build scripts&quot;;"/>
				<outline text="const pathPathMap = require (&quot;path&quot;).join (__dirname, &quot;pathmap.json&quot;); //7/27/26 by CC -- next to the code, wherever the repo lives"/>
				<outline text=""/>
				<outline text="const scriptName = process.argv [2];"/>
				<outline text="const flTrace = process.argv.indexOf (&quot;--trace&quot;) !== -1;"/>
				<outline text=""/>
				<outline text="var folderOdbHome; //7/27/26 by CC -- set by --odb"/>
				<outline text="const ixOdbFlag = process.argv.indexOf (&quot;--odb&quot;);"/>
				<outline text="if (ixOdbFlag !== -1) {">
					<outline text="folderOdbHome = process.argv [ixOdbFlag + 1];"/>
					<outline text="if (folderOdbHome === undefined) {">
						<outline text="console.log (&quot;Can't load the odb because --odb needs a folder path after it.&quot;);"/>
						<outline text="process.exit (1);"/>
						<outline text="}"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="if (scriptName === undefined) {">
					<outline text="console.log (&quot;usage: node run.js buildBelter.opml [--trace] [--odb folder]&quot;);"/>
					<outline text="process.exit (1);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function unescapeXml (theString) {">
					<outline text="return (theString">
						<outline text=".replace (/&amp;lt;/g, &quot;&lt;&quot;)"/>
						<outline text=".replace (/&amp;gt;/g, &quot;&gt;&quot;)"/>
						<outline text=".replace (/&amp;quot;/g, &quot;\&quot;&quot;)"/>
						<outline text=".replace (/&amp;apos;/g, &quot;'&quot;)"/>
						<outline text=".replace (/&amp;amp;/g, &quot;&amp;&quot;));"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function opmlToTree (theXml) {">
					<outline text="const root = {text: &quot;&quot;, subs: []};"/>
					<outline text="const stack = [root];"/>
					<outline text="var depthSkip = -1;"/>
					<outline text="var depth = 0;"/>
					<outline text="const tagPattern = /&lt;outline\b([^&gt;]*?)(\/?)&gt;|&lt;\/outline&gt;/g;"/>
					<outline text="var match;"/>
					<outline text="while ((match = tagPattern.exec (theXml)) !== null) {">
						<outline text="if (match [0] === &quot;&lt;/outline&gt;&quot;) {">
							<outline text="depth--;"/>
							<outline text="if ((depthSkip &gt;= 0) &amp;&amp; (depth &lt;= depthSkip)) {">
								<outline text="depthSkip = -1;"/>
								<outline text="}"/>
								</outline>
							<outline text="stack.length = depth + 1;"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="const attributes = match [1];"/>
							<outline text="const flSelfClosing = match [2] === &quot;/&quot;;"/>
							<outline text="const flComment = /isComment=&quot;true&quot;/.test (attributes);"/>
							<outline text="const textMatch = attributes.match (/text=&quot;([^&quot;]*)&quot;/);"/>
							<outline text="var text = &quot;&quot;;"/>
							<outline text="if (textMatch !== null) {">
								<outline text="text = unescapeXml (textMatch [1]);"/>
								<outline text="}"/>
								</outline>
							<outline text="if (depthSkip === -1) {">
								<outline text="if (flComment) {">
									<outline text="if (!flSelfClosing) {">
										<outline text="depthSkip = depth;"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="const node = {text, subs: []};"/>
									<outline text="stack [depth].subs.push (node);"/>
									<outline text="if (!flSelfClosing) {">
										<outline text="stack [depth + 1] = node;"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="if (!flSelfClosing) {">
								<outline text="depth++;"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="return (root.subs);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="const thePathMap = JSON.parse (fs.readFileSync (pathPathMap, &quot;utf8&quot;));"/>
				<outline text="var pathScript = scriptName; //7/27/26 by CC -- a path that exists runs as given, a bare name comes from the build-scripts folder"/>
				<outline text="if (!fs.existsSync (pathScript)) {">
					<outline text="pathScript = folderBuildScripts + &quot;/&quot; + scriptName;"/>
					<outline text="}"/>
					</outline>
				<outline text="const theXml = fs.readFileSync (pathScript, &quot;latin1&quot;);"/>
				<outline text="const theStatements = parse.parseOutline (opmlToTree (theXml));"/>
				<outline text=""/>
				<outline text="const theTrace = [];"/>
				<outline text="const made = verbsMaker.makeVerbs (thePathMap, theTrace);"/>
				<outline text=""/>
				<outline text="var theOdb;"/>
				<outline text="if (folderOdbHome === undefined) {">
					<outline text="theOdb = {">
						<outline text="user: {">
							<outline text="prefs: thePathMap.prefs"/>
							<outline text="},"/>
							</outline>
						<outline text="scratchpad: {},"/>
						<outline text="config: {},"/>
						<outline text="system: {}"/>
						<outline text="};"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text="else {">
					<outline text="theOdb = odbHome.loadFolder (folderOdbHome, function (message) {">
						<outline text="console.log (&quot;odbHome: &quot; + message);"/>
						<outline text="});"/>
						</outline>
					<outline text="if (theOdb.user.prefs === undefined) { //the path map's prefs are this machine's values -- they win">
						<outline text="theOdb.user.prefs = {};"/>
						<outline text="}"/>
						</outline>
					<outline text="Object.keys (thePathMap.prefs).forEach (function (name) {">
						<outline text="theOdb.user.prefs [name] = thePathMap.prefs [name];"/>
						<outline text="});"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="const environment = evaluate.makeEnvironment (theOdb, made.verbs, theTrace);"/>
				<outline text="environment.parseScript = function (theLines) { //7/27/26 by CC -- scripts loaded from the odb parse on first call">
					<outline text="return (parse.parseOutline (parse.linesToTree (theLines)));"/>
					<outline text="};"/>
					</outline>
				<outline text=""/>
				<outline text="/*  Run the module the way Frontier runs a script: the top level binds">
					<outline text="the handlers, and the trailing bundle -- Frontier's test-code"/>
					<outline text="convention -- calls them. Only if the module made no verb calls do"/>
					<outline text="we call the handler named for the script ourselves.  */"/>
					</outline>
				<outline text=""/>
				<outline text="environment.frames.push ({vars: {}});"/>
				<outline text=""/>
				<outline text="var flFailed = false;"/>
				<outline text="try {">
					<outline text="evaluate.evaluate (theStatements, environment);"/>
					<outline text=""/>
					<outline text="if (theTrace.length === 0) {">
						<outline text="const handlerName = pathScript.split (&quot;/&quot;).pop ().replace (/\.opml$/, &quot;&quot;); //7/27/26 by CC -- the script's own name, wherever it lives"/>
						<outline text="const handlerKey = evaluate.findKey (environment.frames [0].vars, handlerName);"/>
						<outline text="if (handlerKey !== undefined) {">
							<outline text="evaluate.evaluate ([{op: &quot;expression&quot;, expr: {op: &quot;call&quot;, fn: {op: &quot;id&quot;, name: handlerKey}, args: []}}], environment);"/>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text="catch (err) {">
					<outline text="flFailed = true;"/>
					<outline text="console.log (&quot;FAILED: &quot; + err.message);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="if (flTrace || flFailed) {">
					<outline text="theTrace.forEach (function (entry) {">
						<outline text="var argsText = &quot;&quot;;"/>
						<outline text="entry.args.forEach (function (arg) {">
							<outline text="if (argsText.length &gt; 0) {">
								<outline text="argsText += &quot;, &quot;;"/>
								<outline text="}"/>
								</outline>
							<outline text="if (typeof arg === &quot;string&quot;) {">
								<outline text="argsText += &quot;\&quot;&quot; + arg + &quot;\&quot;&quot;;"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="argsText += String (arg);"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="console.log (entry.verb + &quot; (&quot; + argsText + &quot;)&quot;);"/>
						<outline text="});"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="console.log (scriptName + &quot;: &quot; + theTrace.length + &quot; verb calls&quot; + (flFailed ? &quot; (FAILED)&quot; : &quot; (ok)&quot;));"/>
				</outline>
			<outline text="code/runAll.js">
				<outline text="/*  Execute all 361 build scripts under the interpreter in dry-run mode:">
					<outline text="file verbs answer without touching disk, so what's being measured is"/>
					<outline text="the language -- does every script RUN, not just parse."/>
					<outline text=""/>
					<outline text="by CC, 7/27/26 */"/>
					</outline>
				<outline text=""/>
				<outline text="const fs = require (&quot;fs&quot;);"/>
				<outline text="const parse = require (&quot;./parse.js&quot;);"/>
				<outline text="const evaluate = require (&quot;./evaluate.js&quot;);"/>
				<outline text="const verbsMaker = require (&quot;./verbs.js&quot;);"/>
				<outline text=""/>
				<outline text="const folderBuildScripts = &quot;/Users/davewiner/Claude/daveMigrates/usertalk build scripts&quot;;"/>
				<outline text="const pathPathMap = require (&quot;path&quot;).join (__dirname, &quot;pathmap.json&quot;); //7/27/26 by CC -- next to the code, wherever the repo lives"/>
				<outline text="const pathReport = &quot;/Users/davewiner/Claude/usertalk/misc/reports/runAllReport.json&quot;;"/>
				<outline text=""/>
				<outline text="function unescapeXml (theString) {">
					<outline text="return (theString">
						<outline text=".replace (/&amp;lt;/g, &quot;&lt;&quot;)"/>
						<outline text=".replace (/&amp;gt;/g, &quot;&gt;&quot;)"/>
						<outline text=".replace (/&amp;quot;/g, &quot;\&quot;&quot;)"/>
						<outline text=".replace (/&amp;apos;/g, &quot;'&quot;)"/>
						<outline text=".replace (/&amp;amp;/g, &quot;&amp;&quot;));"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function opmlToTree (theXml) {">
					<outline text="const root = {text: &quot;&quot;, subs: []};"/>
					<outline text="const stack = [root];"/>
					<outline text="var depthSkip = -1;"/>
					<outline text="var depth = 0;"/>
					<outline text="const tagPattern = /&lt;outline\b([^&gt;]*?)(\/?)&gt;|&lt;\/outline&gt;/g;"/>
					<outline text="var match;"/>
					<outline text="while ((match = tagPattern.exec (theXml)) !== null) {">
						<outline text="if (match [0] === &quot;&lt;/outline&gt;&quot;) {">
							<outline text="depth--;"/>
							<outline text="if ((depthSkip &gt;= 0) &amp;&amp; (depth &lt;= depthSkip)) {">
								<outline text="depthSkip = -1;"/>
								<outline text="}"/>
								</outline>
							<outline text="stack.length = depth + 1;"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="const attributes = match [1];"/>
							<outline text="const flSelfClosing = match [2] === &quot;/&quot;;"/>
							<outline text="const flComment = /isComment=&quot;true&quot;/.test (attributes);"/>
							<outline text="const textMatch = attributes.match (/text=&quot;([^&quot;]*)&quot;/);"/>
							<outline text="var text = &quot;&quot;;"/>
							<outline text="if (textMatch !== null) {">
								<outline text="text = unescapeXml (textMatch [1]);"/>
								<outline text="}"/>
								</outline>
							<outline text="if (depthSkip === -1) {">
								<outline text="if (flComment) {">
									<outline text="if (!flSelfClosing) {">
										<outline text="depthSkip = depth;"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="const node = {text, subs: []};"/>
									<outline text="stack [depth].subs.push (node);"/>
									<outline text="if (!flSelfClosing) {">
										<outline text="stack [depth + 1] = node;"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="if (!flSelfClosing) {">
								<outline text="depth++;"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="return (root.subs);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="const odbLoader = require (&quot;./odbLoader.js&quot;);"/>
				<outline text=""/>
				<outline text="const thePathMap = JSON.parse (fs.readFileSync (pathPathMap, &quot;utf8&quot;));"/>
				<outline text=""/>
				<outline text="console.log (&quot;loading the real odb...&quot;);"/>
				<outline text="const theRealOdb = odbLoader.loadOdb (); //shared across runs -- dry mode, crosstalk acceptable for the metric"/>
				<outline text="theRealOdb.user.prefs.githubfolder = thePathMap.prefs.githubfolder;"/>
				<outline text="theRealOdb.user.prefs.dropboxfolder = thePathMap.prefs.dropboxfolder;"/>
				<outline text="console.log (&quot;odb loaded&quot;);"/>
				<outline text=""/>
				<outline text="function makeDryVerbs (theTrace) {">
					<outline text=""/>
					<outline text="const made = verbsMaker.makeVerbs (thePathMap, theTrace);"/>
					<outline text="const verbs = made.verbs;"/>
					<outline text=""/>
					<outline text="//file verbs answer plausibly without disk"/>
					<outline text=""/>
					<outline text="verbs [&quot;file.copy&quot;] = function (args) {">
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text="verbs [&quot;file.surefilepath&quot;] = function (args) {">
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text="verbs [&quot;file.surefolder&quot;] = function (args) {">
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text="verbs [&quot;file.exists&quot;] = function (args) {">
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text="verbs [&quot;file.isfolder&quot;] = function (args) {">
						<outline text="return (String (args [0]).endsWith (&quot;:&quot;));"/>
						<outline text="};"/>
						</outline>
					<outline text="verbs [&quot;file.readwholefile&quot;] = function (args) {">
						<outline text="return (&quot;dry run contents of &quot; + args [0]);"/>
						<outline text="};"/>
						</outline>
					<outline text="verbs [&quot;file.writewholefile&quot;] = function (args) {">
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text="verbs [&quot;file.delete&quot;] = function (args) {">
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text="verbs [&quot;file.modified&quot;] = function (args) {">
						<outline text="return (new Date (0));"/>
						<outline text="};"/>
						</outline>
					<outline text="verbs [&quot;fileloop.list&quot;] = function (args) { //two pretend files so loop bodies execute">
						<outline text="var base = String (args [0]);"/>
						<outline text="if (!base.endsWith (&quot;:&quot;)) {">
							<outline text="base += &quot;:&quot;;"/>
							<outline text="}"/>
							</outline>
						<outline text="return ([base + &quot;dryRunFileOne.txt&quot;, base + &quot;dryRunFileTwo.txt&quot;]);"/>
						<outline text="};"/>
						</outline>
					<outline text="verbs [&quot;tcp.httpreadurl&quot;] = function (args) {">
						<outline text="return (&quot;&quot;);"/>
						<outline text="};"/>
						</outline>
					<outline text="verbs [&quot;file.rename&quot;] = function (args) {">
						<outline text="return (true);"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="return (verbs);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="const externalScriptCache = {};"/>
				<outline text=""/>
				<outline text="function resolveExternalScript (theName) { //a sibling build script called by bare name">
					<outline text="const lower = theName.toLowerCase ();"/>
					<outline text="if (externalScriptCache [lower] !== undefined) {">
						<outline text="return (externalScriptCache [lower]);"/>
						<outline text="}"/>
						</outline>
					<outline text="var found;"/>
					<outline text="fs.readdirSync (folderBuildScripts).forEach (function (fname) {">
						<outline text="if (fname.toLowerCase () === lower + &quot;.opml&quot;) {">
							<outline text="found = fname;"/>
							<outline text="}"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text="if (found === undefined) {">
						<outline text="return (undefined);"/>
						<outline text="}"/>
						</outline>
					<outline text="const theXml = fs.readFileSync (folderBuildScripts + &quot;/&quot; + found, &quot;latin1&quot;);"/>
					<outline text="const external = {flOdbScript: true, parsedStatements: parse.parseOutline (opmlToTree (theXml))};"/>
					<outline text="externalScriptCache [lower] = external;"/>
					<outline text="return (external);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="var ctOk = 0, ctFailed = 0;"/>
				<outline text="const failures = [];"/>
				<outline text=""/>
				<outline text="fs.readdirSync (folderBuildScripts).forEach (function (fname) {">
					<outline text="if (!fname.endsWith (&quot;.opml&quot;)) {">
						<outline text="return;"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="const theXml = fs.readFileSync (folderBuildScripts + &quot;/&quot; + fname, &quot;latin1&quot;);"/>
					<outline text="const theStatements = parse.parseOutline (opmlToTree (theXml));"/>
					<outline text=""/>
					<outline text="const theTrace = [];"/>
					<outline text="theTrace.push = function (entry) { //7/27/26 by CC -- a dry-run answer can leave a folder walker with no bottom; cap it so the harness always finishes">
						<outline text="Array.prototype.push.call (this, entry);"/>
						<outline text="if (this.length &gt;= 1000000) {">
							<outline text="const message = &quot;Can't finish the script because it hit the cap of 1000000 verb calls -- likely a loop that dry-run answers never terminate.&quot;;"/>
							<outline text="throw new Error (message);"/>
							<outline text="}"/>
							</outline>
						<outline text="};"/>
						</outline>
					<outline text="const verbs = makeDryVerbs (theTrace);"/>
					<outline text=""/>
					<outline text="const environment = evaluate.makeEnvironment (theRealOdb, verbs, theTrace);"/>
					<outline text="environment.parseScript = function (theLines) {">
						<outline text="return (parse.parseOutline (parse.linesToTree (theLines)));"/>
						<outline text="};"/>
						</outline>
					<outline text="environment.resolveExternalScript = resolveExternalScript;"/>
					<outline text="environment.frames.push ({vars: {}});"/>
					<outline text=""/>
					<outline text="try {">
						<outline text="evaluate.evaluate (theStatements, environment);"/>
						<outline text="if (theTrace.length === 0) {">
							<outline text="const handlerName = fname.replace (/\.opml$/, &quot;&quot;);"/>
							<outline text="const handlerKey = evaluate.findKey (environment.frames [0].vars, handlerName);"/>
							<outline text="if (handlerKey !== undefined) {">
								<outline text="evaluate.evaluate ([{op: &quot;expression&quot;, expr: {op: &quot;call&quot;, fn: {op: &quot;id&quot;, name: handlerKey}, args: []}}], environment);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="ctOk++;"/>
						<outline text="}"/>
						</outline>
					<outline text="catch (err) {">
						<outline text="ctFailed++;"/>
						<outline text="failures.push ({script: fname, message: err.message, ctCallsBeforeFailure: theTrace.length});"/>
						<outline text="}"/>
						</outline>
					<outline text="});"/>
					</outline>
				<outline text=""/>
				<outline text="const categories = {};"/>
				<outline text="failures.forEach (function (failure) {">
					<outline text="const key = failure.message.replace (/&quot;[^&quot;]*&quot;/g, &quot;\&quot;...\&quot;&quot;).replace (/ of [A-Za-z0-9_.]+ /, &quot; of ... &quot;).replace (/call [A-Za-z0-9_.]+ /, &quot;call ... &quot;);"/>
					<outline text="if (categories [key] === undefined) {">
						<outline text="categories [key] = [];"/>
						<outline text="}"/>
						</outline>
					<outline text="categories [key].push (failure.script);"/>
					<outline text="});"/>
					</outline>
				<outline text=""/>
				<outline text="fs.writeFileSync (pathReport, JSON.stringify ({ctOk, ctFailed, categories, failures}, undefined, &quot;\t&quot;));"/>
				<outline text=""/>
				<outline text="console.log (&quot;ran clean: &quot; + ctOk + &quot; of &quot; + (ctOk + ctFailed));"/>
				<outline text="Object.keys (categories).forEach (function (key) {">
					<outline text="console.log (&quot;[&quot; + categories [key].length + &quot;] &quot; + key + &quot; -- e.g. &quot; + categories [key] [0]);"/>
					<outline text="});"/>
					</outline>
				</outline>
			<outline text="code/parseAll.js">
				<outline text="/*  The parse-rate metric: run the UserTalk parser over all 361 build">
					<outline text="scripts, tally clean parses and categorized failures."/>
					<outline text=""/>
					<outline text="by CC, 7/27/26 */"/>
					</outline>
				<outline text=""/>
				<outline text="const fs = require (&quot;fs&quot;);"/>
				<outline text="const parse = require (&quot;./parse.js&quot;);"/>
				<outline text=""/>
				<outline text="const folderBuildScripts = &quot;/Users/davewiner/Claude/daveMigrates/usertalk build scripts&quot;;"/>
				<outline text="const pathReport = &quot;/Users/davewiner/Claude/usertalk/misc/reports/parseReport.json&quot;;"/>
				<outline text=""/>
				<outline text="function unescapeXml (theString) {">
					<outline text="return (theString">
						<outline text=".replace (/&amp;lt;/g, &quot;&lt;&quot;)"/>
						<outline text=".replace (/&amp;gt;/g, &quot;&gt;&quot;)"/>
						<outline text=".replace (/&amp;quot;/g, &quot;\&quot;&quot;)"/>
						<outline text=".replace (/&amp;apos;/g, &quot;'&quot;)"/>
						<outline text=".replace (/&amp;amp;/g, &quot;&amp;&quot;));"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function opmlToTree (theXml) { //an array of {text, subs}, comment subtrees excluded">
					<outline text=""/>
					<outline text="const root = {text: &quot;&quot;, subs: []};"/>
					<outline text="const stack = [root];"/>
					<outline text="var depthSkip = -1;"/>
					<outline text="var depth = 0;"/>
					<outline text=""/>
					<outline text="const tagPattern = /&lt;outline\b([^&gt;]*?)(\/?)&gt;|&lt;\/outline&gt;/g;"/>
					<outline text="var match;"/>
					<outline text="while ((match = tagPattern.exec (theXml)) !== null) {">
						<outline text="if (match [0] === &quot;&lt;/outline&gt;&quot;) {">
							<outline text="depth--;"/>
							<outline text="if ((depthSkip &gt;= 0) &amp;&amp; (depth &lt;= depthSkip)) {">
								<outline text="depthSkip = -1;"/>
								<outline text="}"/>
								</outline>
							<outline text="stack.length = depth + 1;"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="const attributes = match [1];"/>
							<outline text="const flSelfClosing = match [2] === &quot;/&quot;;"/>
							<outline text="const flComment = /isComment=&quot;true&quot;/.test (attributes);"/>
							<outline text="const textMatch = attributes.match (/text=&quot;([^&quot;]*)&quot;/);"/>
							<outline text="var text = &quot;&quot;;"/>
							<outline text="if (textMatch !== null) {">
								<outline text="text = unescapeXml (textMatch [1]);"/>
								<outline text="}"/>
								</outline>
							<outline text="if (depthSkip === -1) {">
								<outline text="if (flComment) {">
									<outline text="if (!flSelfClosing) {">
										<outline text="depthSkip = depth;"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="const node = {text, subs: []};"/>
									<outline text="stack [depth].subs.push (node);"/>
									<outline text="if (!flSelfClosing) {">
										<outline text="stack [depth + 1] = node;"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="if (!flSelfClosing) {">
								<outline text="depth++;"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="return (root.subs);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="var ctClean = 0, ctFailed = 0;"/>
				<outline text="const failures = [];"/>
				<outline text=""/>
				<outline text="fs.readdirSync (folderBuildScripts).forEach (function (fname) {">
					<outline text="if (!fname.endsWith (&quot;.opml&quot;)) {">
						<outline text="return;"/>
						<outline text="}"/>
						</outline>
					<outline text="const theXml = fs.readFileSync (folderBuildScripts + &quot;/&quot; + fname, &quot;latin1&quot;);"/>
					<outline text="const theTree = opmlToTree (theXml);"/>
					<outline text="try {">
						<outline text="parse.parseOutline (theTree);"/>
						<outline text="ctClean++;"/>
						<outline text="}"/>
						</outline>
					<outline text="catch (err) {">
						<outline text="ctFailed++;"/>
						<outline text="failures.push ({script: fname, message: err.message});"/>
						<outline text="}"/>
						</outline>
					<outline text="});"/>
					</outline>
				<outline text=""/>
				<outline text="const categories = {};"/>
				<outline text="failures.forEach (function (failure) {">
					<outline text="const key = failure.message.replace (/&quot;[^&quot;]*&quot;/g, &quot;\&quot;...\&quot;&quot;); //group by message shape"/>
					<outline text="if (categories [key] === undefined) {">
						<outline text="categories [key] = [];"/>
						<outline text="}"/>
						</outline>
					<outline text="categories [key].push (failure.script);"/>
					<outline text="});"/>
					</outline>
				<outline text=""/>
				<outline text="fs.writeFileSync (pathReport, JSON.stringify ({ctClean, ctFailed, categories, failures}, undefined, &quot;\t&quot;));"/>
				<outline text=""/>
				<outline text="console.log (&quot;clean: &quot; + ctClean + &quot; of &quot; + (ctClean + ctFailed));"/>
				<outline text="Object.keys (categories).forEach (function (key) {">
					<outline text="console.log (&quot;[&quot; + categories [key].length + &quot;] &quot; + key + &quot; -- e.g. &quot; + categories [key] [0]);"/>
					<outline text="});"/>
					</outline>
				</outline>
			<outline text="code/parseSuite.js">
				<outline text="/*  Parse every script in the nodeEditor suite -- the 838 scripts the">
					<outline text="build scripts call into -- as a harder test of the parser."/>
					<outline text=""/>
					<outline text="by CC, 7/27/26 */"/>
					</outline>
				<outline text=""/>
				<outline text="const fs = require (&quot;fs&quot;);"/>
				<outline text="const parse = require (&quot;./parse.js&quot;);"/>
				<outline text=""/>
				<outline text="const pathSuite = &quot;/Users/davewiner/Claude/daveMigrates/misc/nodeEditor.json&quot;;"/>
				<outline text="const pathReport = &quot;/Users/davewiner/Claude/usertalk/misc/reports/parseSuiteReport.json&quot;;"/>
				<outline text=""/>
				<outline text="function linesToTree (theLines) { //flat {level, text, flComment} lines to {text, subs}, comments excluded">
					<outline text="const root = {text: &quot;&quot;, subs: []};"/>
					<outline text="const stack = [root];"/>
					<outline text="var depthSkip = -1;"/>
					<outline text="theLines.forEach (function (line) {">
						<outline text="if ((depthSkip &gt;= 0) &amp;&amp; (line.level &gt; depthSkip)) {">
							<outline text="return;"/>
							<outline text="}"/>
							</outline>
						<outline text="depthSkip = -1;"/>
						<outline text="if (line.flComment) {">
							<outline text="depthSkip = line.level;"/>
							<outline text="return;"/>
							<outline text="}"/>
							</outline>
						<outline text="const node = {text: line.text, subs: []};"/>
						<outline text="stack [line.level].subs.push (node);"/>
						<outline text="stack [line.level + 1] = node;"/>
						<outline text="stack.length = line.level + 2;"/>
						<outline text="});"/>
						</outline>
					<outline text="return (root.subs);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function walkTableForScripts (theTable, thePath, visit) {">
					<outline text="Object.keys (theTable).forEach (function (name) {">
						<outline text="const value = theTable [name];"/>
						<outline text="if ((typeof value === &quot;object&quot;) &amp;&amp; (value !== null)) {">
							<outline text="if (value.type === &quot;table&quot;) {">
								<outline text="walkTableForScripts (value.value, thePath + name + &quot;.&quot;, visit);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="if ((value.type === &quot;script&quot;) &amp;&amp; (value.lines !== undefined)) {">
									<outline text="visit (thePath + name, value.lines);"/>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="var ctClean = 0, ctFailed = 0;"/>
				<outline text="const failures = [];"/>
				<outline text=""/>
				<outline text="const theSuite = JSON.parse (fs.readFileSync (pathSuite, &quot;utf8&quot;));"/>
				<outline text="walkTableForScripts (theSuite, &quot;&quot;, function (thePath, theLines) {">
					<outline text="try {">
						<outline text="parse.parseOutline (linesToTree (theLines));"/>
						<outline text="ctClean++;"/>
						<outline text="}"/>
						</outline>
					<outline text="catch (err) {">
						<outline text="ctFailed++;"/>
						<outline text="failures.push ({script: thePath, message: err.message});"/>
						<outline text="}"/>
						</outline>
					<outline text="});"/>
					</outline>
				<outline text=""/>
				<outline text="const categories = {};"/>
				<outline text="failures.forEach (function (failure) {">
					<outline text="const key = failure.message.replace (/&quot;[^&quot;]*&quot;/g, &quot;\&quot;...\&quot;&quot;);"/>
					<outline text="if (categories [key] === undefined) {">
						<outline text="categories [key] = [];"/>
						<outline text="}"/>
						</outline>
					<outline text="categories [key].push (failure.script);"/>
					<outline text="});"/>
					</outline>
				<outline text=""/>
				<outline text="fs.writeFileSync (pathReport, JSON.stringify ({ctClean, ctFailed, categories, failures}, undefined, &quot;\t&quot;));"/>
				<outline text=""/>
				<outline text="console.log (&quot;clean: &quot; + ctClean + &quot; of &quot; + (ctClean + ctFailed));"/>
				<outline text="Object.keys (categories).forEach (function (key) {">
					<outline text="console.log (&quot;[&quot; + categories [key].length + &quot;] &quot; + key + &quot; -- e.g. &quot; + categories [key] [0]);"/>
					<outline text="});"/>
					</outline>
				</outline>
			<outline text="code/failingLines.js">
				<outline text="//Print the first few failing LINES per failure shape, with their text. by CC, 7/27/26"/>
				<outline text=""/>
				<outline text="const fs = require (&quot;fs&quot;);"/>
				<outline text="const parse = require (&quot;./parse.js&quot;);"/>
				<outline text=""/>
				<outline text="const folderBuildScripts = &quot;/Users/davewiner/Claude/daveMigrates/usertalk build scripts&quot;;"/>
				<outline text=""/>
				<outline text="function unescapeXml (theString) {">
					<outline text="return (theString">
						<outline text=".replace (/&amp;lt;/g, &quot;&lt;&quot;)"/>
						<outline text=".replace (/&amp;gt;/g, &quot;&gt;&quot;)"/>
						<outline text=".replace (/&amp;quot;/g, &quot;\&quot;&quot;)"/>
						<outline text=".replace (/&amp;apos;/g, &quot;'&quot;)"/>
						<outline text=".replace (/&amp;amp;/g, &quot;&amp;&quot;));"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="function opmlToTree (theXml) {">
					<outline text="const root = {text: &quot;&quot;, subs: []};"/>
					<outline text="const stack = [root];"/>
					<outline text="var depthSkip = -1;"/>
					<outline text="var depth = 0;"/>
					<outline text="const tagPattern = /&lt;outline\b([^&gt;]*?)(\/?)&gt;|&lt;\/outline&gt;/g;"/>
					<outline text="var match;"/>
					<outline text="while ((match = tagPattern.exec (theXml)) !== null) {">
						<outline text="if (match [0] === &quot;&lt;/outline&gt;&quot;) {">
							<outline text="depth--;"/>
							<outline text="if ((depthSkip &gt;= 0) &amp;&amp; (depth &lt;= depthSkip)) {">
								<outline text="depthSkip = -1;"/>
								<outline text="}"/>
								</outline>
							<outline text="stack.length = depth + 1;"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="const attributes = match [1];"/>
							<outline text="const flSelfClosing = match [2] === &quot;/&quot;;"/>
							<outline text="const flComment = /isComment=&quot;true&quot;/.test (attributes);"/>
							<outline text="const textMatch = attributes.match (/text=&quot;([^&quot;]*)&quot;/);"/>
							<outline text="var text = &quot;&quot;;"/>
							<outline text="if (textMatch !== null) {">
								<outline text="text = unescapeXml (textMatch [1]);"/>
								<outline text="}"/>
								</outline>
							<outline text="if (depthSkip === -1) {">
								<outline text="if (flComment) {">
									<outline text="if (!flSelfClosing) {">
										<outline text="depthSkip = depth;"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="const node = {text, subs: []};"/>
									<outline text="stack [depth].subs.push (node);"/>
									<outline text="if (!flSelfClosing) {">
										<outline text="stack [depth + 1] = node;"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="if (!flSelfClosing) {">
								<outline text="depth++;"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="return (root.subs);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="const seen = {};"/>
				<outline text=""/>
				<outline text="fs.readdirSync (folderBuildScripts).forEach (function (fname) {">
					<outline text="if (!fname.endsWith (&quot;.opml&quot;)) {">
						<outline text="return;"/>
						<outline text="}"/>
						</outline>
					<outline text="const theXml = fs.readFileSync (folderBuildScripts + &quot;/&quot; + fname, &quot;latin1&quot;);"/>
					<outline text="const theTree = opmlToTree (theXml);"/>
					<outline text=""/>
					<outline text="function walk (nodes) {">
						<outline text="nodes.forEach (function (node) {">
							<outline text="try {">
								<outline text="parse.parseLine (node.text);"/>
								<outline text="}"/>
								</outline>
							<outline text="catch (err) {">
								<outline text="const key = err.message.replace (/&quot;[^&quot;]*&quot;/g, &quot;\&quot;...\&quot;&quot;);"/>
								<outline text="if (seen [key] === undefined) {">
									<outline text="seen [key] = 0;"/>
									<outline text="}"/>
									</outline>
								<outline text="if (seen [key] &lt; 4) {">
									<outline text="console.log (&quot;[&quot; + fname + &quot;] &quot; + err.message);"/>
									<outline text="console.log (&quot;    LINE: &quot; + node.text);"/>
									<outline text="}"/>
									</outline>
								<outline text="seen [key]++;"/>
								<outline text="}"/>
								</outline>
							<outline text="walk (node.subs);"/>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="walk (theTree);"/>
					<outline text="});"/>
					</outline>
				<outline text=""/>
				<outline text="console.log (&quot;&quot;);"/>
				<outline text="Object.keys (seen).forEach (function (key) {">
					<outline text="console.log (seen [key] + &quot;x &quot; + key);"/>
					<outline text="});"/>
					</outline>
				</outline>
			<outline text="code/suiteFailingLines.js">
				<outline text="//Show the exact failing line texts in the six failing suite scripts. by CC, 7/27/26"/>
				<outline text=""/>
				<outline text="const fs = require (&quot;fs&quot;);"/>
				<outline text="const parse = require (&quot;./parse.js&quot;);"/>
				<outline text=""/>
				<outline text="const theSuite = JSON.parse (fs.readFileSync (&quot;/Users/davewiner/Claude/daveMigrates/misc/nodeEditor.json&quot;, &quot;utf8&quot;));"/>
				<outline text=""/>
				<outline text="function getAddress (theTable, thePath) {">
					<outline text="var current = theTable;"/>
					<outline text="thePath.split (&quot;.&quot;).forEach (function (part) {">
						<outline text="if ((current !== undefined) &amp;&amp; (current.type === &quot;table&quot;)) {">
							<outline text="current = current.value;"/>
							<outline text="}"/>
							</outline>
						<outline text="if (current !== undefined) {">
							<outline text="current = current [part];"/>
							<outline text="}"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text="return (current);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="const scripts = [">
					<outline text="&quot;nodeEditorSuite.chatgpt.letsWatchThatStinkingFolderx&quot;,"/>
					<outline text="&quot;nodeEditorSuite.imageBrowser.everyNight&quot;,"/>
					<outline text="&quot;nodeEditorSuite.utilities.nightlyGithubUpload&quot;,"/>
					<outline text="&quot;nodeEditorSuite.utilities.nightlyRootsBackup&quot;,"/>
					<outline text="&quot;nodeEditorSuite.utilities.testXmlRpcMailService&quot;"/>
					<outline text="];"/>
					</outline>
				<outline text=""/>
				<outline text="scripts.forEach (function (thePath) {">
					<outline text="const theScript = getAddress (theSuite, thePath);"/>
					<outline text="theScript.lines.forEach (function (line, ix) {">
						<outline text="if (line.flComment) {">
							<outline text="return;"/>
							<outline text="}"/>
							</outline>
						<outline text="try {">
							<outline text="parse.parseLine (line.text);"/>
							<outline text="}"/>
							</outline>
						<outline text="catch (err) {">
							<outline text="console.log (thePath + &quot; line &quot; + ix + &quot;: &quot; + JSON.stringify (line.text));"/>
							<outline text="console.log (&quot;    &quot; + err.message);"/>
							<outline text="}"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text="});"/>
					</outline>
				</outline>
			<outline text="code/stageBelter.js">
				<outline text="/*  Stage the interpreter's sandbox: the belter files rendered from the">
					<outline text="ODB become the nodeeditor source folder buildBelter copies from --"/>
					<outline text="the same chain Frontier runs: outline -&gt; files -&gt; build script."/>
					<outline text=""/>
					<outline text="by CC, 7/27/26 */"/>
					</outline>
				<outline text=""/>
				<outline text="const fs = require (&quot;fs&quot;);"/>
				<outline text="const path = require (&quot;path&quot;);"/>
				<outline text=""/>
				<outline text="const folderRendered = &quot;/Users/davewiner/Claude/usertalk/misc/research/sandbox/render/belter&quot;;"/>
				<outline text="const folderSource = &quot;/Users/davewiner/Claude/usertalk/misc/sandbox/usertalk/nodeeditor/scripting.com-code-belter&quot;;"/>
				<outline text=""/>
				<outline text="function copyTree (fromFolder, toFolder) {">
					<outline text="fs.mkdirSync (toFolder, {recursive: true});"/>
					<outline text="fs.readdirSync (fromFolder).forEach (function (fname) {">
						<outline text="const fromPath = path.join (fromFolder, fname);"/>
						<outline text="const toPath = path.join (toFolder, fname);"/>
						<outline text="if (fs.statSync (fromPath).isDirectory ()) {">
							<outline text="copyTree (fromPath, toPath);"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="fs.copyFileSync (fromPath, toPath);"/>
							<outline text="}"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="copyTree (folderRendered, folderSource);"/>
				<outline text="console.log (&quot;staged &quot; + folderSource);"/>
				</outline>
			<outline text="code/pathmap.json">
				<outline text="{">
					<outline text="&quot;helpers&quot;: {">
						<outline text="&quot;getFolder&quot;: &quot;Macintosh HD:Users:davewiner:Dropbox:public:misc:nodeeditor:&quot;,"/>
						<outline text="&quot;getAllServersFolder&quot;: &quot;Macintosh HD:Users:davewiner:allservers:&quot;,"/>
						<outline text="&quot;getGitHubFolder&quot;: &quot;Macintosh HD:Users:davewiner:GitHub:&quot;"/>
						</outline>
					<outline text="},"/>
					<outline text="&quot;prefs&quot;: {">
						<outline text="&quot;githubfolder&quot;: &quot;Macintosh HD:Users:davewiner:GitHub:&quot;,"/>
						<outline text="&quot;dropboxfolder&quot;: &quot;Macintosh HD:Users:davewiner:Dropbox:&quot;"/>
						</outline>
					<outline text="},"/>
					<outline text="&quot;prefixes&quot;: {">
						<outline text="&quot;Macintosh HD:Users:davewiner:Dropbox:public:misc:nodeeditor&quot;: &quot;/Users/davewiner/Claude/usertalk/misc/sandbox/usertalk/nodeeditor&quot;,"/>
						<outline text="&quot;Macintosh HD:Users:davewiner:GitHub&quot;: &quot;/Users/davewiner/Claude/usertalk/misc/sandbox/usertalk/github&quot;,"/>
						<outline text="&quot;Macintosh HD:Users:davewiner:allservers&quot;: &quot;/Users/davewiner/Claude/usertalk/misc/sandbox/usertalk/allservers&quot;,"/>
						<outline text="&quot;Macintosh HD:Users:davewiner:Dropbox&quot;: &quot;/Users/davewiner/Claude/usertalk/misc/sandbox/usertalk/dropbox&quot;"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text="}"/>
				</outline>
			<outline text="examples/readme.md">
				<outline text="# Examples"/>
				<outline text=""/>
				<outline text="Working UserTalk programs you can run with the interpreter, each in its own folder with a readme."/>
				<outline text=""/>
				<outline text="1. [hello](hello/) -- the smallest UserTalk program: a handler with a default parameter, and two calls to it."/>
				</outline>
			<outline text="examples/hello/readme.md">
				<outline text="# hello"/>
				<outline text=""/>
				<outline text="The smallest UserTalk program -- a handler with a default parameter, and two calls to it."/>
				<outline text=""/>
				<outline text="To run it, from the top of this repo:"/>
				<outline text=""/>
				<outline text="```"/>
				<outline text="node code/run.js examples/hello/hello.opml"/>
				<outline text="```"/>
				<outline text=""/>
				<outline text="And it says:"/>
				<outline text=""/>
				<outline text="```"/>
				<outline text="Hello, World!"/>
				<outline text="Hello, Dave!"/>
				<outline text="examples/hello/hello.opml: 2 verb calls (ok)"/>
				<outline text="```"/>
				<outline text=""/>
				<outline text="The script is an outline, stored as OPML -- in Frontier you'd be looking at it in the outliner, each line a node, the handler's body indented under it."/>
				</outline>
			<outline text="examples/hello/hello.opml">
				<outline text="&lt;?xml version=&quot;1.0&quot;?&gt;"/>
				<outline text="&lt;opml version=&quot;2.0&quot;&gt;">
					<outline text="&lt;head&gt;">
						<outline text="&lt;title&gt;hello&lt;/title&gt;"/>
						<outline text="&lt;/head&gt;"/>
						</outline>
					<outline text="&lt;body&gt;">
						<outline text="&lt;outline text=&quot;on hello (name = &amp;quot;World&amp;quot;)&quot;&gt;">
							<outline text="&lt;outline text=&quot;msg (&amp;quot;Hello, &amp;quot; + name + &amp;quot;!&amp;quot;)&quot;/&gt;"/>
							<outline text="&lt;/outline&gt;"/>
							</outline>
						<outline text="&lt;outline text=&quot;hello ()&quot;/&gt;"/>
						<outline text="&lt;outline text=&quot;hello (&amp;quot;Dave&amp;quot;)&quot;/&gt;"/>
						<outline text="&lt;/body&gt;"/>
						</outline>
					<outline text="&lt;/opml&gt;"/>
					</outline>
				</outline>
			<outline text="examples/fileloop/fileloop.opml">
				<outline text="&lt;?xml version=&quot;1.0&quot;?&gt;"/>
				<outline text="&lt;opml version=&quot;2.0&quot;&gt;">
					<outline text="&lt;head&gt;">
						<outline text="&lt;title&gt;hello&lt;/title&gt;"/>
						<outline text="&lt;/head&gt;"/>
						</outline>
					<outline text="&lt;body&gt;">
						<outline text="&lt;outline text=&quot;on hello (name = &amp;quot;World&amp;quot;)&quot;&gt;">
							<outline text="&lt;outline text=&quot;msg (&amp;quot;Hello, &amp;quot; + name + &amp;quot;!&amp;quot;)&quot;/&gt;"/>
							<outline text="&lt;/outline&gt;"/>
							</outline>
						<outline text="&lt;outline text=&quot;hello ()&quot;/&gt;"/>
						<outline text="&lt;outline text=&quot;hello (&amp;quot;Dave&amp;quot;)&quot;/&gt;"/>
						<outline text="&lt;/body&gt;"/>
						</outline>
					<outline text="&lt;/opml&gt;"/>
					</outline>
				</outline>
			</outline>
		</body>
	</opml>
